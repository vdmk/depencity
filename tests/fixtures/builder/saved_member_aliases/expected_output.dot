digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n3 [label="Inherited" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="Worker" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="OtherWorker" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="Outer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="Conditional" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="Rebound" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="unknown_rebinding" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="replaced_intermediate" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n12 {
        label="Worker\n(class)";
        style=rounded;
        n12 [style=invis];
        n15 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];
        n16 [label="build" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n17 {
          label="run\n(function)";
          style=rounded;
          n17 [style=invis];
          n18 [label="return first"];
          n19 [label="first"];
        }


        subgraph cluster_n20 {
          label="build\n(function)";
          style=rounded;
          n20 [style=invis];
          n21 [label="cls"];
          n22 [label="return cls"];
          n23 [label="cls" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n24 {
        label="OtherWorker\n(class)";
        style=rounded;
        n24 [style=invis];
        n26 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n27 {
          label="run\n(function)";
          style=rounded;
          n27 [style=invis];
          n28 [label="return second"];
          n29 [label="second"];
        }

      }


      subgraph cluster_n30 {
        label="Outer\n(class)";
        style=rounded;
        n30 [style=invis];
        n31 [label="Alias"];
        n32 [label="Alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n33 {
        label="Inherited\n(class)";
        style=rounded;
        n33 [style=invis];
      }


      subgraph cluster_n34 {
        label="Conditional\n(class)";
        style=rounded;
        n34 [style=invis];
        n35 [label="Alias v1"];
        n36 [label="if enabled" shape=diamond];
        n37 [label="Alias v2"];
        n38 [label="enabled"];
        n39 [label="Alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n40 {
        label="Rebound\n(class)";
        style=rounded;
        n40 [style=invis];
        n41 [label="Alias v1"];
        n42 [label="Alias v2"];
        n43 [label="unknown"];
        n44 [label="Alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n45 {
        label="main\n(function)";
        style=rounded;
        n45 [style=invis];
        n46 [label="Outer.Alias"];
        n47 [label="Outer.Alias.run"];
        n48 [label="saved"];
        n49 [label="Inherited.Alias"];
        n50 [label="Inherited.Alias.run"];
        n51 [label="inherited"];
        n52 [label="Conditional.Alias"];
        n53 [label="Conditional.Alias.run"];
        n54 [label="conditional"];
        n55 [label="Outer.Alias"];
        n56 [label="Outer.Alias.build"];
        n57 [label="bound"];
        n58 [label="saved()" shape=box style=filled fillcolor=lightcyan];
        n59 [label="inherited()" shape=box style=filled fillcolor=lightcyan];
        n60 [label="conditional()" shape=box style=filled fillcolor=lightcyan];
        n61 [label="Outer.Alias"];
        n62 [label="Outer.Alias.run"];
        n63 [label="Outer.Alias.run()" shape=box style=filled fillcolor=lightcyan];
        n64 [label="bound()" shape=box style=filled fillcolor=lightcyan];
        n65 [label="(saved(), inherited(), conditional(), Outer.Alias.run(), bound())" shape=box];
        n66 [label="return (saved(), inherited(), conditional(), Outer.Alias.run(), bound())"];
        n67 [label="saved" shape=box style="rounded,filled" fillcolor=lightyellow];
        n68 [label="inherited" shape=box style="rounded,filled" fillcolor=lightyellow];
        n69 [label="conditional" shape=box style="rounded,filled" fillcolor=lightyellow];
        n70 [label="bound" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n71 {
        label="unknown_rebinding\n(function)";
        style=rounded;
        n71 [style=invis];
        n72 [label="Rebound.Alias"];
        n73 [label="Rebound.Alias.run"];
        n74 [label="saved"];
        n75 [label="saved()" shape=box style=filled fillcolor=lightcyan];
        n76 [label="return saved()"];
        n77 [label="saved" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n78 {
        label="replaced_intermediate\n(function)";
        style=rounded;
        n78 [style=invis];
        n79 [label="replacement"];
        n80 [label="Outer.Alias"];
        n81 [label="Outer.Alias"];
        n82 [label="Outer.Alias.run"];
        n83 [label="saved"];
        n84 [label="saved()" shape=box style=filled fillcolor=lightcyan];
        n85 [label="return saved()"];
        n86 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n87 [label="saved" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n88 {
      label="builtins\n(builtins)";
      style=rounded;
      n88 [style=invis];
      n89 [label="staticmethod"];
      n90 [label="classmethod"];
      n91 [label="staticmethod" shape=box style="rounded,filled" fillcolor=lightyellow];
      n92 [label="classmethod" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n12 -> n31 [color=steelblue, ltail=cluster_n12];
  n12 -> n35 [color=steelblue, ltail=cluster_n12];
