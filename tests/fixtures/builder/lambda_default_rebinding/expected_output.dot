  n35 -> n31 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n36 -> n30 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n37 -> n33 [color=steelblue, ltail=cluster_n37];
  n38 -> n39 [color=steelblue];
  n40 -> n38 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n41 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n41];
  n42 -> n45 [color=steelblue];
  n42 -> n48 [color=steelblue];
  n43 -> n50 [color=steelblue];
  n44 -> n46 [color=steelblue];
  n45 -> n46 [color=steelblue];
  n45 -> n56 [color=steelblue];
  n46 -> n50 [color=steelblue];
  n46 -> n56 [color=steelblue];
  n48 -> n49 [color=steelblue];
