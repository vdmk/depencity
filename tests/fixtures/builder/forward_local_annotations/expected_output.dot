      subgraph cluster_n70 {
        label="unknown_local\n(function)";
        style=rounded;
        n70 [style=invis];
        n71 [label="value"];
        n72 [label="Target"];
        n73 [label="value.run"];
        n74 [label="value.run()" shape=box style=filled fillcolor=lightcyan];
        n75 [label="return value.run()"];
        n76 [label="unknown"];
        n77 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n78 [label="Target" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n79 {
        label="late_container_alias\n(function)";
        style=rounded;
        n79 [style=invis];
        n80 [label="values"];
        n81 [label="Container"];
        n82 [label="values[0]"];
        n83 [label="values[0].run"];
        n84 [label="values[0].run()" shape=box style=filled fillcolor=lightcyan];
        n85 [label="return values[0].run()"];
        n86 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n87 [label="Container" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n88 {
        label="late_class_object_alias\n(function)";
        style=rounded;
        n88 [style=invis];
        n89 [label="factory"];
        n90 [label="Factory"];
        n91 [label="factory()" shape=box style=filled fillcolor=lightcyan];
        n92 [label="value"];
        n93 [label="value.run"];
        n94 [label="value.run()" shape=box style=filled fillcolor=lightcyan];
        n95 [label="return value.run()"];
        n96 [label="factory" shape=box style="rounded,filled" fillcolor=lightyellow];
        n97 [label="Factory" shape=box style="rounded,filled" fillcolor=lightyellow];
        n98 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n99 {
        label="visible_wrapper_aliases\n(function)";
        style=rounded;
        n99 [style=invis];
        n100 [label="values"];
        n101 [label="factory"];
        n102 [label="Container"];
        n103 [label="Factory"];
        n104 [label="factory()" shape=box style=filled fillcolor=lightcyan];
        n105 [label="value"];
        n106 [label="values[0]"];
        n107 [label="values[0].run"];
        n108 [label="values[0].run()" shape=box style=filled fillcolor=lightcyan];
        n109 [label="value.run"];
        n110 [label="value.run()" shape=box style=filled fillcolor=lightcyan];
        n111 [label="(values[0].run(), value.run())" shape=box];
        n112 [label="return (values[0].run(), value.run())"];
        n113 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n114 [label="factory" shape=box style="rounded,filled" fillcolor=lightyellow];
        n115 [label="Container" shape=box style="rounded,filled" fillcolor=lightyellow];
        n116 [label="Factory" shape=box style="rounded,filled" fillcolor=lightyellow];
        n117 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n118 {
      label="builtins\n(builtins)";
      style=rounded;
      n118 [style=invis];
      n119 [label="list"];
      n120 [label="type"];
      n121 [label="list" shape=box style="rounded,filled" fillcolor=lightyellow];
      n122 [label="type" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n100 -> n106 [color=steelblue];
  n101 -> n104 [color=steelblue];
  n104 -> n105 [color=steelblue];
  n105 -> n109 [color=steelblue];
  n106 -> n107 [color=steelblue];
