digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="Target" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="local_class" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="annotated_assignment" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="local_alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="declaration_only" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="unknown_local" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="late_container_alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="late_class_object_alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="visible_wrapper_aliases" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n11 {
        label="Target\n(class)";
        style=rounded;
        n11 [style=invis];
        n12 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n13 {
          label="run\n(function)";
          style=rounded;
          n13 [style=invis];
          n14 [label="self"];
          n15 [label="return outer_payload"];
          n16 [label="outer_payload"];
          n17 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n18 {
        label="local_class\n(function)";
        style=rounded;
        n18 [style=invis];
        n19 [label="value"];
        n20 [label="value.run"];
        n21 [label="value.run()" shape=box style=filled fillcolor=lightcyan];
        n22 [label="return value.run()"];
        n23 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n24 [label="Target" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n25 {
          label="Target\n(class)";
          style=rounded;
          n25 [style=invis];
          n26 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n27 {
            label="run\n(function)";
            style=rounded;
            n27 [style=invis];
            n28 [label="self"];
            n29 [label="return local_payload"];
            n30 [label="local_payload"];
            n31 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }

      }


      subgraph cluster_n32 {
        label="annotated_assignment\n(function)";
        style=rounded;
        n32 [style=invis];
        n33 [label="value"];
        n34 [label="result"];
        n35 [label="result.run"];
        n36 [label="result.run()" shape=box style=filled fillcolor=lightcyan];
        n37 [label="return result.run()"];
        n38 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n39 [label="result" shape=box style="rounded,filled" fillcolor=lightyellow];
        n40 [label="Target" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n41 {
          label="Target\n(class)";
          style=rounded;
          n41 [style=invis];
          n42 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n43 {
            label="run\n(function)";
            style=rounded;
            n43 [style=invis];
            n44 [label="self"];
            n45 [label="return assignment_payload"];
            n46 [label="assignment_payload"];
            n47 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }

      }


      subgraph cluster_n48 {
        label="local_alias\n(function)";
        style=rounded;
        n48 [style=invis];
        n49 [label="value"];
        n50 [label="Alias"];
        n51 [label="value.run"];
        n52 [label="value.run()" shape=box style=filled fillcolor=lightcyan];
        n53 [label="return value.run()"];
        n54 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n55 [label="Alias" shape=box style="rounded,filled" fillcolor=lightyellow];
        n56 [label="Target" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n57 {
          label="Target\n(class)";
          style=rounded;
          n57 [style=invis];
          n58 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n59 {
            label="run\n(function)";
            style=rounded;
            n59 [style=invis];
            n60 [label="self"];
            n61 [label="return alias_payload"];
            n62 [label="alias_payload"];
            n63 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }

      }


      subgraph cluster_n64 {
