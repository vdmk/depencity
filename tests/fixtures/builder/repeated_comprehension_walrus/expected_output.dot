  n7 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n7];
  n8 -> n15 [color=steelblue];
  n8 -> n16 [color=steelblue];
  n9 -> n18 [color=steelblue];
}