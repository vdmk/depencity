  n16 -> n17 [color=steelblue];
  n17 -> n10 [color=steelblue];
  n17 -> n9 [color=steelblue];
  n18 -> n10 [color=steelblue];
  n18 -> n19 [color=steelblue];
  n19 -> n11 [color=steelblue];
  n20 -> n17 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n21 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n21];
  n22 -> n28 [color=steelblue];
  n22 -> n29 [color=steelblue];
  n23 -> n31 [color=steelblue];
  n24 -> n32 [color=steelblue];
