  n3 -> n23 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n3 -> n24 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n30 -> n23 [color=steelblue];
  n30 -> n24 [color=steelblue];
  n31 -> n24 [color=steelblue];
  n31 -> n32 [color=steelblue];
  n32 -> n25 [color=steelblue];
  n33 -> n30 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n34 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n34];
  n35 -> n47 [color=steelblue];
  n35 -> n48 [color=steelblue];
  n37 -> n38 [color=steelblue];
  n39 -> n35 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n40 -> n36 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n40 -> n43 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n40 -> n44 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n42 -> n41 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n42];
  n43 -> n50 [color=steelblue];
  n44 -> n51 [color=steelblue];
  n45 -> n37 [color=steelblue];
  n47 -> n43 [color=steelblue];
  n47 -> n44 [color=steelblue];
