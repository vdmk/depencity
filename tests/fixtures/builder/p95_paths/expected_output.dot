digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n3 {
        label="main\n(function)";
        style=rounded;
        n3 [style=invis];
        n4 [label="seed"];
        n5 [label="shallow"];
        n6 [label="deep v1"];
        n7 [label="deep + 1" shape=box];
        n8 [label="deep v2"];
        n9 [label="deep + 2" shape=box];
        n10 [label="deep v3"];
        n11 [label="shallow + deep" shape=box];
        n12 [label="return shallow + deep"];
        n13 [label="seed" shape=box style="rounded,filled" fillcolor=lightyellow];
        n14 [label="shallow" shape=box style="rounded,filled" fillcolor=lightyellow];
        n15 [label="deep" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n10 -> n11 [color=steelblue];
  n11 -> n12 [color=steelblue];
  n13 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n14 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n15 -> n10 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n15 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n15 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n3 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n3];
  n4 -> n5 [color=steelblue];
  n4 -> n6 [color=steelblue];
  n5 -> n11 [color=steelblue];
  n6 -> n7 [color=steelblue];
  n7 -> n8 [color=steelblue];
  n8 -> n9 [color=steelblue];
  n9 -> n10 [color=steelblue];
}