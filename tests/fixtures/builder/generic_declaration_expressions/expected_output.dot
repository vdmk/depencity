      n30 [label="Base" shape=box style="rounded,filled" fillcolor=lightyellow];
      n31 [label="decorate" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n32 {
        label="Base\n(class)";
        style=rounded;
        n32 [style=invis];
      }


      subgraph cluster_n33 {
        label="decorate\n(function)";
        style=rounded;
        n33 [style=invis];
        n34 [label="value"];
        n35 [label="return value"];
        n36 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n37 {
        label="generic_function\n(function)";
        style=rounded;
        n37 [style=invis];
        n38 [label="T"];
        n39 [label="U"];
        n40 [label="value"];
        n41 [label="other"];
        n42 [label="(value, other)" shape=box];
        n43 [label="return (value, other)"];
        n44 [label="T" shape=box style="rounded,filled" fillcolor=lightyellow];
        n45 [label="U" shape=box style="rounded,filled" fillcolor=lightyellow];
        n46 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n47 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n48 {
        label="GenericClass\n(class)";
        style=rounded;
        n48 [style=invis];
        n49 [label="T"];
        n50 [label="U"];
        n51 [label="T" shape=box style="rounded,filled" fillcolor=lightyellow];
        n52 [label="U" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n53 {
        label="create_defaults\n(function)";
