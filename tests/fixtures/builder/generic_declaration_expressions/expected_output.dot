      n13 [label="build()" shape=box style=filled fillcolor=lightcyan];
      n14 [label="build()" shape=box style=filled fillcolor=lightcyan];
      n16 [label="t'{T} {external}'" shape=box];
      n18 [label="outer_type"];
      n19 [label="outer_value"];
      n20 [label="build"];
      n21 [label="external"];
      n22 [label="T" shape=box style="rounded,filled" fillcolor=lightyellow];
      n23 [label="U" shape=box style="rounded,filled" fillcolor=lightyellow];
      n24 [label="generic_function" shape=box style="rounded,filled" fillcolor=lightyellow];
