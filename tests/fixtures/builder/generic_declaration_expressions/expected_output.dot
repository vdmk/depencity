        n61 [label="T" shape=box style="rounded,filled" fillcolor=lightyellow];
        n62 [label="U" shape=box style="rounded,filled" fillcolor=lightyellow];
        n63 [label="V" shape=box style="rounded,filled" fillcolor=lightyellow];
        n64 [label="first" shape=box style="rounded,filled" fillcolor=lightyellow];
        n65 [label="second" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n66 {
        label="create_combined_default\n(function)";
        style=rounded;
        n66 [style=invis];
        n67 [label="T"];
        n68 [label="U"];
        n69 [label="V"];
        n70 [label="value"];
        n71 [label="return value"];
