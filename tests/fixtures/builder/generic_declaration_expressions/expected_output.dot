digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="T"];
      n3 [label="U"];
      n4 [label="decorate()" shape=box style=filled fillcolor=lightcyan];
      n6 [label="decorate()" shape=box style=filled fillcolor=lightcyan];
      n8 [label="build()" shape=box style=filled fillcolor=lightcyan];
      n9 [label="build()" shape=box style=filled fillcolor=lightcyan];
