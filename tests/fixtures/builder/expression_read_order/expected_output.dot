digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="unbound_operator" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="unbound_container" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="unbound_argument" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="shadow_builtin" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="read_after_binding" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="deferred_lambda" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="eager_lambda_default" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="conditional_read" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n11 {
        label="main\n(function)";
        style=rounded;
        n11 [style=invis];
        n12 [label="call_x v1"];
        n13 [label="container_x v1"];
        n14 [label="operator_x v1"];
        n15 [label="new"];
        n16 [label="call_x v2"];
        n17 [label="external()" shape=box style=filled fillcolor=lightcyan];
        n18 [label="call_result"];
        n19 [label="container_x v2"];
        n20 [label="(container_x, (container_x := new))" shape=box];
        n21 [label="container_result"];
        n22 [label="operator_x v2"];
        n23 [label="operator_x + (operator_x := new)" shape=box];
        n24 [label="operator_result"];
        n25 [label="(call_result, container_result, operator_result)" shape=box];
        n26 [label="return (call_result, container_result, operator_result)"];
        n27 [label="external"];
        n28 [label="call_x" shape=box style="rounded,filled" fillcolor=lightyellow];
        n29 [label="container_x" shape=box style="rounded,filled" fillcolor=lightyellow];
        n30 [label="operator_x" shape=box style="rounded,filled" fillcolor=lightyellow];
        n31 [label="new" shape=box style="rounded,filled" fillcolor=lightyellow];
        n32 [label="call_result" shape=box style="rounded,filled" fillcolor=lightyellow];
        n33 [label="container_result" shape=box style="rounded,filled" fillcolor=lightyellow];
        n34 [label="operator_result" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n35 {
        label="unbound_operator\n(function)";
        style=rounded;
        n35 [style=invis];
        n36 [label="replacement"];
        n37 [label="value"];
        n38 [label="value + (value := replacement)" shape=box];
        n39 [label="return value + (value := replacement)"];
        n40 [label="value"];
        n41 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n42 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n43 {
        label="unbound_container\n(function)";
        style=rounded;
        n43 [style=invis];
        n44 [label="replacement"];
        n45 [label="value"];
        n46 [label="(value, (value := replacement))" shape=box];
        n47 [label="return (value, (value := replacement))"];
        n48 [label="value"];
        n49 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n50 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n51 {
        label="unbound_argument\n(function)";
        style=rounded;
        n51 [style=invis];
        n52 [label="replacement"];
        n53 [label="value"];
        n54 [label="external()" shape=box style=filled fillcolor=lightcyan];
        n55 [label="return external(value, (value := replacement))"];
        n56 [label="external"];
        n57 [label="value"];
        n58 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n59 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n60 {
        label="shadow_builtin\n(function)";
        style=rounded;
        n60 [style=invis];
        n61 [label="replacement"];
        n62 [label="len"];
        n63 [label="(len, (len := replacement))" shape=box];
        n64 [label="return (len, (len := replacement))"];
        n65 [label="len"];
        n66 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n67 [label="len" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n68 {
        label="read_after_binding\n(function)";
        style=rounded;
        n68 [style=invis];
        n69 [label="replacement"];
        n70 [label="value"];
        n71 [label="((value := replacement), value)" shape=box];
        n72 [label="return ((value := replacement), value)"];
        n73 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n74 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n75 {
        label="deferred_lambda\n(function)";
        style=rounded;
        n75 [style=invis];
        n76 [label="replacement"];
        n78 [label="value"];
        n79 [label="(lambda: value, (value := replacement))" shape=box];
        n80 [label="return (lambda: value, (value := replacement))"];
        n81 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n82 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n83 {
          label="__lambda_10__\n(function)";
          style=rounded;
          n83 [style=invis];
          n84 [label="return value"];
        }

      }


      subgraph cluster_n85 {
        label="eager_lambda_default\n(function)";
        style=rounded;
        n85 [style=invis];
        n86 [label="replacement"];
        n88 [label="value"];
        n89 [label="(lambda prior=value: prior, (value := replacement))" shape=box];
        n90 [label="return (lambda prior=value: prior, (value := replacement))"];
        n91 [label="value"];
        n92 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n93 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n94 {
          label="__lambda_12__\n(function)";
          style=rounded;
          n94 [style=invis];
          n95 [label="prior"];
          n96 [label="return prior"];
          n97 [label="prior" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n98 {
        label="conditional_read\n(function)";
        style=rounded;
        n98 [style=invis];
        n99 [label="flag"];
        n100 [label="old"];
        n101 [label="new"];
        n102 [label="value v1"];
        n103 [label="if flag" shape=diamond];
        n104 [label="value v2"];
        n105 [label="value v3"];
        n106 [label="(value, (value := new))" shape=box];
        n107 [label="return (value, (value := new))"];
        n108 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n109 [label="old" shape=box style="rounded,filled" fillcolor=lightyellow];
        n110 [label="new" shape=box style="rounded,filled" fillcolor=lightyellow];
        n111 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n100 -> n102 [color=steelblue];
  n101 -> n104 [color=steelblue];
  n101 -> n105 [color=steelblue];
