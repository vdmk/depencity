      }


      subgraph cluster_n79 {
        label="independent\n(function)";
        style=rounded;
        n79 [style=invis];
        n80 [label="value"];
        n81 [label="value + 1" shape=box];
        n82 [label="result"];
        n83 [label="return result"];
        n84 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n85 [label="result" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

