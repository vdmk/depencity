        n22 [label="seventh()" shape=box style=filled fillcolor=lightcyan];
        n23 [label="(second(), third(), fourth(), fifth(), sixth(), seventh())" shape=box];
        n24 [label="return (second(), third(), fourth(), fifth(), sixth(), seventh())"];
      }


      subgraph cluster_n25 {
        label="second\n(function)";
        style=rounded;
        n25 [style=invis];
        n26 [label="first()" shape=box style=filled fillcolor=lightcyan];
        n27 [label="third()" shape=box style=filled fillcolor=lightcyan];
        n28 [label="fourth()" shape=box style=filled fillcolor=lightcyan];
        n29 [label="fifth()" shape=box style=filled fillcolor=lightcyan];
