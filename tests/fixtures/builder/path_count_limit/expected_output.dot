digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="baseline"];
      n3 [label="baseline" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="first" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="second" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="third" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="fourth" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="fifth" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="sixth" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="seventh" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="independent" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n13 {
        label="main\n(function)";
        style=rounded;
        n13 [style=invis];
        n14 [label="first()" shape=box style=filled fillcolor=lightcyan];
        n15 [label="return first()"];
      }


      subgraph cluster_n16 {
        label="first\n(function)";
        style=rounded;
        n16 [style=invis];
        n17 [label="second()" shape=box style=filled fillcolor=lightcyan];
        n18 [label="third()" shape=box style=filled fillcolor=lightcyan];
        n19 [label="fourth()" shape=box style=filled fillcolor=lightcyan];
        n20 [label="fifth()" shape=box style=filled fillcolor=lightcyan];
