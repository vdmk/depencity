digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="if enabled" shape=diamond];
      n6 [label="enabled"];
      n7 [label="Guarded" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="Conditional" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="Outer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="Original" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="Updated" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="Ordinary" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n14 {
        label="Original\n(class)";
        style=rounded;
        n14 [style=invis];
        n15 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n16 {
          label="run\n(function)";
          style=rounded;
          n16 [style=invis];
          n17 [label="self"];
          n18 [label="return original_payload"];
          n19 [label="original_payload"];
          n20 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n21 {
        label="Updated\n(class)";
        style=rounded;
        n21 [style=invis];
        n22 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n23 {
          label="run\n(function)";
          style=rounded;
          n23 [style=invis];
          n24 [label="self"];
          n25 [label="return updated_payload"];
          n26 [label="updated_payload"];
          n27 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n28 {
        label="Ordinary\n(class)";
        style=rounded;
        n28 [style=invis];
        n29 [label="item"];
        n30 [label="unknown"];
        n31 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n32 {
        label="Guarded\n(class)";
        style=rounded;
        n32 [style=invis];
        n33 [label="item"];
        n34 [label="unknown"];
        n35 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n36 {
        label="Conditional\n(class)";
        style=rounded;
        n36 [style=invis];
        n37 [label="item"];
        n38 [label="if selected" shape=diamond];
        n39 [label="unknown"];
        n40 [label="selected"];
        n41 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n42 {
        label="Outer\n(class)";
        style=rounded;
        n42 [style=invis];
        n44 [label="Nested" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n45 {
          label="Nested\n(class)";
          style=rounded;
          n45 [style=invis];
          n46 [label="item"];
          n47 [label="unknown"];
          n48 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n49 {
        label="main\n(function)";
        style=rounded;
        n49 [style=invis];
        n50 [label="Ordinary.item"];
        n51 [label="Ordinary.item.run"];
        n52 [label="Ordinary.item.run()" shape=box style=filled fillcolor=lightcyan];
        n53 [label="Guarded.item"];
        n54 [label="Guarded.item.run"];
        n55 [label="Guarded.item.run()" shape=box style=filled fillcolor=lightcyan];
        n56 [label="Conditional.item"];
        n57 [label="Conditional.item.run"];
        n58 [label="Conditional.item.run()" shape=box style=filled fillcolor=lightcyan];
        n59 [label="Outer.Nested"];
        n60 [label="Outer.Nested.item"];
        n61 [label="Outer.Nested.item.run"];
        n62 [label="Outer.Nested.item.run()" shape=box style=filled fillcolor=lightcyan];
        n63 [label="(Ordinary.item.run(), Guarded.item.run(), Conditional.item.run(), Outer.Nested.item.run())" shape=box];
        n64 [label="return (Ordinary.item.run(), Guarded.item.run(), Conditional.item.run(), Outer.Nested.item.run())"];
      }

    }

  }

  n14 -> n10 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n14];
  n16 -> n15 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n16];
  n18 -> n58 [color=steelblue];
  n19 -> n18 [color=steelblue];
  n2 -> n32 [color=steelblue];
  n2 -> n33 [color=steelblue];
