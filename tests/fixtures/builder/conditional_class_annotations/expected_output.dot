  n21 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n21];
  n23 -> n22 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n23];
  n25 -> n52 [color=steelblue];
  n25 -> n55 [color=steelblue];
  n25 -> n58 [color=steelblue];
  n25 -> n62 [color=steelblue];
  n26 -> n25 [color=steelblue];
  n27 -> n24 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n28 -> n12 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n28];
  n28 -> n50 [color=steelblue, ltail=cluster_n28];
  n29 -> n50 [color=steelblue];
  n30 -> n29 [color=steelblue];
  n31 -> n29 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n32 -> n53 [color=steelblue, ltail=cluster_n32];
  n32 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n32];
  n33 -> n53 [color=steelblue];
  n34 -> n33 [color=steelblue];
  n35 -> n33 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n36 -> n56 [color=steelblue, ltail=cluster_n36];
  n36 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n36];
  n37 -> n56 [color=steelblue];
  n39 -> n37 [color=steelblue];
  n40 -> n38 [color=steelblue];
  n41 -> n37 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n42 -> n59 [color=steelblue, ltail=cluster_n42];
  n42 -> n9 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n42];
  n44 -> n45 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n45 -> n44 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n45];
  n45 -> n59 [color=steelblue, ltail=cluster_n45];
  n46 -> n60 [color=steelblue];
  n47 -> n46 [color=steelblue];
  n48 -> n46 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n49 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n49];
  n50 -> n51 [color=steelblue];
  n51 -> n52 [color=steelblue];
  n52 -> n63 [color=steelblue];
  n53 -> n54 [color=steelblue];
  n54 -> n55 [color=steelblue];
  n55 -> n63 [color=steelblue];
  n56 -> n57 [color=steelblue];
  n57 -> n58 [color=steelblue];
