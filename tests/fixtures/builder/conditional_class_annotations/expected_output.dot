  n63 -> n64 [color=steelblue];
  n7 -> n32 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n8 -> n36 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n9 -> n42 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
}