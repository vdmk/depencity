          n24 [style=invis];
          n25 [label="self"];
          n26 [label="self.item"];
          n27 [label="return None (implicit)"];
          n28 [label="inherited_initializer"];
          n29 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n30 {
          label="action\n(function)";
          style=rounded;
          n30 [style=invis];
          n31 [label="self"];
          n32 [label="return inherited_action"];
          n33 [label="inherited_action"];
          n34 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
