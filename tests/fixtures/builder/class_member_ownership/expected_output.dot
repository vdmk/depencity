digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n4 [label="GlobalChild" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="GenericChild" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="Base" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="GlobalOnly" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="action" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="Generic" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="AssignedParameter" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="enclosing" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n15 {
        label="Base\n(class)";
