digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n7 [label="if enabled" shape=diamond];
      n10 [label="enabled"];
      n11 [label="Middle" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="Deep" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="Override" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="NoInit" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="Replaced" shape=box style="rounded,filled" fillcolor=lightyellow];
      n16 [label="GuardedOverride" shape=box style="rounded,filled" fillcolor=lightyellow];
      n17 [label="GuardedInherited" shape=box style="rounded,filled" fillcolor=lightyellow];
      n18 [label="Base" shape=box style="rounded,filled" fillcolor=lightyellow];
      n19 [label="NoInitBase" shape=box style="rounded,filled" fillcolor=lightyellow];
      n20 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n21 [label="guarded_constructors" shape=box style="rounded,filled" fillcolor=lightyellow];
      n22 [label="replaced_initializer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n23 [label="deleted_initializer" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n24 {
        label="Base\n(class)";
        style=rounded;
        n24 [style=invis];
        n25 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n26 {
          label="__init__\n(function)";
          style=rounded;
          n26 [style=invis];
          n27 [label="self"];
          n28 [label="value"];
          n29 [label="self.value"];
          n30 [label="return None (implicit)"];
          n31 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n32 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n33 {
        label="Middle\n(class)";
        style=rounded;
        n33 [style=invis];
      }


      subgraph cluster_n34 {
        label="Deep\n(class)";
        style=rounded;
        n34 [style=invis];
      }


      subgraph cluster_n35 {
        label="Override\n(class)";
        style=rounded;
        n35 [style=invis];
        n36 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n37 {
          label="__init__\n(function)";
          style=rounded;
          n37 [style=invis];
          n38 [label="self"];
          n39 [label="value"];
          n40 [label="self.value"];
          n41 [label="return None (implicit)"];
          n42 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n43 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n44 {
        label="NoInitBase\n(class)";
        style=rounded;
        n44 [style=invis];
      }


      subgraph cluster_n45 {
        label="NoInit\n(class)";
        style=rounded;
        n45 [style=invis];
      }


      subgraph cluster_n46 {
        label="Replaced\n(class)";
        style=rounded;
        n46 [style=invis];
        n47 [label="__init__"];
        n48 [label="unknown"];
        n49 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n50 {
        label="main\n(function)";
        style=rounded;
        n50 [style=invis];
        n51 [label="value"];
        n52 [label="Base()" shape=box style=filled fillcolor=lightcyan];
        n53 [label="Deep()" shape=box style=filled fillcolor=lightcyan];
        n54 [label="Override()" shape=box style=filled fillcolor=lightcyan];
        n55 [label="NoInit()" shape=box style=filled fillcolor=lightcyan];
        n56 [label="Replaced()" shape=box style=filled fillcolor=lightcyan];
        n57 [label="(Base(value), Deep(value), Override(value), NoInit(value), Replaced(value))" shape=box];
        n58 [label="return (Base(value), Deep(value), Override(value), NoInit(value), Replaced(value))"];
        n59 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n60 {
        label="GuardedOverride\n(class)";
        style=rounded;
        n60 [style=invis];
        n62 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n63 {
          label="__init__\n(function)";
          style=rounded;
          n63 [style=invis];
          n64 [label="self"];
          n65 [label="value"];
          n66 [label="self.value"];
          n67 [label="return None (implicit)"];
          n68 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n69 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n70 {
        label="GuardedInherited\n(class)";
        style=rounded;
        n70 [style=invis];
      }


      subgraph cluster_n71 {
        label="guarded_constructors\n(function)";
        style=rounded;
        n71 [style=invis];
        n72 [label="value"];
        n73 [label="GuardedOverride()" shape=box style=filled fillcolor=lightcyan];
        n74 [label="GuardedInherited()" shape=box style=filled fillcolor=lightcyan];
        n75 [label="(GuardedOverride(value), GuardedInherited(value))" shape=box];
        n76 [label="return (GuardedOverride(value), GuardedInherited(value))"];
        n77 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n78 {
        label="replaced_initializer\n(function)";
        style=rounded;
        n78 [style=invis];
        n79 [label="value"];
        n80 [label="replacement"];
        n81 [label="Base.__init__"];
        n82 [label="Base()" shape=box style=filled fillcolor=lightcyan];
        n83 [label="Base.__init__"];
        n84 [label="Base.__init__()" shape=box style=filled fillcolor=lightcyan];
        n85 [label="(Base(value), Base.__init__(value))" shape=box];
        n86 [label="return (Base(value), Base.__init__(value))"];
        n87 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n88 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n89 {
        label="deleted_initializer\n(function)";
        style=rounded;
        n89 [style=invis];
        n90 [label="value"];
        n91 [label="Base.__init__"];
        n92 [label="Base()" shape=box style=filled fillcolor=lightcyan];
        n93 [label="Base.__init__"];
        n94 [label="Base.__init__()" shape=box style=filled fillcolor=lightcyan];
        n95 [label="(Base(value), Base.__init__(value))" shape=box];
        n96 [label="return (Base(value), Base.__init__(value))"];
        n97 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

