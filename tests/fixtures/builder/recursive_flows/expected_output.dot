  n3 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n3];
  n30 -> n24 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n31 -> n28 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n32 -> n12 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n32];
  n33 -> n34 [color=steelblue];
  n33 -> n36 [color=steelblue];
  n33 -> n37 [color=steelblue];
  n33 -> n42 [color=steelblue];
