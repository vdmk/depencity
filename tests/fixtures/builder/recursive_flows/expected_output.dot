digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n3 {
        label="main\n(function)";
        style=rounded;
        n3 [style=invis];
        n4 [label="values"];
        n5 [label="flatten_list()" shape=box style=filled fillcolor=lightcyan];
        n6 [label="flatten_generator()" shape=box style=filled fillcolor=lightcyan];
        n7 [label="list()" shape=box style=filled fillcolor=lightcyan];
        n8 [label="(flatten_list(values), list(flatten_generator(values)))" shape=box];
        n9 [label="return (flatten_list(values), list(flatten_generator(values)))"];
        n10 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n11 [label="flatten_list" shape=box style="rounded,filled" fillcolor=lightyellow];
        n12 [label="flatten_generator" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n13 {
          label="flatten_list\n(function)";
          style=rounded;
          n13 [style=invis];
          n14 [label="value"];
          n15 [label="isinstance()" shape=box style=filled fillcolor=lightcyan];
          n16 [label="if isinstance(value, list)" shape=diamond];
          n17 [label="return [item for child in value for item in flatten_list(child)]"];
          n18 [label="[value]" shape=box];
          n19 [label="return [value]"];
          n20 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n21 {
            label="__comp_2__\n(comprehension)";
            style=rounded;
            n21 [style=invis];
            n22 [label="for child in value" shape=diamond];
            n23 [label="child in value" shape=box];
            n24 [label="child"];
            n25 [label="flatten_list()" shape=box style=filled fillcolor=lightcyan];
            n26 [label="for item in flatten_list(child)" shape=diamond];
            n27 [label="item in flatten_list(child)" shape=box];
            n28 [label="item"];
            n29 [label="[item for child in value for item in flatten_list(child)]"];
            n30 [label="child" shape=box style="rounded,filled" fillcolor=lightyellow];
            n31 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }


        subgraph cluster_n32 {
          label="flatten_generator\n(function)";
          style=rounded;
          n32 [style=invis];
          n33 [label="value"];
          n34 [label="isinstance()" shape=box style=filled fillcolor=lightcyan];
          n35 [label="if isinstance(value, list)" shape=diamond];
          n36 [label="for child in value" shape=diamond];
          n37 [label="child in value" shape=box];
          n38 [label="child"];
          n39 [label="flatten_generator()" shape=box style=filled fillcolor=lightcyan];
          n40 [label="yield from flatten_generator(child)"];
          n41 [label="yield from result"];
          n42 [label="yield value"];
          n43 [label="yield (received)"];
          n44 [label="return None (implicit)"];
          n45 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
          n46 [label="child" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }


    subgraph cluster_n47 {
      label="builtins\n(builtins)";
      style=rounded;
      n47 [style=invis];
      n48 [label="list"];
      n49 [label="isinstance"];
      n50 [label="list" shape=box style="rounded,filled" fillcolor=lightyellow];
      n51 [label="isinstance" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n10 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n13 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n13];
  n14 -> n15 [color=steelblue];
  n14 -> n18 [color=steelblue];
  n14 -> n22 [color=steelblue];
  n14 -> n23 [color=steelblue];
  n15 -> n16 [color=steelblue];
  n16 -> n17 [color=steelblue];
