digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="isolated" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="mutual_left" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="mutual_right" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="main\n(function)";
        style=rounded;
        n6 [style=invis];
        n7 [label="values"];
        n8 [label="flatten_list()" shape=box style=filled fillcolor=lightcyan];
        n9 [label="flatten_generator()" shape=box style=filled fillcolor=lightcyan];
        n10 [label="list()" shape=box style=filled fillcolor=lightcyan];
        n11 [label="(flatten_list(values), list(flatten_generator(values)))" shape=box];
        n12 [label="return (flatten_list(values), list(flatten_generator(values)))"];
        n13 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n14 [label="flatten_list" shape=box style="rounded,filled" fillcolor=lightyellow];
        n15 [label="flatten_generator" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n16 {
          label="flatten_list\n(function)";
          style=rounded;
          n16 [style=invis];
          n17 [label="value"];
          n18 [label="isinstance()" shape=box style=filled fillcolor=lightcyan];
          n19 [label="if isinstance(value, list)" shape=diamond];
          n20 [label="return [item for child in value for item in flatten_list(child)]"];
          n21 [label="[value]" shape=box];
          n22 [label="return [value]"];
          n23 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n24 {
            label="__comp_2__\n(comprehension)";
            style=rounded;
            n24 [style=invis];
            n25 [label="for child in value" shape=diamond];
            n26 [label="child in value" shape=box];
            n27 [label="child"];
            n28 [label="flatten_list()" shape=box style=filled fillcolor=lightcyan];
            n29 [label="for item in flatten_list(child)" shape=diamond];
            n30 [label="item in flatten_list(child)" shape=box];
            n31 [label="item"];
            n32 [label="[item for child in value for item in flatten_list(child)]"];
            n33 [label="child" shape=box style="rounded,filled" fillcolor=lightyellow];
            n34 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }


        subgraph cluster_n35 {
          label="flatten_generator\n(function)";
          style=rounded;
          n35 [style=invis];
          n36 [label="value"];
          n37 [label="isinstance()" shape=box style=filled fillcolor=lightcyan];
          n38 [label="if isinstance(value, list)" shape=diamond];
          n39 [label="for child in value" shape=diamond];
          n40 [label="child in value" shape=box];
          n41 [label="child"];
          n42 [label="flatten_generator()" shape=box style=filled fillcolor=lightcyan];
          n43 [label="yield from flatten_generator(child)"];
          n44 [label="yield from result"];
          n45 [label="yield value"];
          n46 [label="yield (received)"];
          n47 [label="return None (implicit)"];
          n48 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
          n49 [label="child" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n50 {
        label="isolated\n(function)";
        style=rounded;
        n50 [style=invis];
        n51 [label="isolated()" shape=box style=filled fillcolor=lightcyan];
        n52 [label="return isolated()"];
      }


      subgraph cluster_n53 {
        label="mutual_left\n(function)";
        style=rounded;
        n53 [style=invis];
        n54 [label="seed"];
        n55 [label="mutual_right()" shape=box style=filled fillcolor=lightcyan];
        n56 [label="mutual_right(seed) + seed" shape=box];
        n57 [label="return mutual_right(seed) + seed"];
        n58 [label="seed" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n59 {
        label="mutual_right\n(function)";
        style=rounded;
        n59 [style=invis];
        n60 [label="seed"];
        n61 [label="__cond_25__" shape=diamond];
        n62 [label="mutual_left()" shape=box style=filled fillcolor=lightcyan];
        n63 [label="mutual_right()" shape=box style=filled fillcolor=lightcyan];
        n64 [label="__op_28__" shape=box];
        n65 [label="return mutual_left(seed) if seed else mutual_right(seed)"];
        n66 [label="seed" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n67 {
      label="builtins\n(builtins)";
      style=rounded;
      n67 [style=invis];
      n68 [label="list"];
      n69 [label="isinstance"];
      n70 [label="list" shape=box style="rounded,filled" fillcolor=lightyellow];
      n71 [label="isinstance" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n10 -> n11 [color=steelblue];
  n11 -> n12 [color=steelblue];
  n13 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
