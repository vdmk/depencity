digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="regular" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="underscored" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n4 {
        label="regular\n(function)";
        style=rounded;
        n4 [style=invis];
        n5 [label="value"];
        n6 [label="value + 1" shape=box];
        n7 [label="print()" shape=box style=filled fillcolor=lightcyan];
        n8 [label="y"];
        n9 [label="return y"];
        n10 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n11 [label="y" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n12 {
        label="underscored\n(function)";
        style=rounded;
        n12 [style=invis];
        n13 [label="value"];
        n14 [label="value + 1" shape=box];
        n15 [label="print()" shape=box style=filled fillcolor=lightcyan];
        n16 [label="__y"];
        n17 [label="return __y"];
        n18 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n19 [label="__y" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n20 {
      label="builtins\n(builtins)";
      style=rounded;
      n20 [style=invis];
      n21 [label="print"];
      n22 [label="print" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n10 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n11 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n12 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n12];
  n13 -> n14 [color=steelblue];
  n14 -> n15 [color=steelblue];
  n15 -> n16 [color=steelblue];
  n16 -> n17 [color=steelblue];
  n18 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n19 -> n16 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n21 -> n15 [color=steelblue];
  n21 -> n7 [color=steelblue];
  n22 -> n21 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n4 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n4];
  n5 -> n6 [color=steelblue];
  n6 -> n7 [color=steelblue];
  n7 -> n8 [color=steelblue];
  n8 -> n9 [color=steelblue];
}