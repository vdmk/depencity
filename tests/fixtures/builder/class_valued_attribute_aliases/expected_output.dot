digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="Item" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="Box" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="nonclass_controls" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="Item\n(class)";
        style=rounded;
        n6 [style=invis];
        n7 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
        n8 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n9 {
          label="__init__\n(function)";
          style=rounded;
          n9 [style=invis];
          n10 [label="self"];
          n11 [label="initialize_item()" shape=box style=filled fillcolor=lightcyan];
          n12 [label="return None (implicit)"];
          n13 [label="initialize_item"];
          n14 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n15 {
          label="run\n(function)";
          style=rounded;
          n15 [style=invis];
          n16 [label="self"];
          n17 [label="return item_source"];
          n18 [label="item_source"];
          n19 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n20 {
        label="Box\n(class)";
        style=rounded;
        n20 [style=invis];
        n21 [label="Factory"];
        n22 [label="value"];
        n23 [label="Item()" shape=box style=filled fillcolor=lightcyan];
        n24 [label="instance"];
        n25 [label="opaque"];
        n26 [label="Factory" shape=box style="rounded,filled" fillcolor=lightyellow];
        n27 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n28 [label="instance" shape=box style="rounded,filled" fillcolor=lightyellow];
        n29 [label="Nested" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n30 {
          label="Nested\n(class)";
          style=rounded;
          n30 [style=invis];
          n31 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n32 {
            label="run\n(function)";
            style=rounded;
            n32 [style=invis];
            n33 [label="self"];
            n34 [label="return nested_source"];
            n35 [label="nested_source"];
            n36 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }

      }


      subgraph cluster_n37 {
        label="main\n(function)";
        style=rounded;
        n37 [style=invis];
        n38 [label="Direct"];
        n39 [label="Box.Factory"];
        n40 [label="Alias"];
        n41 [label="Saved"];
        n42 [label="Box.Nested"];
        n43 [label="Nested"];
        n44 [label="Direct()" shape=box style=filled fillcolor=lightcyan];
        n45 [label="direct"];
        n46 [label="Alias()" shape=box style=filled fillcolor=lightcyan];
        n47 [label="aliased"];
        n48 [label="Saved()" shape=box style=filled fillcolor=lightcyan];
        n49 [label="saved"];
        n50 [label="Nested()" shape=box style=filled fillcolor=lightcyan];
        n51 [label="nested"];
        n52 [label="direct.run"];
        n53 [label="direct.run()" shape=box style=filled fillcolor=lightcyan];
        n54 [label="aliased.run"];
        n55 [label="aliased.run()" shape=box style=filled fillcolor=lightcyan];
        n56 [label="saved.run"];
        n57 [label="saved.run()" shape=box style=filled fillcolor=lightcyan];
        n58 [label="nested.run"];
        n59 [label="nested.run()" shape=box style=filled fillcolor=lightcyan];
        n60 [label="(direct.run(), aliased.run(), saved.run(), nested.run())" shape=box];
        n61 [label="return (direct.run(), aliased.run(), saved.run(), nested.run())"];
        n62 [label="Direct" shape=box style="rounded,filled" fillcolor=lightyellow];
        n63 [label="Alias" shape=box style="rounded,filled" fillcolor=lightyellow];
        n64 [label="Saved" shape=box style="rounded,filled" fillcolor=lightyellow];
        n65 [label="Nested" shape=box style="rounded,filled" fillcolor=lightyellow];
        n66 [label="direct" shape=box style="rounded,filled" fillcolor=lightyellow];
        n67 [label="aliased" shape=box style="rounded,filled" fillcolor=lightyellow];
        n68 [label="saved" shape=box style="rounded,filled" fillcolor=lightyellow];
        n69 [label="nested" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n70 {
        label="nonclass_controls\n(function)";
        style=rounded;
        n70 [style=invis];
        n71 [label="Box.value"];
        n72 [label="Value"];
        n73 [label="Box.instance"];
        n74 [label="Instance"];
        n75 [label="Value()" shape=box style=filled fillcolor=lightcyan];
        n76 [label="Instance()" shape=box style=filled fillcolor=lightcyan];
        n77 [label="(Value(), Instance())" shape=box];
        n78 [label="return (Value(), Instance())"];
        n79 [label="Value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n80 [label="Instance" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n12 -> n23 [color=steelblue];
  n12 -> n44 [color=steelblue];
  n12 -> n46 [color=steelblue];
  n12 -> n48 [color=steelblue];
