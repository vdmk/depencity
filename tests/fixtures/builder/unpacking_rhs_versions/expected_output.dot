        n115 [label="values"];
        n116 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n117 [label="head" shape=box style="rounded,filled" fillcolor=lightyellow];
        n118 [label="tail" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n119 {
        label="unbound_chained_assignment\n(function)";
        style=rounded;
        n119 [style=invis];
        n120 [label="values"];
        n121 [label="other"];
        n122 [label="return other"];
        n123 [label="values"];
        n124 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n125 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

