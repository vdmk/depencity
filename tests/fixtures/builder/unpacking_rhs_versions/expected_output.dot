        n100 [label="values, tail = values" shape=box];
        n101 [label="values"];
        n102 [label="tail"];
        n103 [label="return tail"];
        n104 [label="values"];
        n105 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n106 [label="tail" shape=box style="rounded,filled" fillcolor=lightyellow];
