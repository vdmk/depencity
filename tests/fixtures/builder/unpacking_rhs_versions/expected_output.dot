        n73 [style=invis];
        n74 [label="values"];
        n75 [label="Inner.tail"];
        n76 [label="return Inner.tail"];
        n77 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n78 [label="Inner" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n79 {
