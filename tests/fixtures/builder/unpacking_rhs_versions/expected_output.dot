digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="(2, 3)" shape=box];
      n3 [label="(1, (2, 3))" shape=box];
      n4 [label="values"];
      n5 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="Box" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="NestedBox" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="ChainedBox" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="enclosing_function" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="read_module_before_enclosing_assignment" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="unbound_unpacking" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="unbound_nested_unpacking" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="unbound_chained_assignment" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n15 {
        label="main\n(function)";
        style=rounded;
        n15 [style=invis];
        n16 [label="values v1"];
        n17 [label="rows"];
        n18 [label="value v1"];
        n19 [label="value v2"];
        n20 [label="other"];
        n21 [label="values, tail = values" shape=box];
        n22 [label="values v2"];
        n23 [label="tail"];
        n24 [label="values, (head, *nested_tail) = values" shape=box];
        n25 [label="values v3"];
        n26 [label="(head, *nested_tail)" shape=box];
        n27 [label="head"];
        n28 [label="nested_tail"];
        n29 [label="items v1"];
        n30 [label="for (items, value) in items" shape=diamond];
        n31 [label="(items, value) in items" shape=box];
        n32 [label="(items, value)" shape=box];
        n33 [label="items v2"];
        n34 [label="value v3"];
        n35 [label="transform()" shape=box style=filled fillcolor=lightcyan];
        n36 [label="values, chained_tail = pair = transform(values)" shape=box];
        n37 [label="values v4"];
        n38 [label="chained_tail"];
        n39 [label="pair"];
        n40 [label="(tail, nested_tail, value, other, chained_tail, pair)" shape=box];
        n41 [label="return (tail, nested_tail, value, other, chained_tail, pair)"];
        n42 [label="transform"];
        n43 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n44 [label="rows" shape=box style="rounded,filled" fillcolor=lightyellow];
        n45 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n46 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];
        n47 [label="tail" shape=box style="rounded,filled" fillcolor=lightyellow];
        n48 [label="head" shape=box style="rounded,filled" fillcolor=lightyellow];
        n49 [label="nested_tail" shape=box style="rounded,filled" fillcolor=lightyellow];
        n50 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n51 [label="chained_tail" shape=box style="rounded,filled" fillcolor=lightyellow];
        n52 [label="pair" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n53 {
        label="Box\n(class)";
        style=rounded;
        n53 [style=invis];
        n54 [label="values, tail = values" shape=box];
        n55 [label="values"];
        n56 [label="tail"];
        n57 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n58 [label="tail" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n59 {
        label="NestedBox\n(class)";
        style=rounded;
        n59 [style=invis];
        n60 [label="values, (head, *tail) = values" shape=box];
        n61 [label="values"];
        n62 [label="(head, *tail)" shape=box];
        n63 [label="head"];
        n64 [label="tail"];
        n65 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n66 [label="head" shape=box style="rounded,filled" fillcolor=lightyellow];
        n67 [label="tail" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n68 {
        label="ChainedBox\n(class)";
        style=rounded;
        n68 [style=invis];
        n69 [label="values"];
        n70 [label="other"];
        n71 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n72 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];
