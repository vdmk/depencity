          n80 [label="values, tail = values" shape=box];
          n81 [label="values"];
          n82 [label="tail"];
          n83 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
          n84 [label="tail" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n85 {
