digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n3 [label="Child" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="Item" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="Base" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n7 {
        label="Item\n(class)";
        style=rounded;
        n7 [style=invis];
        n8 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
        n9 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n10 {
          label="__init__\n(function)";
          style=rounded;
          n10 [style=invis];
          n11 [label="self"];
          n12 [label="initialize()" shape=box style=filled fillcolor=lightcyan];
          n13 [label="return None (implicit)"];
          n14 [label="initialize"];
          n15 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n16 {
          label="run\n(function)";
          style=rounded;
          n16 [style=invis];
          n17 [label="self"];
          n18 [label="return item_source"];
          n19 [label="item_source"];
          n20 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n21 {
        label="Base\n(class)";
        style=rounded;
        n21 [style=invis];
        n22 [label="Factory"];
        n23 [label="Factory" shape=box style="rounded,filled" fillcolor=lightyellow];
        n24 [label="Nested" shape=box style="rounded,filled" fillcolor=lightyellow];
        n25 [label="ordinary" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n26 {
          label="Nested\n(class)";
          style=rounded;
          n26 [style=invis];
          n27 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
          n28 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n29 {
            label="__init__\n(function)";
            style=rounded;
            n29 [style=invis];
            n30 [label="self"];
            n31 [label="initialize_nested()" shape=box style=filled fillcolor=lightcyan];
            n32 [label="return None (implicit)"];
            n33 [label="initialize_nested"];
            n34 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }


          subgraph cluster_n35 {
