            style=rounded;
            n35 [style=invis];
            n36 [label="self"];
            n37 [label="return nested_source"];
            n38 [label="nested_source"];
            n39 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }


        subgraph cluster_n40 {
          label="ordinary\n(function)";
          style=rounded;
          n40 [style=invis];
          n41 [label="self"];
          n42 [label="return method_source"];
          n43 [label="method_source"];
          n44 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n45 {
        label="Child\n(class)";
        style=rounded;
        n45 [style=invis];
        n46 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
