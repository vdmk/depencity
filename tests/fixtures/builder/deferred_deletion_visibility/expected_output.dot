digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="value"];
      n3 [label="module_after_definition"];
      n4 [label="eager_value"];
      n5 [label="before_class"];
      n6 [label="after_class"];
      n7 [label="Example"];
      n8 [label="Alias"];
      n9 [label="Alias()" shape=box style=filled fillcolor=lightcyan];
      n10 [label="constructed"];
      n11 [label="original"];
      n12 [label="eager_original"];
      n13 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="module_after_definition" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="eager_value" shape=box style="rounded,filled" fillcolor=lightyellow];
      n16 [label="before_class" shape=box style="rounded,filled" fillcolor=lightyellow];
      n17 [label="after_class" shape=box style="rounded,filled" fillcolor=lightyellow];
      n18 [label="Example" shape=box style="rounded,filled" fillcolor=lightyellow];
      n19 [label="Alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n20 [label="constructed" shape=box style="rounded,filled" fillcolor=lightyellow];
      n21 [label="remove" shape=box style="rounded,filled" fillcolor=lightyellow];
      n22 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n23 [label="conditional_remove" shape=box style="rounded,filled" fillcolor=lightyellow];
      n24 [label="deferred_class_deletion" shape=box style="rounded,filled" fillcolor=lightyellow];
      n25 [label="deferred_async_deletion" shape=box style="rounded,filled" fillcolor=lightyellow];
      n26 [label="Clear" shape=box style="rounded,filled" fillcolor=lightyellow];
      n27 [label="eager_nonlocal" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n28 {
        label="remove\n(function)";
        style=rounded;
        n28 [style=invis];
        n29 [label="before"];
        n30 [label="del value" shape=box];
        n31 [label="after"];
        n32 [label="(before, after)" shape=box];
        n33 [label="return (before, after)"];
        n34 [label="value"];
        n35 [label="before" shape=box style="rounded,filled" fillcolor=lightyellow];
        n36 [label="after" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n37 {
        label="main\n(function)";
        style=rounded;
        n37 [style=invis];
        n38 [label="original"];
        n39 [label="local"];
        n40 [label="return local"];
        n41 [label="original" shape=box style="rounded,filled" fillcolor=lightyellow];
        n42 [label="local" shape=box style="rounded,filled" fillcolor=lightyellow];
        n43 [label="remove_local" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n44 {
          label="remove_local\n(function)";
          style=rounded;
          n44 [style=invis];
          n45 [label="before"];
          n46 [label="del local" shape=box];
          n47 [label="after"];
          n48 [label="(before, after)" shape=box];
          n49 [label="return (before, after)"];
          n50 [label="local"];
          n51 [label="before" shape=box style="rounded,filled" fillcolor=lightyellow];
          n52 [label="after" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n53 {
        label="conditional_remove\n(function)";
        style=rounded;
        n53 [style=invis];
        n54 [label="flag"];
        n55 [label="before"];
        n56 [label="if flag" shape=diamond];
        n57 [label="del value" shape=box];
        n58 [label="after"];
        n59 [label="(before, after)" shape=box];
        n60 [label="return (before, after)"];
        n61 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n62 [label="before" shape=box style="rounded,filled" fillcolor=lightyellow];
        n63 [label="after" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n64 {
        label="deferred_class_deletion\n(function)";
        style=rounded;
        n64 [style=invis];
        n65 [label="return None (implicit)"];
        n66 [label="Clear" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n67 {
          label="Clear\n(class)";
          style=rounded;
          n67 [style=invis];
          n68 [label="del value" shape=box];
        }

      }


      subgraph cluster_n69 {
        label="deferred_async_deletion\n(function)";
        style=rounded;
        n69 [style=invis];
        n70 [label="before"];
        n71 [label="del value" shape=box];
        n72 [label="after"];
        n73 [label="(before, after)" shape=box];
        n74 [label="return (before, after)"];
        n75 [label="value"];
        n76 [label="before" shape=box style="rounded,filled" fillcolor=lightyellow];
        n77 [label="after" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n78 {
        label="Clear\n(class)";
        style=rounded;
        n78 [style=invis];
        n79 [label="before"];
        n80 [label="del eager_value" shape=box];
        n81 [label="after"];
        n82 [label="eager_value"];
        n83 [label="before" shape=box style="rounded,filled" fillcolor=lightyellow];
        n84 [label="after" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n85 {
        label="eager_nonlocal\n(function)";
        style=rounded;
        n85 [style=invis];
        n86 [label="original"];
        n87 [label="local"];
        n88 [label="before_class"];
        n89 [label="after_class"];
        n90 [label="(before_class, after_class)" shape=box];
        n91 [label="return (before_class, after_class)"];
        n92 [label="original" shape=box style="rounded,filled" fillcolor=lightyellow];
        n93 [label="local" shape=box style="rounded,filled" fillcolor=lightyellow];
        n94 [label="before_class" shape=box style="rounded,filled" fillcolor=lightyellow];
        n95 [label="after_class" shape=box style="rounded,filled" fillcolor=lightyellow];
        n96 [label="Clear" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n97 {
          label="Clear\n(class)";
          style=rounded;
          n97 [style=invis];
          n98 [label="before"];
          n99 [label="del local" shape=box];
          n100 [label="after"];
          n101 [label="local"];
          n102 [label="before" shape=box style="rounded,filled" fillcolor=lightyellow];
          n103 [label="after" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n104 {
        label="Example\n(class)";
        style=rounded;
        n104 [style=invis];
        n105 [label="del Example" shape=box];
      }

    }

  }

