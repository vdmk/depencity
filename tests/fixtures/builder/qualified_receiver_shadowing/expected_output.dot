digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="C" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="unshadowed" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="parameter_shadow" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="typed_parameter_shadow" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="local_reassignment" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="nested_scope_shadow" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n8 {
        label="C\n(class)";
        style=rounded;
        n8 [style=invis];
        n9 [label="method" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n10 {
          label="method\n(function)";
          style=rounded;
          n10 [style=invis];
          n11 [label="self"];
          n12 [label="return 1"];
          n13 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n14 {
        label="unshadowed\n(function)";
        style=rounded;
        n14 [style=invis];
        n15 [label="C.method"];
        n16 [label="C.method()" shape=box style=filled fillcolor=lightcyan];
        n17 [label="return C.method()"];
      }


      subgraph cluster_n18 {
        label="parameter_shadow\n(function)";
        style=rounded;
        n18 [style=invis];
        n19 [label="C"];
        n20 [label="C.method"];
        n21 [label="C.method()" shape=box style=filled fillcolor=lightcyan];
        n22 [label="return C.method()"];
        n23 [label="C" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n24 {
        label="typed_parameter_shadow\n(function)";
        style=rounded;
        n24 [style=invis];
        n25 [label="C"];
        n26 [label="C.method"];
        n27 [label="C.method()" shape=box style=filled fillcolor=lightcyan];
        n28 [label="return C.method()"];
        n29 [label="C" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n30 {
        label="local_reassignment\n(function)";
        style=rounded;
        n30 [style=invis];
        n31 [label="C"];
        n32 [label="C.method"];
        n33 [label="C.method()" shape=box style=filled fillcolor=lightcyan];
        n34 [label="return C.method()"];
        n35 [label="unknown"];
        n36 [label="C" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n37 {
        label="nested_scope_shadow\n(function)";
        style=rounded;
        n37 [style=invis];
        n38 [label="C"];
        n39 [label="inner()" shape=box style=filled fillcolor=lightcyan];
        n40 [label="return inner()"];
        n41 [label="unknown"];
        n42 [label="C" shape=box style="rounded,filled" fillcolor=lightyellow];
        n43 [label="inner" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n44 {
          label="inner\n(function)";
          style=rounded;
          n44 [style=invis];
          n45 [label="C.method"];
          n46 [label="C.method()" shape=box style=filled fillcolor=lightcyan];
          n47 [label="return C.method()"];
        }

      }

    }

  }

  n10 -> n9 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n10];
  n12 -> n16 [color=steelblue];
  n12 -> n27 [color=steelblue];
  n13 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n14 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n14];
  n15 -> n16 [color=steelblue];
  n16 -> n17 [color=steelblue];
  n18 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n18];
  n19 -> n20 [color=steelblue];
  n20 -> n21 [color=steelblue];
  n21 -> n22 [color=steelblue];
  n23 -> n19 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n24 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n24];
  n25 -> n26 [color=steelblue];
  n26 -> n27 [color=steelblue];
  n27 -> n28 [color=steelblue];
  n29 -> n25 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n30 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n30];
  n31 -> n32 [color=steelblue];
  n32 -> n33 [color=steelblue];
  n33 -> n34 [color=steelblue];
  n35 -> n31 [color=steelblue];
  n36 -> n31 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n37 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n37];
  n38 -> n45 [color=steelblue];
  n39 -> n40 [color=steelblue];
  n41 -> n38 [color=steelblue];
  n42 -> n38 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n44 -> n43 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n44];
  n45 -> n46 [color=steelblue];
  n46 -> n47 [color=steelblue];
  n47 -> n39 [color=steelblue];
  n8 -> n15 [color=steelblue, ltail=cluster_n8];
  n8 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n8];
}