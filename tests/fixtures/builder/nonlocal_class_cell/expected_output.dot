        style=rounded;
        n96 [style=invis];
        n97 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
        n98 [label="create" shape=box style="rounded,filled" fillcolor=lightyellow];
        n99 [label="create_shadowed" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n100 {
          label="create\n(function)";
          style=rounded;
          n100 [style=invis];
          n101 [label="self"];
          n102 [label="replacement"];
          n103 [label="return Inner"];
          n104 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n105 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
          n106 [label="Inner" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n107 {
            label="Inner\n(class)";
            style=rounded;
            n107 [style=invis];
            n108 [label="__class__"];
            n109 [label="value"];
            n110 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }


        subgraph cluster_n111 {
          label="create_shadowed\n(function)";
          style=rounded;
          n111 [style=invis];
          n112 [label="self"];
          n113 [label="__class__"];
          n114 [label="replacement"];
          n115 [label="return Inner"];
          n116 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n117 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
          n118 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
          n119 [label="Inner" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n120 {
            label="Inner\n(class)";
            style=rounded;
            n120 [style=invis];
            n121 [label="__class__"];
            n122 [label="value"];
            n123 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }

      }

    }

  }

  n10 -> n38 [color=steelblue];
  n100 -> n98 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n100];
  n102 -> n108 [color=steelblue];
