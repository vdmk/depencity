digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="__class__"];
      n3 [label="module_value"];
      n4 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="NoOuter" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="NestedOwner" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n8 {
        label="main\n(function)";
        style=rounded;
        n8 [style=invis];
        n9 [label="__class__"];
        n10 [label="ordinary"];
        n11 [label="return A"];
        n12 [label="other"];
        n13 [label="ordinary_value"];
        n14 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
        n15 [label="ordinary" shape=box style="rounded,filled" fillcolor=lightyellow];
        n16 [label="A" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n17 {
          label="A\n(class)";
          style=rounded;
          n17 [style=invis];
          n18 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
          n19 [label="explicit" shape=box style="rounded,filled" fillcolor=lightyellow];
          n20 [label="plain" shape=box style="rounded,filled" fillcolor=lightyellow];
          n21 [label="normal_nonlocal" shape=box style="rounded,filled" fillcolor=lightyellow];
          n22 [label="parameter" shape=box style="rounded,filled" fillcolor=lightyellow];
          n23 [label="local" shape=box style="rounded,filled" fillcolor=lightyellow];
          n24 [label="explicit_global" shape=box style="rounded,filled" fillcolor=lightyellow];
          n25 [label="nested" shape=box style="rounded,filled" fillcolor=lightyellow];
          n26 [label="enclosing_local" shape=box style="rounded,filled" fillcolor=lightyellow];
          n27 [label="rebound" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n28 {
            label="explicit\n(function)";
            style=rounded;
            n28 [style=invis];
            n29 [label="self"];
            n30 [label="return __class__"];
            n31 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }


          subgraph cluster_n32 {
            label="plain\n(function)";
            style=rounded;
            n32 [style=invis];
            n33 [label="self"];
            n34 [label="return __class__"];
            n35 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }


          subgraph cluster_n36 {
            label="normal_nonlocal\n(function)";
            style=rounded;
            n36 [style=invis];
            n37 [label="self"];
            n38 [label="return ordinary"];
            n39 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }


          subgraph cluster_n40 {
            label="parameter\n(function)";
            style=rounded;
            n40 [style=invis];
            n41 [label="self"];
            n42 [label="__class__"];
            n43 [label="return __class__"];
            n44 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
            n45 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
          }


          subgraph cluster_n46 {
            label="local\n(function)";
            style=rounded;
            n46 [style=invis];
            n47 [label="self"];
            n48 [label="__class__"];
            n49 [label="return __class__"];
            n50 [label="local_value"];
            n51 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
            n52 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
          }


          subgraph cluster_n53 {
            label="explicit_global\n(function)";
            style=rounded;
            n53 [style=invis];
            n54 [label="self"];
            n55 [label="return __class__"];
            n56 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }


          subgraph cluster_n57 {
            label="nested\n(function)";
            style=rounded;
            n57 [style=invis];
            n58 [label="self"];
            n59 [label="read()" shape=box style=filled fillcolor=lightcyan];
            n60 [label="return read()"];
            n61 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
            n62 [label="read" shape=box style="rounded,filled" fillcolor=lightyellow];

            subgraph cluster_n63 {
              label="read\n(function)";
              style=rounded;
              n63 [style=invis];
              n64 [label="return __class__"];
            }

          }


          subgraph cluster_n65 {
            label="enclosing_local\n(function)";
            style=rounded;
            n65 [style=invis];
            n66 [label="self"];
            n67 [label="__class__"];
            n68 [label="read()" shape=box style=filled fillcolor=lightcyan];
            n69 [label="return read()"];
            n70 [label="local_value"];
            n71 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
            n72 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
            n73 [label="read" shape=box style="rounded,filled" fillcolor=lightyellow];

            subgraph cluster_n74 {
              label="read\n(function)";
              style=rounded;
              n74 [style=invis];
              n75 [label="return __class__"];
            }

          }


          subgraph cluster_n76 {
            label="rebound\n(function)";
            style=rounded;
            n76 [style=invis];
            n77 [label="self"];
            n78 [label="before"];
            n79 [label="__class__"];
            n80 [label="(before, __class__)" shape=box];
            n81 [label="return (before, __class__)"];
            n82 [label="replacement"];
            n83 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
            n84 [label="before" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }

      }


      subgraph cluster_n85 {
        label="NoOuter\n(class)";
        style=rounded;
        n85 [style=invis];
        n86 [label="explicit" shape=box style="rounded,filled" fillcolor=lightyellow];
        n87 [label="plain" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n88 {
          label="explicit\n(function)";
          style=rounded;
          n88 [style=invis];
          n89 [label="self"];
          n90 [label="return __class__"];
          n91 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n92 {
