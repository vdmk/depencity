digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="handler_without_write" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="with_else_and_finally" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n5 {
        label="main\n(function)";
        style=rounded;
        n5 [style=invis];
        n6 [label="old"];
        n7 [label="value v1"];
        n8 [label="risky()" shape=box style=filled fillcolor=lightcyan];
        n9 [label="exception" shape=diamond];
        n10 [label="exception" shape=diamond];
        n11 [label="value v2"];
        n12 [label="return value"];
        n13 [label="risky"];
        n14 [label="recovered"];
        n15 [label="old" shape=box style="rounded,filled" fillcolor=lightyellow];
        n16 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n17 {
        label="handler_without_write\n(function)";
        style=rounded;
        n17 [style=invis];
        n18 [label="old"];
        n19 [label="value"];
        n20 [label="risky()" shape=box style=filled fillcolor=lightcyan];
        n21 [label="exception" shape=diamond];
        n22 [label="exception" shape=diamond];
        n23 [label="recover()" shape=box style=filled fillcolor=lightcyan];
        n24 [label="return value"];
        n25 [label="risky"];
        n26 [label="recover"];
        n27 [label="old" shape=box style="rounded,filled" fillcolor=lightyellow];
        n28 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n29 {
        label="with_else_and_finally\n(function)";
        style=rounded;
        n29 [style=invis];
        n30 [label="old"];
        n31 [label="value v1"];
        n32 [label="risky()" shape=box style=filled fillcolor=lightcyan];
        n33 [label="exception" shape=diamond];
        n34 [label="exception" shape=diamond];
        n35 [label="value v2"];
        n36 [label="value v3"];
        n37 [label="cleanup()" shape=box style=filled fillcolor=lightcyan];
        n38 [label="value v4"];
        n39 [label="return value"];
        n40 [label="risky"];
        n41 [label="recovered"];
        n42 [label="succeeded"];
        n43 [label="cleanup"];
        n44 [label="old" shape=box style="rounded,filled" fillcolor=lightyellow];
        n45 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n10 -> n11 [color=steelblue];
  n11 -> n12 [color=steelblue];
  n13 -> n8 [color=steelblue];
  n14 -> n11 [color=steelblue];
  n15 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n16 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n16 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n17 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n17];
  n18 -> n19 [color=steelblue];
  n19 -> n24 [color=steelblue];
  n20 -> n21 [color=steelblue];
  n21 -> n22 [color=steelblue];
  n22 -> n23 [color=steelblue];
  n25 -> n20 [color=steelblue];
  n26 -> n23 [color=steelblue];
  n27 -> n18 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n28 -> n19 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n29 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n29];
  n30 -> n31 [color=steelblue];
  n31 -> n37 [color=steelblue];
  n32 -> n33 [color=steelblue];
  n33 -> n34 [color=steelblue];
  n33 -> n36 [color=steelblue];
  n34 -> n35 [color=steelblue];
  n35 -> n37 [color=steelblue];
  n36 -> n37 [color=steelblue];
  n37 -> n38 [color=steelblue];
  n38 -> n39 [color=steelblue];
  n40 -> n32 [color=steelblue];
  n41 -> n35 [color=steelblue];
  n42 -> n36 [color=steelblue];
  n43 -> n37 [color=steelblue];
  n44 -> n30 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n45 -> n31 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n45 -> n35 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n45 -> n36 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n45 -> n38 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n5 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n5];
  n6 -> n7 [color=steelblue];
  n7 -> n12 [color=steelblue];
  n8 -> n9 [color=steelblue];
  n9 -> n10 [color=steelblue];
}