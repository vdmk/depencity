digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="consume" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="read_constant_member" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n4 {
        label="consume\n(function)";
        style=rounded;
        n4 [style=invis];
        n5 [label="factory"];
        n6 [label="values"];
        n7 [label="values[0]"];
        n8 [label="values[0].run"];
        n9 [label="values[0].run()" shape=box style=filled fillcolor=lightcyan];
        n10 [label="return values[0].run()"];
        n11 [label="factory" shape=box style="rounded,filled" fillcolor=lightyellow];
        n12 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n13 {
        label="read_constant_member\n(function)";
        style=rounded;
        n13 [style=invis];
        n14 [label="1 .real"];
        n15 [label="return 1 .real"];
      }

    }

  }

  n11 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n12 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n13 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n13];
  n14 -> n15 [color=steelblue];
  n4 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n4];
  n6 -> n7 [color=steelblue];
  n7 -> n8 [color=steelblue];
  n8 -> n9 [color=steelblue];
  n9 -> n10 [color=steelblue];
}