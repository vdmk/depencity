digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="selected_items" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="selected_calls" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="selected_generator" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="main\n(function)";
        style=rounded;
        n6 [style=invis];
        n7 [label="flag"];
        n8 [label="yes"];
        n9 [label="no"];
        n10 [label="first"];
        n11 [label="second"];
        n12 [label="report"];
        n13 [label="__cond_0__" shape=diamond];
        n14 [label="yes()" shape=box style=filled fillcolor=lightcyan];
        n15 [label="no()" shape=box style=filled fillcolor=lightcyan];
        n16 [label="__op_3__" shape=box];
        n17 [label="choice"];
        n18 [label="flag?" shape=diamond];
        n19 [label="first()" shape=box style=filled fillcolor=lightcyan];
        n20 [label="flag and first()" shape=box];
        n21 [label="conjunction"];
        n22 [label="flag?" shape=diamond];
        n23 [label="second()" shape=box style=filled fillcolor=lightcyan];
        n24 [label="flag or second()" shape=box];
        n25 [label="disjunction"];
        n26 [label="flag" shape=diamond];
        n27 [label="__cond_11__" shape=diamond];
        n28 [label="report()" shape=box style=filled fillcolor=lightcyan];
        n29 [label="assert flag, report()" shape=box];
        n30 [label="(choice, conjunction, disjunction)" shape=box];
        n31 [label="return (choice, conjunction, disjunction)"];
        n32 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n33 [label="yes" shape=box style="rounded,filled" fillcolor=lightyellow];
        n34 [label="no" shape=box style="rounded,filled" fillcolor=lightyellow];
        n35 [label="first" shape=box style="rounded,filled" fillcolor=lightyellow];
        n36 [label="second" shape=box style="rounded,filled" fillcolor=lightyellow];
        n37 [label="report" shape=box style="rounded,filled" fillcolor=lightyellow];
        n38 [label="choice" shape=box style="rounded,filled" fillcolor=lightyellow];
        n39 [label="conjunction" shape=box style="rounded,filled" fillcolor=lightyellow];
        n40 [label="disjunction" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n41 {
        label="selected_items\n(function)";
        style=rounded;
        n41 [style=invis];
        n42 [label="items"];
        n43 [label="flag"];
        n44 [label="left"];
        n45 [label="right"];
        n46 [label="return [left if flag else right for item in items]"];
        n47 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n48 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n49 [label="left" shape=box style="rounded,filled" fillcolor=lightyellow];
        n50 [label="right" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n51 {
          label="__comp_15__\n(comprehension)";
          style=rounded;
          n51 [style=invis];
          n52 [label="for item in items" shape=diamond];
          n53 [label="item in items" shape=box];
          n54 [label="item"];
          n55 [label="__cond_18__" shape=diamond];
          n56 [label="__op_19__" shape=box];
          n57 [label="[left if flag else right for item in items]"];
          n58 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n59 {
        label="selected_calls\n(function)";
        style=rounded;
        n59 [style=invis];
        n60 [label="items"];
        n61 [label="flag"];
        n62 [label="return [first(item) if flag else second(item) for item in items]"];
        n63 [label="first"];
        n64 [label="second"];
        n65 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n66 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n67 {
          label="__comp_20__\n(comprehension)";
          style=rounded;
          n67 [style=invis];
          n68 [label="for item in items" shape=diamond];
          n69 [label="item in items" shape=box];
          n70 [label="item"];
          n71 [label="__cond_23__" shape=diamond];
          n72 [label="first()" shape=box style=filled fillcolor=lightcyan];
          n73 [label="second()" shape=box style=filled fillcolor=lightcyan];
          n74 [label="__op_26__" shape=box];
          n75 [label="[first(item) if flag else second(item) for item in items]"];
          n76 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n77 {
        label="selected_generator\n(function)";
        style=rounded;
        n77 [style=invis];
        n78 [label="items"];
        n79 [label="flag"];
        n80 [label="left"];
        n81 [label="right"];
        n82 [label="return (left if flag else right for item in items)"];
        n83 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n84 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n85 [label="left" shape=box style="rounded,filled" fillcolor=lightyellow];
        n86 [label="right" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n87 {
          label="__comp_27__\n(comprehension)";
          style=rounded;
          n87 [style=invis];
          n88 [label="for item in items" shape=diamond];
          n89 [label="item in items" shape=box];
          n90 [label="item"];
          n91 [label="__cond_30__" shape=diamond];
          n92 [label="__op_31__" shape=box];
          n93 [label="(left if flag else right for item in items)"];
          n94 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }

  }

