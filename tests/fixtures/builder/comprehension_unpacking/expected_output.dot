digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="independent_operations" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="Worker" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="typed_receiver" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="main\n(function)";
        style=rounded;
        n6 [style=invis];
        n7 [label="groups"];
        n8 [label="return [value for first, *rest in groups for value in rest]"];
        n9 [label="groups" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n10 {
          label="__comp_0__\n(comprehension)";
          style=rounded;
          n10 [style=invis];
          n11 [label="for (first, *rest) in groups" shape=diamond];
          n12 [label="(first, *rest) in groups" shape=box];
          n13 [label="(first, *rest)" shape=box];
          n14 [label="first"];
          n15 [label="rest"];
          n16 [label="for value in rest" shape=diamond];
          n17 [label="value in rest" shape=box];
          n18 [label="value"];
          n19 [label="[value for first, *rest in groups for value in rest]"];
          n20 [label="first" shape=box style="rounded,filled" fillcolor=lightyellow];
          n21 [label="rest" shape=box style="rounded,filled" fillcolor=lightyellow];
          n22 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n23 {
        label="independent_operations\n(function)";
        style=rounded;
        n23 [style=invis];
        n24 [label="items"];
        n25 [label="obj"];
        n26 [label="left"];
        n27 [label="right"];
        n28 [label="attributes"];
        n29 [label="arithmetic"];
        n30 [label="indexed"];
        n31 [label="containers"];
        n32 [label="(attributes, arithmetic, indexed, containers)" shape=box];
        n33 [label="return (attributes, arithmetic, indexed, containers)"];
        n34 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n35 [label="obj" shape=box style="rounded,filled" fillcolor=lightyellow];
        n36 [label="left" shape=box style="rounded,filled" fillcolor=lightyellow];
        n37 [label="right" shape=box style="rounded,filled" fillcolor=lightyellow];
        n38 [label="attributes" shape=box style="rounded,filled" fillcolor=lightyellow];
        n39 [label="arithmetic" shape=box style="rounded,filled" fillcolor=lightyellow];
        n40 [label="indexed" shape=box style="rounded,filled" fillcolor=lightyellow];
        n41 [label="containers" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n42 {
          label="__comp_6__\n(comprehension)";
          style=rounded;
          n42 [style=invis];
          n43 [label="for _ in items" shape=diamond];
          n44 [label="_ in items" shape=box];
          n45 [label="_"];
          n46 [label="obj.attr"];
          n47 [label="[obj.attr for _ in items]"];
          n48 [label="_" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n49 {
          label="__comp_10__\n(comprehension)";
          style=rounded;
          n49 [style=invis];
          n50 [label="for _ in items" shape=diamond];
          n51 [label="_ in items" shape=box];
          n52 [label="_"];
          n53 [label="left + right" shape=box];
          n54 [label="[left + right for _ in items]"];
          n55 [label="_" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n56 {
          label="__comp_14__\n(comprehension)";
          style=rounded;
          n56 [style=invis];
          n57 [label="for _ in items" shape=diamond];
          n58 [label="_ in items" shape=box];
          n59 [label="_"];
          n60 [label="obj[0]"];
          n61 [label="[obj[0] for _ in items]"];
          n62 [label="_" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n63 {
          label="__comp_18__\n(comprehension)";
          style=rounded;
          n63 [style=invis];
          n64 [label="for _ in items" shape=diamond];
          n65 [label="_ in items" shape=box];
          n66 [label="_"];
          n67 [label="[left, right]" shape=box];
          n68 [label="[[left, right] for _ in items]"];
          n69 [label="_" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n70 {
        label="Worker\n(class)";
        style=rounded;
        n70 [style=invis];
        n71 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n72 {
          label="run\n(function)";
          style=rounded;
          n72 [style=invis];
          n73 [label="self"];
          n74 [label="return payload"];
          n75 [label="payload"];
          n76 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n77 {
        label="typed_receiver\n(function)";
        style=rounded;
        n77 [style=invis];
        n78 [label="items"];
        n79 [label="obj"];
        n80 [label="return [obj.run() for _ in items]"];
        n81 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n82 [label="obj" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n83 {
          label="__comp_23__\n(comprehension)";
          style=rounded;
          n83 [style=invis];
          n84 [label="for _ in items" shape=diamond];
          n85 [label="_ in items" shape=box];
          n86 [label="_"];
          n87 [label="obj.run"];
          n88 [label="obj.run()" shape=box style=filled fillcolor=lightcyan];
          n89 [label="[obj.run() for _ in items]"];
          n90 [label="_" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }

  }

