digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="Direct" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="Base" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="Outer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="Direct\n(class)";
        style=rounded;
        n6 [style=invis];
        n7 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
        n8 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n9 {
          label="__init__\n(function)";
          style=rounded;
          n9 [style=invis];
          n10 [label="self"];
          n11 [label="initialize_direct()" shape=box style=filled fillcolor=lightcyan];
          n12 [label="return None (implicit)"];
          n13 [label="initialize_direct"];
          n14 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n15 {
          label="run\n(function)";
          style=rounded;
          n15 [style=invis];
          n16 [label="self"];
          n17 [label="return direct_source"];
          n18 [label="direct_source"];
          n19 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n20 {
        label="Base\n(class)";
        style=rounded;
        n20 [style=invis];
        n21 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
        n22 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n23 {
          label="__init__\n(function)";
          style=rounded;
          n23 [style=invis];
          n24 [label="self"];
          n25 [label="initialize_base()" shape=box style=filled fillcolor=lightcyan];
          n26 [label="return None (implicit)"];
          n27 [label="initialize_base"];
          n28 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n29 {
          label="run\n(function)";
          style=rounded;
          n29 [style=invis];
          n30 [label="self"];
          n31 [label="return inherited_source"];
          n32 [label="inherited_source"];
          n33 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n34 {
        label="Outer\n(class)";
        style=rounded;
        n34 [style=invis];
        n37 [label="Inherited" shape=box style="rounded,filled" fillcolor=lightyellow];
        n38 [label="ordinary" shape=box style="rounded,filled" fillcolor=lightyellow];
        n39 [label="Inner" shape=box style="rounded,filled" fillcolor=lightyellow];
        n40 [label="Plain" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n41 {
          label="Inner\n(class)";
          style=rounded;
          n41 [style=invis];
          n42 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
          n43 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n44 {
            label="__init__\n(function)";
            style=rounded;
            n44 [style=invis];
            n45 [label="self"];
            n46 [label="initialize_nested()" shape=box style=filled fillcolor=lightcyan];
            n47 [label="return None (implicit)"];
            n48 [label="initialize_nested"];
            n49 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }


          subgraph cluster_n50 {
            label="run\n(function)";
            style=rounded;
            n50 [style=invis];
            n51 [label="self"];
            n52 [label="return nested_source"];
            n53 [label="nested_source"];
            n54 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }


        subgraph cluster_n55 {
          label="Inherited\n(class)";
          style=rounded;
          n55 [style=invis];
        }


        subgraph cluster_n56 {
          label="Plain\n(class)";
          style=rounded;
          n56 [style=invis];
          n57 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n58 {
            label="run\n(function)";
            style=rounded;
            n58 [style=invis];
            n59 [label="self"];
            n60 [label="return plain_source"];
            n61 [label="plain_source"];
            n62 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }


        subgraph cluster_n63 {
          label="ordinary\n(function)";
          style=rounded;
          n63 [style=invis];
          n64 [label="return ordinary_source"];
          n65 [label="ordinary_source"];
        }

      }


      subgraph cluster_n66 {
        label="main\n(function)";
        style=rounded;
        n66 [style=invis];
        n67 [label="Direct()" shape=box style=filled fillcolor=lightcyan];
        n68 [label="direct"];
        n69 [label="Outer.Inner"];
        n70 [label="Outer.Inner()" shape=box style=filled fillcolor=lightcyan];
        n71 [label="nested"];
        n72 [label="Outer.Inherited"];
        n73 [label="Outer.Inherited()" shape=box style=filled fillcolor=lightcyan];
        n74 [label="inherited"];
        n75 [label="Outer.Plain"];
        n76 [label="Outer.Plain()" shape=box style=filled fillcolor=lightcyan];
        n77 [label="plain"];
        n78 [label="Outer.ordinary"];
        n79 [label="Outer.ordinary()" shape=box style=filled fillcolor=lightcyan];
        n80 [label="ordinary"];
        n81 [label="direct.run"];
        n82 [label="direct.run()" shape=box style=filled fillcolor=lightcyan];
        n83 [label="nested.run"];
        n84 [label="nested.run()" shape=box style=filled fillcolor=lightcyan];
        n85 [label="inherited.run"];
        n86 [label="inherited.run()" shape=box style=filled fillcolor=lightcyan];
        n87 [label="plain.run"];
        n88 [label="plain.run()" shape=box style=filled fillcolor=lightcyan];
        n89 [label="Outer.Inner"];
        n90 [label="Outer.Inner()" shape=box style=filled fillcolor=lightcyan];
        n91 [label="Outer.Inner().run"];
        n92 [label="Outer.Inner().run()" shape=box style=filled fillcolor=lightcyan];
        n93 [label="ordinary.run"];
        n94 [label="ordinary.run()" shape=box style=filled fillcolor=lightcyan];
        n95 [label="(direct.run(), nested.run(), inherited.run(), plain.run(), Outer.Inner().run(), ordinary.run())" shape=box];
        n96 [label="return (direct.run(), nested.run(), inherited.run(), plain.run(), Outer.Inner().run(), ordinary.run())"];
        n97 [label="direct" shape=box style="rounded,filled" fillcolor=lightyellow];
        n98 [label="nested" shape=box style="rounded,filled" fillcolor=lightyellow];
        n99 [label="inherited" shape=box style="rounded,filled" fillcolor=lightyellow];
        n100 [label="plain" shape=box style="rounded,filled" fillcolor=lightyellow];
        n101 [label="ordinary" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n102 {
      label="builtins\n(builtins)";
      style=rounded;
      n102 [style=invis];
      n103 [label="staticmethod"];
      n104 [label="staticmethod" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

