digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="for_with_break" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="while_with_break" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="guarded_continue" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="for_carried_binding" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="while_carried_binding" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n8 {
        label="main\n(function)";
        style=rounded;
        n8 [style=invis];
        n9 [label="items"];
        n10 [label="seed"];
        n11 [label="x v1"];
        n12 [label="for item in items" shape=diamond];
        n13 [label="item in items" shape=box];
        n14 [label="item"];
        n15 [label="x v2"];
        n16 [label="return x"];
        n17 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n18 [label="seed" shape=box style="rounded,filled" fillcolor=lightyellow];
        n19 [label="x" shape=box style="rounded,filled" fillcolor=lightyellow];
        n20 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n21 {
        label="for_with_break\n(function)";
        style=rounded;
        n21 [style=invis];
        n22 [label="items"];
        n23 [label="seed"];
        n24 [label="value v1"];
        n25 [label="for item in items" shape=diamond];
        n26 [label="item in items" shape=box];
        n27 [label="item"];
        n28 [label="value v2"];
        n29 [label="if item" shape=diamond];
        n30 [label="return value"];
        n31 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n32 [label="seed" shape=box style="rounded,filled" fillcolor=lightyellow];
        n33 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n34 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n35 {
        label="while_with_break\n(function)";
        style=rounded;
        n35 [style=invis];
        n36 [label="flag v1"];
        n37 [label="seed"];
        n38 [label="value v1"];
        n39 [label="flag" shape=diamond];
        n40 [label="value v2"];
        n41 [label="if should_stop" shape=diamond];
        n42 [label="flag v2"];
        n43 [label="return value"];
        n44 [label="next_value"];
        n45 [label="should_stop"];
        n46 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n47 [label="seed" shape=box style="rounded,filled" fillcolor=lightyellow];
        n48 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n49 {
        label="guarded_continue\n(function)";
        style=rounded;
        n49 [style=invis];
        n50 [label="items"];
        n51 [label="seed"];
        n52 [label="value v1"];
        n53 [label="for item in items" shape=diamond];
        n54 [label="item in items" shape=box];
        n55 [label="item"];
        n56 [label="item is None" shape=box];
        n57 [label="if item is None" shape=diamond];
        n58 [label="value v2"];
        n59 [label="return value"];
        n60 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n61 [label="seed" shape=box style="rounded,filled" fillcolor=lightyellow];
        n62 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n63 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n64 {
        label="for_carried_binding\n(function)";
        style=rounded;
        n64 [style=invis];
        n65 [label="items"];
        n66 [label="initial"];
        n67 [label="replacement"];
        n68 [label="value v1"];
        n69 [label="for item in items" shape=diamond];
        n70 [label="item in items" shape=box];
        n71 [label="item"];
        n72 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n73 [label="value v2"];
        n74 [label="return value"];
        n75 [label="consume"];
        n76 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n77 [label="initial" shape=box style="rounded,filled" fillcolor=lightyellow];
        n78 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n79 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n80 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n81 {
        label="while_carried_binding\n(function)";
        style=rounded;
        n81 [style=invis];
        n82 [label="initial"];
        n83 [label="replacement"];
        n84 [label="value v1"];
        n85 [label="ready()" shape=box style=filled fillcolor=lightcyan];
        n86 [label="ready(value)" shape=diamond];
        n87 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n88 [label="value v2"];
        n89 [label="return value"];
        n90 [label="ready"];
        n91 [label="consume"];
        n92 [label="initial" shape=box style="rounded,filled" fillcolor=lightyellow];
        n93 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n94 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

