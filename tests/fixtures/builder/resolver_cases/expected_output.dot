digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="outside.imported"];

    subgraph cluster_n2 {
      label="__module__\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="imported"];
      n4 [label="{'missing': 'missing', 'failed': 'bad'}" shape=box];
      n5 [label="table"];
      n6 [label="imported" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="table" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="local_flow" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="identity" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="shadowed_function" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="returns_many" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="caller" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="no_return" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="caller_without_return" shape=box style="rounded,filled" fillcolor=lightyellow];
      n16 [label="imported_caller" shape=box style="rounded,filled" fillcolor=lightyellow];
      n17 [label="builtin_call" shape=box style="rounded,filled" fillcolor=lightyellow];
      n18 [label="outer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n19 [label="deep_outer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n20 [label="no_self_dependency" shape=box style="rounded,filled" fillcolor=lightyellow];
      n21 [label="branch_reassignment" shape=box style="rounded,filled" fillcolor=lightyellow];
      n22 [label="sequential_reassignment" shape=box style="rounded,filled" fillcolor=lightyellow];
      n23 [label="temporary_container_selection" shape=box style="rounded,filled" fillcolor=lightyellow];
      n24 [label="persistent_container_selection" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n25 {
        label="local_flow\n(function)";
        style=rounded;
        n25 [style=invis];
        n26 [label="value"];
        n27 [label="value + 1" shape=box];
        n28 [label="result"];
        n29 [label="return result"];
        n30 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n31 [label="result" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n32 {
        label="identity\n(function)";
        style=rounded;
        n32 [style=invis];
        n33 [label="value"];
        n34 [label="return value"];
        n35 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n36 {
        label="f\n(function)";
        style=rounded;
        n36 [style=invis];
        n37 [label="return 1"];
      }


      subgraph cluster_n38 {
        label="shadowed_function\n(function)";
        style=rounded;
        n38 [style=invis];
        n39 [label="f"];
        n40 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n41 [label="return f()"];
        n42 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n43 {
        label="returns_many\n(function)";
        style=rounded;
        n43 [style=invis];
        n44 [label="flag"];
        n45 [label="if flag" shape=diamond];
        n46 [label="return 1"];
        n47 [label="return 2"];
        n48 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n49 {
        label="caller\n(function)";
        style=rounded;
        n49 [style=invis];
        n50 [label="flag"];
        n51 [label="returns_many()" shape=box style=filled fillcolor=lightcyan];
        n52 [label="return returns_many(flag)"];
        n53 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n54 {
        label="no_return\n(function)";
        style=rounded;
        n54 [style=invis];
        n55 [label="return None (implicit)"];
      }


      subgraph cluster_n56 {
        label="caller_without_return\n(function)";
        style=rounded;
        n56 [style=invis];
        n57 [label="no_return()" shape=box style=filled fillcolor=lightcyan];
        n58 [label="return no_return()"];
      }


      subgraph cluster_n59 {
        label="imported_caller\n(function)";
        style=rounded;
        n59 [style=invis];
        n60 [label="imported()" shape=box style=filled fillcolor=lightcyan];
        n61 [label="return imported()"];
      }


      subgraph cluster_n62 {
        label="builtin_call\n(function)";
        style=rounded;
        n62 [style=invis];
        n63 [label="items"];
        n64 [label="len()" shape=box style=filled fillcolor=lightcyan];
        n65 [label="return len(items)"];
        n66 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n67 {
        label="outer\n(function)";
        style=rounded;
        n67 [style=invis];
        n68 [label="seed"];
        n69 [label="value"];
        n70 [label="inner()" shape=box style=filled fillcolor=lightcyan];
        n71 [label="return inner()"];
        n72 [label="seed" shape=box style="rounded,filled" fillcolor=lightyellow];
        n73 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n74 [label="inner" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n75 {
          label="inner\n(function)";
          style=rounded;
          n75 [style=invis];
          n76 [label="return value"];
        }

      }


      subgraph cluster_n77 {
        label="deep_outer\n(function)";
        style=rounded;
        n77 [style=invis];
        n78 [label="seed"];
        n79 [label="value"];
        n80 [label="middle()" shape=box style=filled fillcolor=lightcyan];
        n81 [label="return middle()"];
        n82 [label="seed" shape=box style="rounded,filled" fillcolor=lightyellow];
        n83 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n84 [label="middle" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n85 {
          label="middle\n(function)";
          style=rounded;
          n85 [style=invis];
          n86 [label="inner()" shape=box style=filled fillcolor=lightcyan];
          n87 [label="return inner()"];
          n88 [label="inner" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n89 {
            label="inner\n(function)";
            style=rounded;
            n89 [style=invis];
            n90 [label="return value"];
          }

        }

      }


      subgraph cluster_n91 {
        label="no_self_dependency\n(function)";
        style=rounded;
        n91 [style=invis];
        n92 [label="value"];
        n93 [label="return value"];
        n94 [label="value"];
        n95 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n96 {
        label="branch_reassignment\n(function)";
        style=rounded;
        n96 [style=invis];
        n97 [label="flag"];
        n98 [label="value v1"];
        n99 [label="if flag" shape=diamond];
        n100 [label="value v2"];
        n101 [label="value v3"];
        n102 [label="return value"];
        n103 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n104 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n105 {
        label="sequential_reassignment\n(function)";
        style=rounded;
        n105 [style=invis];
        n106 [label="value v1"];
        n107 [label="value + 1" shape=box];
        n108 [label="value v2"];
        n109 [label="value + 2" shape=box];
        n110 [label="value v3"];
        n111 [label="return value"];
        n112 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n113 {
        label="temporary_container_selection\n(function)";
        style=rounded;
        n113 [style=invis];
        n114 [label="value"];
        n115 [label="{None: 'missing', 'failed': 'bad'}" shape=box];
        n116 [label="{None: 'missing', 'failed': 'bad'}.get"];
        n117 [label="{None: 'missing', 'failed': 'bad'}.get()" shape=box style=filled fillcolor=lightcyan];
        n118 [label="return {None: 'missing', 'failed': 'bad'}.get(value)"];
        n119 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n120 {
        label="persistent_container_selection\n(function)";
        style=rounded;
        n120 [style=invis];
        n121 [label="value"];
        n122 [label="table.get"];
        n123 [label="table.get()" shape=box style=filled fillcolor=lightcyan];
        n124 [label="return table.get(value)"];
        n125 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n126 {
      label="builtins\n(builtins)";
      style=rounded;
      n126 [style=invis];
      n127 [label="len"];
      n128 [label="len" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n1 -> n3 [color=steelblue];
  n100 -> n102 [color=steelblue];
  n101 -> n102 [color=steelblue];
  n103 -> n97 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n104 -> n100 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
