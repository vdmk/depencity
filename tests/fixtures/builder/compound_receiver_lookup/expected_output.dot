  n23 -> n24 [color=steelblue];
  n24 -> n25 [color=steelblue];
  n25 -> n26 [color=steelblue];
  n26 -> n37 [color=steelblue];
  n27 -> n29 [color=steelblue];
  n28 -> n29 [color=steelblue];
  n29 -> n30 [color=steelblue];
  n30 -> n31 [color=steelblue];
  n31 -> n32 [color=steelblue];
  n32 -> n37 [color=steelblue];
  n33 -> n34 [color=steelblue];
  n34 -> n35 [color=steelblue];
  n35 -> n36 [color=steelblue];
  n36 -> n37 [color=steelblue];
  n37 -> n38 [color=steelblue];
  n39 -> n16 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n40 -> n17 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n41 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n41];
  n42 -> n45 [color=steelblue];
  n43 -> n44 [color=steelblue];
  n44 -> n45 [color=steelblue];
  n45 -> n46 [color=steelblue];
  n46 -> n47 [color=steelblue];
  n47 -> n51 [color=steelblue];
  n48 -> n49 [color=steelblue];
  n49 -> n50 [color=steelblue];
  n50 -> n51 [color=steelblue];
  n51 -> n52 [color=steelblue];
  n53 -> n48 [color=steelblue];
  n54 -> n42 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n55 -> n43 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n56 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n56];
  n57 -> n59 [color=steelblue];
  n58 -> n61 [color=steelblue];
  n59 -> n60 [color=steelblue];
  n59 -> n61 [color=steelblue];
  n6 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n6];
  n6 -> n33 [color=steelblue, ltail=cluster_n6];
  n61 -> n62 [color=steelblue];
  n62 -> n63 [color=steelblue];
  n63 -> n64 [color=steelblue];
  n65 -> n57 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n66 -> n58 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n8 -> n34 [color=steelblue, ltail=cluster_n8];
  n8 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n8];
}