digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="positional_and_keyword_only" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="lambda_defaults" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="decorated_default" shape=box style="rounded,filled" fillcolor=lightyellow];
