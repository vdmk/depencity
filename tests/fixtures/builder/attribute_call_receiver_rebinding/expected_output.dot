digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="A" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="B" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="positional_argument" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="keyword_argument" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="annotated_keyword_argument" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n8 {
        label="A\n(class)";
        style=rounded;
        n8 [style=invis];
        n9 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n10 {
          label="run\n(function)";
          style=rounded;
          n10 [style=invis];
          n11 [label="self"];
          n12 [label="value"];
          n13 [label="return 1"];
          n14 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n15 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n16 {
        label="B\n(class)";
        style=rounded;
        n16 [style=invis];
        n17 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n18 {
          label="run\n(function)";
          style=rounded;
          n18 [style=invis];
          n19 [label="self"];
          n20 [label="value"];
          n21 [label="return 2"];
          n22 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n23 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n24 {
        label="positional_argument\n(function)";
        style=rounded;
        n24 [style=invis];
        n25 [label="A()" shape=box style=filled fillcolor=lightcyan];
        n26 [label="receiver v1"];
        n27 [label="receiver.run"];
        n28 [label="B()" shape=box style=filled fillcolor=lightcyan];
        n29 [label="receiver v2"];
        n30 [label="receiver.run()" shape=box style=filled fillcolor=lightcyan];
        n31 [label="return receiver.run((receiver := B()))"];
        n32 [label="receiver" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n33 {
        label="keyword_argument\n(function)";
        style=rounded;
        n33 [style=invis];
        n34 [label="A()" shape=box style=filled fillcolor=lightcyan];
        n35 [label="receiver v1"];
        n36 [label="receiver.run"];
        n37 [label="B()" shape=box style=filled fillcolor=lightcyan];
        n38 [label="receiver v2"];
        n39 [label="receiver.run()" shape=box style=filled fillcolor=lightcyan];
        n40 [label="return receiver.run(value=(receiver := B()))"];
        n41 [label="receiver" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n42 {
        label="main\n(function)";
        style=rounded;
        n42 [style=invis];
        n43 [label="receiver v1"];
        n44 [label="replacement"];
        n45 [label="receiver.run"];
        n46 [label="receiver v2"];
        n47 [label="receiver.run()" shape=box style=filled fillcolor=lightcyan];
        n48 [label="first"];
        n49 [label="receiver.run"];
        n50 [label="receiver.run()" shape=box style=filled fillcolor=lightcyan];
        n51 [label="(first, receiver.run(replacement))" shape=box];
        n52 [label="return (first, receiver.run(replacement))"];
        n53 [label="receiver" shape=box style="rounded,filled" fillcolor=lightyellow];
        n54 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n55 [label="first" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n56 {
        label="annotated_keyword_argument\n(function)";
        style=rounded;
        n56 [style=invis];
        n57 [label="receiver v1"];
        n58 [label="replacement"];
        n59 [label="receiver.run"];
        n60 [label="receiver v2"];
        n61 [label="receiver.run()" shape=box style=filled fillcolor=lightcyan];
        n62 [label="first"];
        n63 [label="receiver.run"];
        n64 [label="receiver.run()" shape=box style=filled fillcolor=lightcyan];
        n65 [label="(first, receiver.run(replacement))" shape=box];
        n66 [label="return (first, receiver.run(replacement))"];
        n67 [label="receiver" shape=box style="rounded,filled" fillcolor=lightyellow];
        n68 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n69 [label="first" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n10 -> n9 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n10];
