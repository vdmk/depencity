digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n3 [label="Child" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="Worker" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="Worker\n(class)";
        style=rounded;
        n6 [style=invis];
        n8 [label="static" shape=box style="rounded,filled" fillcolor=lightyellow];
        n9 [label="normalize" shape=box style="rounded,filled" fillcolor=lightyellow];
        n10 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];
        n11 [label="renamed_receiver" shape=box style="rounded,filled" fillcolor=lightyellow];
        n12 [label="with_nested_function" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n13 {
          label="normalize\n(function)";
          style=rounded;
          n13 [style=invis];
          n14 [label="self"];
          n15 [label="value"];
          n16 [label="return value"];
          n17 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n18 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n19 {
          label="run\n(function)";
          style=rounded;
          n19 [style=invis];
          n20 [label="self"];
          n21 [label="value"];
          n22 [label="self.normalize"];
          n23 [label="self.normalize()" shape=box style=filled fillcolor=lightcyan];
          n24 [label="return self.normalize(value)"];
          n25 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n26 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n27 {
          label="renamed_receiver\n(function)";
          style=rounded;
          n27 [style=invis];
          n28 [label="receiver"];
          n29 [label="value"];
          n30 [label="receiver.normalize"];
          n31 [label="receiver.normalize()" shape=box style=filled fillcolor=lightcyan];
          n32 [label="return receiver.normalize(value)"];
          n33 [label="receiver" shape=box style="rounded,filled" fillcolor=lightyellow];
          n34 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n35 {
          label="static\n(function)";
          style=rounded;
          n35 [style=invis];
          n36 [label="self"];
          n37 [label="value"];
          n38 [label="self.normalize"];
          n39 [label="self.normalize()" shape=box style=filled fillcolor=lightcyan];
          n40 [label="return self.normalize(value)"];
          n41 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n42 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n43 {
          label="with_nested_function\n(function)";
          style=rounded;
          n43 [style=invis];
          n44 [label="self"];
          n45 [label="return nested"];
          n46 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n47 [label="nested" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n48 {
            label="nested\n(function)";
            style=rounded;
            n48 [style=invis];
            n49 [label="self"];
            n50 [label="value"];
            n51 [label="self.normalize"];
            n52 [label="self.normalize()" shape=box style=filled fillcolor=lightcyan];
            n53 [label="return self.normalize(value)"];
            n54 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
            n55 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }

      }


      subgraph cluster_n56 {
        label="Child\n(class)";
        style=rounded;
        n56 [style=invis];
        n57 [label="run_inherited" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n58 {
          label="run_inherited\n(function)";
          style=rounded;
          n58 [style=invis];
          n59 [label="self"];
          n60 [label="value"];
          n61 [label="self.normalize"];
          n62 [label="self.normalize()" shape=box style=filled fillcolor=lightcyan];
          n63 [label="return self.normalize(value)"];
          n64 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n65 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n66 {
        label="main\n(function)";
        style=rounded;
        n66 [style=invis];
        n67 [label="worker"];
        n68 [label="child"];
        n69 [label="value"];
        n70 [label="worker.run"];
        n71 [label="worker.run()" shape=box style=filled fillcolor=lightcyan];
        n72 [label="worker.renamed_receiver"];
        n73 [label="worker.renamed_receiver()" shape=box style=filled fillcolor=lightcyan];
        n74 [label="child.run_inherited"];
        n75 [label="child.run_inherited()" shape=box style=filled fillcolor=lightcyan];
        n76 [label="Worker.static"];
        n77 [label="Worker.static()" shape=box style=filled fillcolor=lightcyan];
        n78 [label="(worker.run(value), worker.renamed_receiver(value), child.run_inherited(value), Worker.static(worker, value))" shape=box];
        n79 [label="return (worker.run(value), worker.renamed_receiver(value), child.run_inherited(value), Worker.static(worker, value))"];
        n80 [label="worker" shape=box style="rounded,filled" fillcolor=lightyellow];
        n81 [label="child" shape=box style="rounded,filled" fillcolor=lightyellow];
        n82 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n83 {
      label="builtins\n(builtins)";
      style=rounded;
      n83 [style=invis];
      n84 [label="staticmethod"];
      n85 [label="staticmethod" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n13 -> n9 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n13];
  n15 -> n16 [color=steelblue];
  n16 -> n23 [color=steelblue];
  n16 -> n31 [color=steelblue];
  n16 -> n62 [color=steelblue];
