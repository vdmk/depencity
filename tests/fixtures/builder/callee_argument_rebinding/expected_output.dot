digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="module_callback v1"];
      n3 [label="module_callback v2"];
      n4 [label="module_callback()" shape=box style=filled fillcolor=lightcyan];
      n5 [label="module_result"];
      n6 [label="module_callback" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="module_result" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="first" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="second" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="callback_parameter" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="local_binding" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="unbound_local_callee" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="positional_walrus" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="keyword_walrus" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="unbound_keyword_callee" shape=box style="rounded,filled" fillcolor=lightyellow];
      n16 [label="shadow_outer_callee" shape=box style="rounded,filled" fillcolor=lightyellow];
      n17 [label="shadow_builtin_callee" shape=box style="rounded,filled" fillcolor=lightyellow];
      n18 [label="repeated_callee_name" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n19 {
        label="first\n(function)";
        style=rounded;
        n19 [style=invis];
        n20 [label="value"];
        n21 [label="return value"];
        n22 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n23 {
        label="second\n(function)";
        style=rounded;
        n23 [style=invis];
        n24 [label="value"];
        n25 [label="return value"];
        n26 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n27 {
        label="callback_parameter\n(function)";
        style=rounded;
        n27 [style=invis];
        n28 [label="callback v1"];
        n29 [label="callback v2"];
        n30 [label="callback()" shape=box style=filled fillcolor=lightcyan];
        n31 [label="return callback((callback := second))"];
        n32 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n33 {
        label="local_binding\n(function)";
        style=rounded;
        n33 [style=invis];
        n34 [label="callback v1"];
        n35 [label="callback v2"];
        n36 [label="callback()" shape=box style=filled fillcolor=lightcyan];
        n37 [label="return callback((callback := second))"];
        n38 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n39 {
        label="unbound_local_callee\n(function)";
        style=rounded;
        n39 [style=invis];
        n40 [label="callback"];
        n41 [label="callback()" shape=box style=filled fillcolor=lightcyan];
        n42 [label="return callback((callback := second))"];
        n43 [label="callback"];
        n44 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n45 {
        label="positional_walrus\n(function)";
        style=rounded;
        n45 [style=invis];
        n46 [label="callback v1"];
        n47 [label="callback v2"];
        n48 [label="callback()" shape=box style=filled fillcolor=lightcyan];
        n49 [label="return callback((callback := second))"];
        n50 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n51 {
        label="keyword_walrus\n(function)";
        style=rounded;
        n51 [style=invis];
        n52 [label="callback v1"];
        n53 [label="callback v2"];
        n54 [label="callback()" shape=box style=filled fillcolor=lightcyan];
        n55 [label="return callback(value=(callback := second))"];
        n56 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n57 {
        label="unbound_keyword_callee\n(function)";
        style=rounded;
        n57 [style=invis];
        n58 [label="callback"];
        n59 [label="callback()" shape=box style=filled fillcolor=lightcyan];
        n60 [label="return callback(value=(callback := second))"];
        n61 [label="callback"];
        n62 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n63 {
        label="shadow_outer_callee\n(function)";
        style=rounded;
        n63 [style=invis];
        n64 [label="callback"];
        n65 [label="inner()" shape=box style=filled fillcolor=lightcyan];
        n66 [label="return inner()"];
        n67 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
        n68 [label="inner" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n69 {
          label="inner\n(function)";
          style=rounded;
          n69 [style=invis];
          n70 [label="callback"];
          n71 [label="callback()" shape=box style=filled fillcolor=lightcyan];
          n72 [label="return callback((callback := second))"];
          n73 [label="callback"];
          n74 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n75 {
        label="shadow_builtin_callee\n(function)";
        style=rounded;
        n75 [style=invis];
        n76 [label="len"];
        n77 [label="len()" shape=box style=filled fillcolor=lightcyan];
        n78 [label="return len((len := second))"];
        n79 [label="len"];
        n80 [label="len" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n81 {
        label="repeated_callee_name\n(function)";
        style=rounded;
        n81 [style=invis];
        n82 [label="callback v1"];
        n83 [label="callback v2"];
        n84 [label="callback()" shape=box style=filled fillcolor=lightcyan];
        n85 [label="return callback((callback := second), callback)"];
        n86 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n19 -> n2 [color=steelblue, ltail=cluster_n19];
  n19 -> n34 [color=steelblue, ltail=cluster_n19];
  n19 -> n64 [color=steelblue, ltail=cluster_n19];
