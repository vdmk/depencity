          style=rounded;
          n110 [style=invis];
          n111 [label="self"];
          n112 [label="value"];
          n113 [label="return method_payload"];
          n114 [label="method_payload"];
          n115 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n116 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n117 {
        label="call_configured_method\n(function)";
        style=rounded;
        n117 [style=invis];
        n118 [label="ConfiguredMethod.method"];
        n119 [label="ConfiguredMethod.method()" shape=box style=filled fillcolor=lightcyan];
        n120 [label="return ConfiguredMethod.method()"];
      }


      subgraph cluster_n121 {
        label="InheritedConfiguredMethod\n(class)";
        style=rounded;
        n121 [style=invis];
        n122 [label="invoke" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n123 {
          label="invoke\n(function)";
          style=rounded;
          n123 [style=invis];
          n124 [label="self"];
          n125 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n126 [label="super().method"];
          n127 [label="super().method()" shape=box style=filled fillcolor=lightcyan];
          n128 [label="return super().method()"];
          n129 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }


    subgraph cluster_n130 {
      label="builtins\n(builtins)";
      style=rounded;
      n130 [style=invis];
      n131 [label="super"];
      n132 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

