digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n6 [label="unknown_base"];
      n7 [label="Child" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="SuperChild" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="MultipleBases" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="InheritedConfiguredMethod" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="action" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="Owner" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="class_values" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="inherited_value" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="annotated_receiver" shape=box style="rounded,filled" fillcolor=lightyellow];
      n16 [label="saved_value" shape=box style="rounded,filled" fillcolor=lightyellow];
      n17 [label="overwritten_member" shape=box style="rounded,filled" fillcolor=lightyellow];
      n18 [label="ConfiguredMethod" shape=box style="rounded,filled" fillcolor=lightyellow];
      n19 [label="call_configured_method" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n20 {
        label="action\n(function)";
        style=rounded;
        n20 [style=invis];
        n21 [label="return action_payload"];
        n22 [label="action_payload"];
      }


      subgraph cluster_n23 {
        label="Owner\n(class)";
        style=rounded;
        n23 [style=invis];
        n24 [label="supplied"];
        n25 [label="literal"];
        n26 [label="alias"];
        n27 [label="supplied_action"];
        n28 [label="supplied" shape=box style="rounded,filled" fillcolor=lightyellow];
        n29 [label="literal" shape=box style="rounded,filled" fillcolor=lightyellow];
        n30 [label="alias" shape=box style="rounded,filled" fillcolor=lightyellow];
        n31 [label="declared" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n32 {
          label="declared\n(function)";
          style=rounded;
          n32 [style=invis];
          n33 [label="self"];
          n34 [label="return method_payload"];
          n35 [label="method_payload"];
          n36 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n37 {
        label="Child\n(class)";
        style=rounded;
        n37 [style=invis];
      }


      subgraph cluster_n38 {
        label="class_values\n(function)";
        style=rounded;
        n38 [style=invis];
        n39 [label="Owner.supplied"];
        n40 [label="Owner.supplied()" shape=box style=filled fillcolor=lightcyan];
        n41 [label="Owner.literal"];
        n42 [label="Owner.literal()" shape=box style=filled fillcolor=lightcyan];
        n43 [label="Owner.alias"];
        n44 [label="Owner.alias()" shape=box style=filled fillcolor=lightcyan];
        n45 [label="Owner.declared"];
        n46 [label="Owner.declared()" shape=box style=filled fillcolor=lightcyan];
        n47 [label="(Owner.supplied(), Owner.literal(), Owner.alias(), Owner.declared())" shape=box];
        n48 [label="return (Owner.supplied(), Owner.literal(), Owner.alias(), Owner.declared())"];
      }


      subgraph cluster_n49 {
        label="inherited_value\n(function)";
        style=rounded;
        n49 [style=invis];
        n50 [label="Child.supplied"];
        n51 [label="Child.supplied()" shape=box style=filled fillcolor=lightcyan];
        n52 [label="return Child.supplied()"];
      }


      subgraph cluster_n53 {
        label="annotated_receiver\n(function)";
        style=rounded;
        n53 [style=invis];
        n54 [label="receiver"];
        n55 [label="receiver.supplied"];
        n56 [label="receiver.supplied()" shape=box style=filled fillcolor=lightcyan];
        n57 [label="return receiver.supplied()"];
        n58 [label="receiver" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n59 {
        label="saved_value\n(function)";
        style=rounded;
        n59 [style=invis];
        n60 [label="Owner.supplied"];
        n61 [label="saved"];
        n62 [label="saved()" shape=box style=filled fillcolor=lightcyan];
        n63 [label="return saved()"];
        n64 [label="saved" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n65 {
        label="overwritten_member\n(function)";
        style=rounded;
        n65 [style=invis];
        n66 [label="replacement"];
        n67 [label="Owner.supplied"];
        n68 [label="Owner.supplied"];
        n69 [label="Owner.supplied()" shape=box style=filled fillcolor=lightcyan];
        n70 [label="return Owner.supplied()"];
        n71 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n72 {
        label="SuperChild\n(class)";
        style=rounded;
        n72 [style=invis];
        n73 [label="supplied_value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n74 [label="aliased_value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n75 [label="declared_method" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n76 {
          label="supplied_value\n(function)";
          style=rounded;
          n76 [style=invis];
          n77 [label="self"];
          n78 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n79 [label="super().supplied"];
          n80 [label="super().supplied()" shape=box style=filled fillcolor=lightcyan];
          n81 [label="return super().supplied()"];
          n82 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n83 {
          label="aliased_value\n(function)";
          style=rounded;
          n83 [style=invis];
          n84 [label="self"];
          n85 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n86 [label="super().alias"];
          n87 [label="super().alias()" shape=box style=filled fillcolor=lightcyan];
          n88 [label="return super().alias()"];
          n89 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n90 {
          label="declared_method\n(function)";
          style=rounded;
          n90 [style=invis];
          n91 [label="self"];
          n92 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n93 [label="super().declared"];
          n94 [label="super().declared()" shape=box style=filled fillcolor=lightcyan];
          n95 [label="return super().declared()"];
          n96 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n97 {
        label="MultipleBases\n(class)";
        style=rounded;
        n97 [style=invis];
        n98 [label="unresolved_super" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n99 {
          label="unresolved_super\n(function)";
          style=rounded;
          n99 [style=invis];
          n100 [label="self"];
          n101 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n102 [label="super().supplied"];
          n103 [label="super().supplied()" shape=box style=filled fillcolor=lightcyan];
          n104 [label="return super().supplied()"];
          n105 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n106 {
        label="ConfiguredMethod\n(class)";
        style=rounded;
        n106 [style=invis];
        n108 [label="method_default"];
        n109 [label="method" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n110 {
