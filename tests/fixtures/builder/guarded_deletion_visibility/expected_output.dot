digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="nested_guards" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="deferred_body" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="async_guard" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="finally_guard" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="conditional_versions" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n8 {
        label="main\n(function)";
        style=rounded;
        n8 [style=invis];
        n9 [label="value v1"];
        n10 [label="manager"];
        n11 [label="__with_0__"];
        n12 [label="del value" shape=box];
        n13 [label="guarded"];
        n14 [label="del value" shape=box];
        n15 [label="(guarded, value)" shape=box];
        n16 [label="return (guarded, value)"];
        n17 [label="value"];
        n18 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n19 [label="manager" shape=box style="rounded,filled" fillcolor=lightyellow];
        n20 [label="guarded" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n21 {
        label="nested_guards\n(function)";
        style=rounded;
        n21 [style=invis];
        n22 [label="value"];
        n23 [label="manager"];
        n24 [label="__with_4__"];
        n26 [label="exception" shape=diamond];
        n27 [label="Exception" shape=diamond];
        n28 [label="return value"];
        n29 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n30 [label="manager" shape=box style="rounded,filled" fillcolor=lightyellow];
        n31 [label="Clear" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n32 {
          label="Clear\n(class)";
          style=rounded;
          n32 [style=invis];
          n33 [label="del value" shape=box];
        }

      }


      subgraph cluster_n34 {
        label="deferred_body\n(function)";
        style=rounded;
        n34 [style=invis];
        n35 [label="manager"];
        n36 [label="__with_8__"];
        n37 [label="return clear"];
        n38 [label="manager" shape=box style="rounded,filled" fillcolor=lightyellow];
        n39 [label="clear" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n40 {
          label="clear\n(function)";
          style=rounded;
          n40 [style=invis];
          n41 [label="value v1"];
          n42 [label="del value" shape=box];
          n43 [label="return value"];
          n44 [label="value"];
          n45 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n46 {
        label="async_guard\n(function)";
        style=rounded;
        n46 [style=invis];
        n47 [label="value v1"];
        n48 [label="manager"];
        n49 [label="__with_10__"];
        n50 [label="del value" shape=box];
        n51 [label="return value"];
        n52 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n53 [label="manager" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n54 {
        label="finally_guard\n(function)";
        style=rounded;
        n54 [style=invis];
        n55 [label="value v1"];
        n56 [label="del value" shape=box];
        n57 [label="return value"];
        n58 [label="value"];
        n59 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n60 {
        label="conditional_versions\n(function)";
        style=rounded;
        n60 [style=invis];
        n61 [label="value v1"];
        n62 [label="other"];
        n63 [label="flag"];
        n64 [label="manager"];
        n65 [label="if flag" shape=diamond];
        n66 [label="value v2"];
        n67 [label="__with_14__"];
        n68 [label="del value" shape=box];
        n69 [label="return value"];
        n70 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n71 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];
        n72 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n73 [label="manager" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n74 {
      label="builtins\n(builtins)";
      style=rounded;
      n74 [style=invis];
      n75 [label="Exception"];
      n76 [label="Exception" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

