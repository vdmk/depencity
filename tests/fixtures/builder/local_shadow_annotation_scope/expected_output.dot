digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="consume" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n3 {
        label="consume\n(function)";
        style=rounded;
        n3 [style=invis];
        n4 [label="value"];
        n5 [label="local"];
        n6 [label="local.run"];
        n7 [label="local.run()" shape=box style=filled fillcolor=lightcyan];
        n8 [label="Missing"];
        n9 [label="return None (implicit)"];
        n10 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n11 [label="local" shape=box style="rounded,filled" fillcolor=lightyellow];
        n12 [label="Missing" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n10 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n11 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n12 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n3 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n3];
  n4 -> n5 [color=steelblue];
  n5 -> n6 [color=steelblue];
  n6 -> n7 [color=steelblue];
}