digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="generator_setup" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="delayed_generator" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n5 {
        label="main\n(function)";
        style=rounded;
        n5 [style=invis];
        n6 [label="source"];
        n7 [label="for sync_item in source" shape=diamond];
        n8 [label="sync_item in source" shape=box];
        n9 [label="sync_item"];
        n10 [label="async iteration" shape=box];
        n11 [label="async for async_item in source" shape=diamond];
        n12 [label="async_item in source" shape=box];
        n13 [label="async_item"];
        n14 [label="sync_items"];
        n15 [label="async_items"];
        n16 [label="(sync_item, async_item, sync_items, async_items)" shape=box];
        n17 [label="return (sync_item, async_item, sync_items, async_items)"];
        n18 [label="source" shape=box style="rounded,filled" fillcolor=lightyellow];
        n19 [label="sync_item" shape=box style="rounded,filled" fillcolor=lightyellow];
        n20 [label="async_item" shape=box style="rounded,filled" fillcolor=lightyellow];
        n21 [label="sync_items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n22 [label="async_items" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n23 {
          label="__comp_5__\n(comprehension)";
          style=rounded;
          n23 [style=invis];
          n24 [label="for item in source" shape=diamond];
          n25 [label="item in source" shape=box];
          n26 [label="item"];
          n27 [label="[item for item in source]"];
          n28 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n29 {
          label="__comp_8__\n(comprehension)";
          style=rounded;
          n29 [style=invis];
          n30 [label="async iteration" shape=box];
          n31 [label="async for item in source" shape=diamond];
          n32 [label="item in source" shape=box];
          n33 [label="item"];
          n34 [label="[item async for item in source]"];
          n35 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n36 {
        label="generator_setup\n(function)";
        style=rounded;
        n36 [style=invis];
        n37 [label="source"];
        n38 [label="fallback"];
        n39 [label="async iteration" shape=box];
        n40 [label="return (hidden(item) async for item in source)"];
        n41 [label="exception" shape=diamond];
        n42 [label="Exception" shape=diamond];
        n43 [label="return fallback"];
        n44 [label="source" shape=box style="rounded,filled" fillcolor=lightyellow];
        n45 [label="fallback" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n46 {
          label="__comp_13__\n(comprehension)";
          style=rounded;
          n46 [style=invis];
          n47 [label="async for item in source" shape=diamond];
          n48 [label="item in source" shape=box];
          n49 [label="item"];
          n50 [label="hidden()" shape=box style=filled fillcolor=lightcyan];
          n51 [label="(hidden(item) async for item in source)"];
          n52 [label="hidden"];
          n53 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n54 {
        label="delayed_generator\n(function)";
        style=rounded;
        n54 [style=invis];
        n55 [label="source"];
        n56 [label="fallback"];
        n57 [label="return (hidden(item) for group in source async for item in group)"];
        n58 [label="exception" shape=diamond];
        n59 [label="Exception" shape=diamond];
        n60 [label="return fallback"];
        n61 [label="source" shape=box style="rounded,filled" fillcolor=lightyellow];
        n62 [label="fallback" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n63 {
          label="__comp_20__\n(comprehension)";
          style=rounded;
          n63 [style=invis];
          n64 [label="for group in source" shape=diamond];
          n65 [label="group in source" shape=box];
          n66 [label="group"];
          n67 [label="async iteration" shape=box];
          n68 [label="async for item in group" shape=diamond];
          n69 [label="item in group" shape=box];
          n70 [label="item"];
          n71 [label="hidden()" shape=box style=filled fillcolor=lightcyan];
          n72 [label="(hidden(item) for group in source async for item in group)"];
          n73 [label="hidden"];
          n74 [label="group" shape=box style="rounded,filled" fillcolor=lightyellow];
          n75 [label="item" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }


    subgraph cluster_n76 {
      label="builtins\n(builtins)";
      style=rounded;
      n76 [style=invis];
      n77 [label="Exception"];
      n78 [label="Exception" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

