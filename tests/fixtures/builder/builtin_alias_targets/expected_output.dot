        n115 [style=invis];
        n116 [label="other"];
        n117 [label="values"];
        n118 [label="f v1"];
        n119 [label="f v2"];
        n120 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n121 [label="return f(values)"];
        n122 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];
        n123 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n124 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
