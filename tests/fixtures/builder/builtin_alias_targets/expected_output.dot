        n100 [label="f v1"];
        n101 [label="f v2"];
        n102 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n103 [label="return f((f := len), f)"];
        n104 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];
        n105 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


