        style=rounded;
        n73 [style=invis];
        n74 [label="values"];
        n75 [label="[len]" shape=box];
        n76 [label="f"];
        n77 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n78 [label="return f(values)"];
        n79 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n80 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n81 {
        label="unpacked\n(function)";
        style=rounded;
        n81 [style=invis];
        n82 [label="values"];
        n83 [label="(len,)" shape=box];
        n84 [label="f, = (len,)" shape=box];
