        n92 [label="f v1"];
        n93 [label="f v2"];
        n94 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n95 [label="return f((f := other))"];
        n96 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];
        n97 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n98 {
