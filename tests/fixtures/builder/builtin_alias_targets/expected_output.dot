digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="builtins.__name__"];

    subgraph cluster_n2 {
      label="__module__\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="global_alias"];
      n4 [label="global_alias()" shape=box style=filled fillcolor=lightcyan];
      n5 [label="global_result"];
      n7 [label="values"];
      n8 [label="global_alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="global_result" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="accepts_builtin" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="direct" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="chain" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="constructed" shape=box style="rounded,filled" fillcolor=lightyellow];
      n16 [label="container" shape=box style="rounded,filled" fillcolor=lightyellow];
      n17 [label="unpacked" shape=box style="rounded,filled" fillcolor=lightyellow];
      n18 [label="captured" shape=box style="rounded,filled" fillcolor=lightyellow];
      n19 [label="rebound" shape=box style="rounded,filled" fillcolor=lightyellow];
      n20 [label="shadowed" shape=box style="rounded,filled" fillcolor=lightyellow];
      n21 [label="overwritten" shape=box style="rounded,filled" fillcolor=lightyellow];
      n22 [label="unknown_member" shape=box style="rounded,filled" fillcolor=lightyellow];
      n23 [label="unpacked_builtin" shape=box style="rounded,filled" fillcolor=lightyellow];
      n24 [label="iterated_builtin" shape=box style="rounded,filled" fillcolor=lightyellow];
      n25 [label="call_with_default" shape=box style="rounded,filled" fillcolor=lightyellow];
      n26 [label="produces_builtin" shape=box style="rounded,filled" fillcolor=lightyellow];
      n27 [label="call_producer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n28 [label="module_metadata" shape=box style="rounded,filled" fillcolor=lightyellow];
      n29 [label="local_metadata" shape=box style="rounded,filled" fillcolor=lightyellow];
      n30 [label="explicit_builtin_metadata" shape=box style="rounded,filled" fillcolor=lightyellow];
      n31 [label="BuiltinMembers" shape=box style="rounded,filled" fillcolor=lightyellow];
      n32 [label="builtin_member" shape=box style="rounded,filled" fillcolor=lightyellow];
      n33 [label="saved_builtin_member" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n34 {
        label="main\n(function)";
        style=rounded;
        n34 [style=invis];
        n35 [label="values"];
        n36 [label="f"];
        n37 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n38 [label="return f(values)"];
        n39 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
        n40 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n41 {
        label="direct\n(function)";
        style=rounded;
        n41 [style=invis];
        n42 [label="values"];
        n43 [label="len()" shape=box style=filled fillcolor=lightcyan];
        n44 [label="return len(values)"];
        n45 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n46 {
        label="chain\n(function)";
        style=rounded;
        n46 [style=invis];
        n47 [label="values"];
        n48 [label="first"];
        n49 [label="second"];
        n50 [label="last"];
        n51 [label="last()" shape=box style=filled fillcolor=lightcyan];
        n52 [label="return last(values)"];
