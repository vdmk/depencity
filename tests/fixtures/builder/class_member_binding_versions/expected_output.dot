digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n6 [label="InheritedAlias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="OverwrittenAlias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="Inherited" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="DeletedInherited" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="forward_consumer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="ForwardAliased" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="C" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="Aliased" shape=box style="rounded,filled" fillcolor=lightyellow];
