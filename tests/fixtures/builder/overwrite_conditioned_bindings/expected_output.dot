digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n3 {
        label="main\n(function)";
        style=rounded;
        n3 [style=invis];
        n4 [label="flag"];
        n5 [label="old"];
        n6 [label="new"];
        n7 [label="overwritten_after_condition v1"];
        n8 [label="if flag" shape=diamond];
        n9 [label="overwritten_after_condition v2"];
        n10 [label="overwritten_after_condition v3"];
        n11 [label="condition_after_overwrite v1"];
        n12 [label="condition_after_overwrite v2"];
        n13 [label="if flag" shape=diamond];
        n14 [label="condition_after_overwrite v3"];
        n15 [label="(overwritten_after_condition, condition_after_overwrite)" shape=box];
        n16 [label="return (overwritten_after_condition, condition_after_overwrite)"];
        n17 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n18 [label="old" shape=box style="rounded,filled" fillcolor=lightyellow];
        n19 [label="new" shape=box style="rounded,filled" fillcolor=lightyellow];
        n20 [label="overwritten_after_condition" shape=box style="rounded,filled" fillcolor=lightyellow];
        n21 [label="condition_after_overwrite" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n10 -> n15 [color=steelblue];
  n12 -> n15 [color=steelblue];
  n13 -> n14 [color=steelblue];
  n14 -> n15 [color=steelblue];
  n15 -> n16 [color=steelblue];
  n17 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n18 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n19 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n20 -> n10 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n20 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n20 -> n9 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n21 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n21 -> n12 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n21 -> n14 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n3 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n3];
  n4 -> n13 [color=steelblue];
  n4 -> n8 [color=steelblue];
  n5 -> n11 [color=steelblue];
  n5 -> n7 [color=steelblue];
  n6 -> n14 [color=steelblue];
  n6 -> n9 [color=steelblue];
  n8 -> n9 [color=steelblue];
}