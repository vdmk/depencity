digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="__class__"];
      n5 [label="module_value"];
      n6 [label="unknown_decorator"];
      n7 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="Original" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="Uncertain" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="Replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="replace" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n13 {
        label="Replacement\n(class)";
        style=rounded;
        n13 [style=invis];
      }


      subgraph cluster_n14 {
        label="replace\n(function)";
        style=rounded;
        n14 [style=invis];
        n15 [label="cls"];
        n16 [label="return Replacement"];
        n17 [label="cls" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n18 {
        label="Original\n(class)";
        style=rounded;
        n18 [style=invis];
        n20 [label="marker" shape=box style="rounded,filled" fillcolor=lightyellow];
        n21 [label="read" shape=box style="rounded,filled" fillcolor=lightyellow];
        n22 [label="nested" shape=box style="rounded,filled" fillcolor=lightyellow];
        n23 [label="alias" shape=box style="rounded,filled" fillcolor=lightyellow];
        n24 [label="direct" shape=box style="rounded,filled" fillcolor=lightyellow];
        n25 [label="saved" shape=box style="rounded,filled" fillcolor=lightyellow];
        n26 [label="construct" shape=box style="rounded,filled" fillcolor=lightyellow];
        n27 [label="parameter_shadow" shape=box style="rounded,filled" fillcolor=lightyellow];
        n28 [label="enclosing_shadow" shape=box style="rounded,filled" fillcolor=lightyellow];
        n29 [label="global_shadow" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n30 {
          label="marker\n(function)";
          style=rounded;
          n30 [style=invis];
          n31 [label="return original_value"];
          n32 [label="original_value"];
        }


        subgraph cluster_n33 {
          label="read\n(function)";
          style=rounded;
          n33 [style=invis];
          n34 [label="self"];
          n35 [label="return __class__"];
          n36 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n37 {
          label="nested\n(function)";
          style=rounded;
          n37 [style=invis];
          n38 [label="self"];
          n39 [label="read()" shape=box style=filled fillcolor=lightcyan];
          n40 [label="return read()"];
          n41 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n42 [label="read" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n43 {
            label="read\n(function)";
            style=rounded;
            n43 [style=invis];
            n44 [label="return __class__"];
          }

        }


        subgraph cluster_n45 {
          label="alias\n(function)";
          style=rounded;
          n45 [style=invis];
          n46 [label="self"];
          n47 [label="cls"];
          n48 [label="cls.marker"];
          n49 [label="cls.marker()" shape=box style=filled fillcolor=lightcyan];
          n50 [label="return cls.marker()"];
          n51 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n52 [label="cls" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n53 {
          label="direct\n(function)";
          style=rounded;
          n53 [style=invis];
          n54 [label="self"];
          n55 [label="__class__.marker"];
          n56 [label="__class__.marker()" shape=box style=filled fillcolor=lightcyan];
          n57 [label="return __class__.marker()"];
          n58 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n59 {
          label="saved\n(function)";
          style=rounded;
          n59 [style=invis];
          n60 [label="self"];
          n61 [label="__class__.marker"];
          n62 [label="member"];
          n63 [label="member()" shape=box style=filled fillcolor=lightcyan];
          n64 [label="return member()"];
          n65 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n66 [label="member" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n67 {
          label="construct\n(function)";
          style=rounded;
          n67 [style=invis];
          n68 [label="self"];
          n69 [label="__class__()" shape=box style=filled fillcolor=lightcyan];
          n70 [label="return __class__()"];
          n71 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n72 {
          label="parameter_shadow\n(function)";
          style=rounded;
          n72 [style=invis];
          n73 [label="self"];
          n74 [label="__class__"];
          n75 [label="return __class__"];
          n76 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n77 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n78 {
          label="enclosing_shadow\n(function)";
          style=rounded;
          n78 [style=invis];
          n79 [label="self"];
          n80 [label="value"];
          n81 [label="__class__"];
          n82 [label="read()" shape=box style=filled fillcolor=lightcyan];
          n83 [label="return read()"];
          n84 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n85 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
          n86 [label="__class__" shape=box style="rounded,filled" fillcolor=lightyellow];
          n87 [label="read" shape=box style="rounded,filled" fillcolor=lightyellow];

          subgraph cluster_n88 {
            label="read\n(function)";
            style=rounded;
            n88 [style=invis];
            n89 [label="return __class__"];
          }

        }


        subgraph cluster_n90 {
          label="global_shadow\n(function)";
          style=rounded;
          n90 [style=invis];
          n91 [label="self"];
          n92 [label="return __class__"];
          n93 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n94 {
        label="Uncertain\n(class)";
        style=rounded;
        n94 [style=invis];
        n95 [label="read" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n96 {
          label="read\n(function)";
          style=rounded;
          n96 [style=invis];
          n97 [label="self"];
          n98 [label="return __class__"];
          n99 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n100 {
        label="main\n(function)";
        style=rounded;
        n100 [style=invis];
        n101 [label="Original()" shape=box style=filled fillcolor=lightcyan];
        n102 [label="Uncertain()" shape=box style=filled fillcolor=lightcyan];
        n103 [label="(Original(), Uncertain())" shape=box];
        n104 [label="return (Original(), Uncertain())"];
      }

    }


    subgraph cluster_n105 {
      label="builtins\n(builtins)";
      style=rounded;
      n105 [style=invis];
      n106 [label="staticmethod"];
      n107 [label="staticmethod" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n100 -> n12 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n100];
  n101 -> n103 [color=steelblue];
  n102 -> n103 [color=steelblue];
  n103 -> n104 [color=steelblue];
