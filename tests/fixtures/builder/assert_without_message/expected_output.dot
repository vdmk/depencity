digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="guarded_result" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="caught_assertion" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="suppressed_assertion" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="main\n(function)";
        style=rounded;
        n6 [style=invis];
        n7 [label="value"];
        n8 [label="value" shape=diamond];
        n9 [label="assert value" shape=box];
        n10 [label="return value"];
        n11 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n12 {
        label="guarded_result\n(function)";
        style=rounded;
        n12 [style=invis];
        n13 [label="flag"];
        n14 [label="value"];
        n15 [label="consume"];
        n16 [label="flag" shape=diamond];
        n17 [label="assert flag" shape=box];
        n18 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n19 [label="result"];
        n20 [label="return result"];
        n21 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n22 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n23 [label="consume" shape=box style="rounded,filled" fillcolor=lightyellow];
        n24 [label="result" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n25 {
        label="caught_assertion\n(function)";
        style=rounded;
        n25 [style=invis];
        n26 [label="flag"];
        n27 [label="value"];
        n28 [label="flag" shape=diamond];
        n29 [label="assert flag" shape=box];
        n30 [label="exception" shape=diamond];
        n31 [label="AssertionError" shape=diamond];
        n32 [label="return value"];
        n33 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n34 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n35 {
        label="suppressed_assertion\n(function)";
        style=rounded;
        n35 [style=invis];
        n36 [label="manager"];
        n37 [label="flag"];
        n38 [label="value"];
        n39 [label="__with_9__"];
        n40 [label="flag" shape=diamond];
        n41 [label="assert flag" shape=box];
        n42 [label="return value"];
        n43 [label="manager" shape=box style="rounded,filled" fillcolor=lightyellow];
        n44 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n45 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n46 {
      label="builtins\n(builtins)";
      style=rounded;
      n46 [style=invis];
      n47 [label="AssertionError"];
      n48 [label="AssertionError" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n11 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n12 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n12];
  n13 -> n16 [color=steelblue];
  n14 -> n18 [color=steelblue];
  n15 -> n18 [color=steelblue];
  n16 -> n17 [color=steelblue];
  n16 -> n18 [color=steelblue];
  n16 -> n19 [color=steelblue];
  n16 -> n20 [color=steelblue];
  n18 -> n19 [color=steelblue];
  n19 -> n20 [color=steelblue];
  n21 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n22 -> n14 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n23 -> n15 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n24 -> n19 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n25 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n25];
  n26 -> n28 [color=steelblue];
  n27 -> n32 [color=steelblue];
  n28 -> n29 [color=steelblue];
  n29 -> n30 [color=steelblue];
  n30 -> n31 [color=steelblue];
  n33 -> n26 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n34 -> n27 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n35 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n35];
  n36 -> n39 [color=steelblue];
  n37 -> n40 [color=steelblue];
  n38 -> n42 [color=steelblue];
  n40 -> n41 [color=steelblue];
  n43 -> n36 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n44 -> n37 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n45 -> n38 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n47 -> n31 [color=steelblue];
  n48 -> n47 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n6 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n6];
  n7 -> n10 [color=steelblue];
  n7 -> n8 [color=steelblue];
  n8 -> n10 [color=steelblue];
  n8 -> n9 [color=steelblue];
}