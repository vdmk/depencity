digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n4 [label="make_base()" shape=box style=filled fillcolor=lightcyan];
      n6 [label="make_base()" shape=box style=filled fillcolor=lightcyan];
      n8 [label="*extra_bases" shape=box];
      n10 [label="make_base()" shape=box style=filled fillcolor=lightcyan];
      n12 [label="make_base"];
      n13 [label="extra_bases"];
      n14 [label="Combined" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="Shadowed" shape=box style="rounded,filled" fillcolor=lightyellow];
