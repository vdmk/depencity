digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="builtins"];

    subgraph cluster_n2 {
      label="__module__\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="identity" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="alternate" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="Worker" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="installed_method" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="Installed" shape=box style="rounded,filled" fillcolor=lightyellow];
