digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="captured"];
      n3 [label="captured" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="capture_global" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="capture_nonlocal" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="capture_local" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="completed_guard" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="conditional_guard" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n10 {
        label="main\n(function)";
        style=rounded;
        n10 [style=invis];
        n11 [label="subject"];
        n12 [label="old"];
        n13 [label="replacement"];
        n14 [label="value v1"];
        n15 [label="__cond_0__" shape=diamond];
        n16 [label="value v2"];
        n17 [label="__cond_1__" shape=diamond];
        n18 [label="case failure" shape=diamond];
        n19 [label="__cond_3__" shape=diamond];
        n20 [label="number"];
        n21 [label="value + number" shape=box];
        n22 [label="value v3"];
        n23 [label="__cond_5__" shape=diamond];
        n24 [label="case failure" shape=diamond];
        n25 [label="__cond_7__" shape=diamond];
        n26 [label="return value"];
        n27 [label="subject" shape=box style="rounded,filled" fillcolor=lightyellow];
        n28 [label="old" shape=box style="rounded,filled" fillcolor=lightyellow];
        n29 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n30 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n31 [label="number" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n32 {
        label="capture_global\n(function)";
        style=rounded;
        n32 [style=invis];
        n33 [label="subject"];
        n34 [label="__cond_8__" shape=diamond];
        n35 [label="captured"];
        n36 [label="return captured"];
        n37 [label="return None (implicit)"];
        n38 [label="subject" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n39 {
        label="capture_nonlocal\n(function)";
        style=rounded;
        n39 [style=invis];
        n40 [label="subject"];
        n41 [label="original"];
        n42 [label="captured"];
        n43 [label="capture()" shape=box style=filled fillcolor=lightcyan];
        n44 [label="return capture()"];
        n45 [label="subject" shape=box style="rounded,filled" fillcolor=lightyellow];
        n46 [label="original" shape=box style="rounded,filled" fillcolor=lightyellow];
        n47 [label="captured" shape=box style="rounded,filled" fillcolor=lightyellow];
        n48 [label="capture" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n49 {
          label="capture\n(function)";
          style=rounded;
          n49 [style=invis];
          n50 [label="__cond_9__" shape=diamond];
          n51 [label="captured"];
          n52 [label="return captured"];
          n53 [label="return None (implicit)"];
        }

      }


      subgraph cluster_n54 {
        label="capture_local\n(function)";
        style=rounded;
        n54 [style=invis];
        n55 [label="subject"];
        n56 [label="__cond_11__" shape=diamond];
        n57 [label="captured"];
        n58 [label="return captured"];
        n59 [label="return None (implicit)"];
        n60 [label="subject" shape=box style="rounded,filled" fillcolor=lightyellow];
        n61 [label="captured" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n62 {
        label="completed_guard\n(function)";
        style=rounded;
        n62 [style=invis];
        n63 [label="subject"];
        n64 [label="old"];
        n65 [label="replacement"];
        n66 [label="value v1"];
        n67 [label="__cond_12__" shape=diamond];
        n68 [label="value v2"];
        n69 [label="__cond_13__" shape=diamond];
        n70 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n71 [label="case failure" shape=diamond];
        n72 [label="__cond_16__" shape=diamond];
        n73 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n74 [label="return value"];
        n75 [label="consume"];
        n76 [label="subject" shape=box style="rounded,filled" fillcolor=lightyellow];
        n77 [label="old" shape=box style="rounded,filled" fillcolor=lightyellow];
        n78 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n79 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n80 {
        label="conditional_guard\n(function)";
        style=rounded;
        n80 [style=invis];
        n81 [label="subject"];
        n82 [label="flag"];
        n83 [label="old"];
        n84 [label="replacement"];
        n85 [label="value v1"];
        n86 [label="__cond_18__" shape=diamond];
        n87 [label="flag?" shape=diamond];
        n88 [label="value v2"];
        n89 [label="flag or (value := replacement)" shape=box];
        n90 [label="__cond_21__" shape=diamond];
        n91 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n92 [label="return value"];
        n93 [label="consume"];
        n94 [label="subject" shape=box style="rounded,filled" fillcolor=lightyellow];
        n95 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
        n96 [label="old" shape=box style="rounded,filled" fillcolor=lightyellow];
        n97 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
        n98 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n99 {
      label="builtins\n(builtins)";
      style=rounded;
      n99 [style=invis];
      n100 [label="int"];
      n101 [label="int" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n10 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n10];
  n100 -> n19 [color=steelblue];
  n101 -> n100 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
