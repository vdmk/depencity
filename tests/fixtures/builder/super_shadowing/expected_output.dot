          n111 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n112 {
          label="conditional_import\n(function)";
          style=rounded;
          n112 [style=invis];
          n113 [label="self"];
          n114 [label="flag"];
          n115 [label="replacement"];
          n116 [label="native_super"];
          n117 [label="super v1"];
          n118 [label="flag?" shape=diamond];
          n119 [label="super v2"];
          n120 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n121 [label="super().method"];
          n122 [label="super().method()" shape=box style=filled fillcolor=lightcyan];
          n123 [label="((super := native_super), super().method())" shape=box];
          n124 [label="flag and ((super := native_super), super().method())" shape=box];
          n125 [label="return flag and ((super := native_super), super().method())"];
          n126 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n127 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
          n128 [label="replacement" shape=box style="rounded,filled" fillcolor=lightyellow];
          n129 [label="native_super" shape=box style="rounded,filled" fillcolor=lightyellow];
          n130 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }


    subgraph cluster_n131 {
      label="builtins\n(builtins)";
      style=rounded;
      n131 [style=invis];
      n132 [label="super"];
      n133 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

