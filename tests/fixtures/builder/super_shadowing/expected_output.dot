          style=rounded;
          n54 [style=invis];
          n55 [label="self"];
          n56 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n57 [label="super().method"];
          n58 [label="super().method()" shape=box style=filled fillcolor=lightcyan];
          n59 [label="return super().method()"];
          n60 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n61 {
        label="factory\n(function)";
        style=rounded;
        n61 [style=invis];
        n62 [label="callback"];
        n63 [label="super"];
        n65 [label="Nested()" shape=box style=filled fillcolor=lightcyan];
        n66 [label="return Nested()"];
        n67 [label="callback" shape=box style="rounded,filled" fillcolor=lightyellow];
        n68 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
        n69 [label="Nested" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n70 {
