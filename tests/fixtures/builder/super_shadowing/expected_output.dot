            n75 [label="super().method"];
            n76 [label="super().method()" shape=box style=filled fillcolor=lightcyan];
            n77 [label="return super().method()"];
            n78 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          }

        }

      }


      subgraph cluster_n79 {
        label="main\n(function)";
        style=rounded;
        n79 [style=invis];
        n80 [label="Child()" shape=box style=filled fillcolor=lightcyan];
        n81 [label="return Child()"];
      }


      subgraph cluster_n82 {
        label="read_custom_super_member\n(function)";
        style=rounded;
        n82 [style=invis];
        n83 [label="super"];
        n84 [label="super()" shape=box style=filled fillcolor=lightcyan];
        n85 [label="super().run"];
        n86 [label="return super().run"];
        n87 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n88 {
        label="ImportedSuperChild\n(class)";
        style=rounded;
        n88 [style=invis];
        n89 [label="direct_import" shape=box style="rounded,filled" fillcolor=lightyellow];
        n90 [label="aliased_import" shape=box style="rounded,filled" fillcolor=lightyellow];
        n91 [label="conditional_import" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n92 {
          label="direct_import\n(function)";
          style=rounded;
          n92 [style=invis];
          n93 [label="self"];
          n94 [label="super"];
