digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="unknown.super"];
    n2 [label="builtins.super"];

    subgraph cluster_n3 {
      label="__module__\n(module)";
      style=rounded;
      n3 [style=invis];
      n5 [label="super"];
      n7 [label="callback"];
      n8 [label="Child" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="ImportedSuperChild" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="Parent" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="factory" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="read_custom_super_member" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n15 {
        label="Parent\n(class)";
        style=rounded;
        n15 [style=invis];
        n16 [label="method" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n17 {
          label="method\n(function)";
          style=rounded;
          n17 [style=invis];
          n18 [label="self"];
          n19 [label="return 1"];
          n20 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n21 {
        label="Child\n(class)";
        style=rounded;
        n21 [style=invis];
        n22 [label="parameter" shape=box style="rounded,filled" fillcolor=lightyellow];
        n23 [label="local" shape=box style="rounded,filled" fillcolor=lightyellow];
        n24 [label="imported" shape=box style="rounded,filled" fillcolor=lightyellow];
        n25 [label="module_shadow" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n26 {
          label="parameter\n(function)";
          style=rounded;
          n26 [style=invis];
          n27 [label="self"];
          n28 [label="super"];
          n29 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n30 [label="super().method"];
          n31 [label="super().method()" shape=box style=filled fillcolor=lightcyan];
          n32 [label="return super().method()"];
          n33 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n34 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n35 {
          label="local\n(function)";
          style=rounded;
          n35 [style=invis];
          n36 [label="self"];
          n37 [label="super"];
          n38 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n39 [label="super().method"];
          n40 [label="super().method()" shape=box style=filled fillcolor=lightcyan];
          n41 [label="return super().method()"];
          n42 [label="callback"];
          n43 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n44 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n45 {
          label="imported\n(function)";
          style=rounded;
          n45 [style=invis];
          n46 [label="self"];
          n47 [label="super"];
          n48 [label="super()" shape=box style=filled fillcolor=lightcyan];
          n49 [label="super().method"];
          n50 [label="super().method()" shape=box style=filled fillcolor=lightcyan];
          n51 [label="return super().method()"];
          n52 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n53 [label="super" shape=box style="rounded,filled" fillcolor=lightyellow];
