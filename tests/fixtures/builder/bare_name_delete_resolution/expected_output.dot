digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="before_read"];
      n3 [label="helper()" shape=box style=filled fillcolor=lightcyan];
      n4 [label="before_delete"];
      n5 [label="del helper" shape=box];
      n6 [label="after_read"];
      n7 [label="helper()" shape=box style=filled fillcolor=lightcyan];
      n8 [label="after_delete"];
      n9 [label="after_rebind_read"];
      n10 [label="helper()" shape=box style=filled fillcolor=lightcyan];
      n11 [label="after_rebind"];
      n12 [label="if flag" shape=diamond];
      n13 [label="del optional" shape=box];
      n14 [label="optional()" shape=box style=filled fillcolor=lightcyan];
      n15 [label="after_conditional_delete"];
      n16 [label="del Worker" shape=box];
      n17 [label="flag"];
      n18 [label="helper"];
      n19 [label="helper" shape=box style="rounded,filled" fillcolor=lightyellow];
      n20 [label="before_read" shape=box style="rounded,filled" fillcolor=lightyellow];
      n21 [label="before_delete" shape=box style="rounded,filled" fillcolor=lightyellow];
      n22 [label="after_read" shape=box style="rounded,filled" fillcolor=lightyellow];
      n23 [label="after_delete" shape=box style="rounded,filled" fillcolor=lightyellow];
      n24 [label="after_rebind_read" shape=box style="rounded,filled" fillcolor=lightyellow];
      n25 [label="after_rebind" shape=box style="rounded,filled" fillcolor=lightyellow];
      n26 [label="optional" shape=box style="rounded,filled" fillcolor=lightyellow];
      n27 [label="after_conditional_delete" shape=box style="rounded,filled" fillcolor=lightyellow];
      n28 [label="Worker" shape=box style="rounded,filled" fillcolor=lightyellow];
      n29 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n30 [label="deleted_class_hint" shape=box style="rounded,filled" fillcolor=lightyellow];
      n31 [label="interrupted_delete" shape=box style="rounded,filled" fillcolor=lightyellow];
      n32 [label="suppressed_delete" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n33 {
        label="helper\n(function)";
        style=rounded;
        n33 [style=invis];
        n34 [label="return 1"];
      }


      subgraph cluster_n35 {
        label="helper\n(function)";
        style=rounded;
        n35 [style=invis];
        n36 [label="return 2"];
      }


      subgraph cluster_n37 {
        label="optional\n(function)";
        style=rounded;
        n37 [style=invis];
        n38 [label="return 3"];
      }


      subgraph cluster_n39 {
        label="main\n(function)";
        style=rounded;
        n39 [style=invis];
        n40 [label="return after_delete"];
      }


      subgraph cluster_n41 {
        label="Worker\n(class)";
        style=rounded;
        n41 [style=invis];
        n42 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n43 {
          label="run\n(function)";
          style=rounded;
          n43 [style=invis];
          n44 [label="self"];
          n45 [label="return class_source"];
          n46 [label="class_source"];
          n47 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n48 {
        label="deleted_class_hint\n(function)";
        style=rounded;
        n48 [style=invis];
        n49 [label="value"];
        n50 [label="value.run"];
        n51 [label="value.run()" shape=box style=filled fillcolor=lightcyan];
        n52 [label="return value.run()"];
        n53 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n54 {
        label="interrupted_delete\n(function)";
        style=rounded;
        n54 [style=invis];
        n55 [label="value v1"];
        n56 [label="risky()" shape=box style=filled fillcolor=lightcyan];
        n57 [label="del value" shape=box];
        n58 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n59 [label="inside"];
        n60 [label="exception" shape=diamond];
        n61 [label="Error" shape=diamond];
        n62 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n63 [label="recovered"];
        n64 [label="return value"];
        n65 [label="risky"];
        n66 [label="consume"];
        n67 [label="Error"];
        n68 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n69 [label="inside" shape=box style="rounded,filled" fillcolor=lightyellow];
        n70 [label="recovered" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n71 {
        label="suppressed_delete\n(function)";
        style=rounded;
        n71 [style=invis];
        n72 [label="value v1"];
        n73 [label="manager"];
        n74 [label="__with_16__"];
        n75 [label="risky()" shape=box style=filled fillcolor=lightcyan];
        n76 [label="del value" shape=box];
        n77 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n78 [label="inside"];
        n79 [label="return value"];
        n80 [label="risky"];
        n81 [label="consume"];
        n82 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n83 [label="manager" shape=box style="rounded,filled" fillcolor=lightyellow];
        n84 [label="inside" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

