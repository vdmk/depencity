digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="missing" shape=box style="rounded,filled" fillcolor=lightyellow];
      n4 [label="nested_delete" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="conditional_rebind" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="nested_handlers" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="nested_handler_read_after_inner" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="star_handler" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n9 {
        label="main\n(function)";
        style=rounded;
        n9 [style=invis];
        n10 [label="error v1"];
        n11 [label="action()" shape=box style=filled fillcolor=lightcyan];
        n12 [label="exception" shape=diamond];
        n13 [label="Exception" shape=diamond];
        n14 [label="error v2"];
        n15 [label="consume()" shape=box style=filled fillcolor=lightcyan];
        n16 [label="return error"];
        n17 [label="old"];
        n18 [label="action"];
        n19 [label="consume"];
        n20 [label="error" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


