        n40 [label="if b" shape=diamond];
        n41 [label="del x" shape=box];
        n42 [label="return x"];
        n43 [label="a" shape=box style="rounded,filled" fillcolor=lightyellow];
        n44 [label="b" shape=box style="rounded,filled" fillcolor=lightyellow];
        n45 [label="old" shape=box style="rounded,filled" fillcolor=lightyellow];
        n46 [label="new" shape=box style="rounded,filled" fillcolor=lightyellow];
        n47 [label="x" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n48 {
