digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="__external.child"];
    n2 [label="__external.child.value"];

    subgraph cluster_n3 {
      label="__module__\n(module)";
      style=rounded;
      n3 [style=invis];
      n4 [label="__token"];
      n6 [label="module_payload"];
      n7 [label="__token" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="Child" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="__module_function" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="Base" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="___" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="Imported" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="FromImported" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="PatternReader" shape=box style="rounded,filled" fillcolor=lightyellow];
      n16 [label="Bounded" shape=box style="rounded,filled" fillcolor=lightyellow];
      n17 [label="Defaulted" shape=box style="rounded,filled" fillcolor=lightyellow];
      n18 [label="KeywordLabels" shape=box style="rounded,filled" fillcolor=lightyellow];
      n19 [label="PrivateNames" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n20 {
        label="__module_function\n(function)";
        style=rounded;
        n20 [style=invis];
        n21 [label="return __token"];
      }


      subgraph cluster_n22 {
        label="Base\n(class)";
        style=rounded;
        n22 [style=invis];
        n23 [label="__len__" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n24 {
          label="__len__\n(function)";
          style=rounded;
          n24 [style=invis];
          n25 [label="self"];
          n26 [label="return dunder_payload"];
          n27 [label="dunder_payload"];
          n28 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n29 {
        label="Child\n(class)";
        style=rounded;
        n29 [style=invis];
        n30 [label="read_class" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n31 {
          label="read_class\n(function)";
          style=rounded;
          n31 [style=invis];
          n32 [label="self"];
          n33 [label="return __class__"];
          n34 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n35 {
        label="___\n(class)";
        style=rounded;
        n35 [style=invis];
        n36 [label="value"];
        n37 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n38 [label="__run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n39 {
          label="__run\n(function)";
          style=rounded;
          n39 [style=invis];
          n40 [label="self"];
          n41 [label="return unmangled_payload"];
          n42 [label="unmangled_payload"];
          n43 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n44 {
        label="main\n(function)";
        style=rounded;
        n44 [style=invis];
        n45 [label="Child()" shape=box style=filled fillcolor=lightcyan];
        n46 [label="obj"];
        n47 [label="___()" shape=box style=filled fillcolor=lightcyan];
        n48 [label="ordinary"];
        n49 [label="obj.__len__"];
        n50 [label="obj.__len__()" shape=box style=filled fillcolor=lightcyan];
        n51 [label="ordinary.__run"];
        n52 [label="ordinary.__run()" shape=box style=filled fillcolor=lightcyan];
        n53 [label="__module_function()" shape=box style=filled fillcolor=lightcyan];
        n54 [label="(obj.__len__(), ordinary.__run(), __module_function())" shape=box];
        n55 [label="return (obj.__len__(), ordinary.__run(), __module_function())"];
        n56 [label="obj" shape=box style="rounded,filled" fillcolor=lightyellow];
        n57 [label="ordinary" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n58 {
        label="Imported\n(class)";
        style=rounded;
        n58 [style=invis];
        n59 [label="public_module"];
        n60 [label="value"];
        n61 [label="public_module" shape=box style="rounded,filled" fillcolor=lightyellow];
        n62 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
