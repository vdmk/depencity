          n72 [label="subject"];
          n73 [label="__cond_8__" shape=diamond];
          n74 [label="value"];
          n75 [label="return value"];
          n76 [label="return None (implicit)"];
          n77 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n78 [label="subject" shape=box style="rounded,filled" fillcolor=lightyellow];
          n79 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
