digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];

    subgraph cluster_n1 {
      label="__module__\n(module)";
      style=rounded;
      n1 [style=invis];
      n2 [label="Outer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n3 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n4 {
        label="Outer\n(class)";
        style=rounded;
        n4 [style=invis];
        n5 [label="Inner" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n6 {
          label="Inner\n(class)";
          style=rounded;
          n6 [style=invis];
        }

      }


      subgraph cluster_n7 {
        label="main\n(function)";
        style=rounded;
        n7 [style=invis];
        n8 [label="value"];
        n9 [label="value.Inner"];
        n10 [label="value.Inner.missing"];
        n11 [label="value.Inner.missing()" shape=box style=filled fillcolor=lightcyan];
        n12 [label="return value.Inner.missing()"];
        n13 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n10 -> n11 [color=steelblue];
  n11 -> n12 [color=steelblue];
  n13 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n4 -> n2 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n4];
  n6 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n6];
  n6 -> n9 [color=steelblue, ltail=cluster_n6];
  n7 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n7];
  n8 -> n9 [color=steelblue];
  n9 -> n10 [color=steelblue];
}