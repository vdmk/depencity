      n7 [label="annotated_owner" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="annotated_class" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="constructed_owner" shape=box style="rounded,filled" fillcolor=lightyellow];

