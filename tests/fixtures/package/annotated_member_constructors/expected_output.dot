    }


    subgraph cluster_n41 {
      label="annotated_member_constructors.models\n(module)";
      style=rounded;
      n41 [style=invis];
      n42 [label="Product" shape=box style="rounded,filled" fillcolor=lightyellow];
      n43 [label="Container" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n44 {
        label="Product\n(class)";
        style=rounded;
        n44 [style=invis];
        n45 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
        n46 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n47 {
          label="__init__\n(function)";
          style=rounded;
          n47 [style=invis];
          n48 [label="self"];
