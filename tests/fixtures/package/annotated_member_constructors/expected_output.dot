        n30 [style=invis];
        n31 [label="Container()" shape=box style=filled fillcolor=lightcyan];
        n32 [label="owner"];
        n33 [label="owner.Factory"];
        n34 [label="owner.Factory()" shape=box style=filled fillcolor=lightcyan];
        n35 [label="result"];
        n36 [label="result.run"];
