digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="coverage_external_base.worker.Worker"];
    n2 [label="builtins.list"];

    subgraph cluster_n3 {
      label="coverage_external_base.entry\n(module)";
      style=rounded;
      n3 [style=invis];
      n4 [label="ImportedWorker"];
      n5 [label="ImportedWorker" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n7 {
        label="main\n(function)";
        style=rounded;
        n7 [style=invis];
        n8 [label="value"];
        n9 [label="ImportedWorker()" shape=box style=filled fillcolor=lightcyan];
        n10 [label="return ImportedWorker(value)"];
        n11 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n12 {
      label="coverage_external_base.worker\n(module)";
      style=rounded;
      n12 [style=invis];
      n13 [label="ExternalBase"];
      n15 [label="ExternalBase" shape=box style="rounded,filled" fillcolor=lightyellow];
      n16 [label="Worker" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n17 {
        label="Worker\n(class)";
        style=rounded;
        n17 [style=invis];
      }

    }


    subgraph cluster_n18 {
      label="builtins\n(builtins)";
      style=rounded;
      n18 [style=invis];
      n19 [label="list"];
      n20 [label="list" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n1 -> n4 [color=steelblue];
  n11 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n13 -> n17 [color=steelblue];
  n15 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n16 -> n17 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n17 -> n1 [color=steelblue, ltail=cluster_n17];
  n17 -> n16 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n17];
  n19 -> n2 [color=steelblue];
  n2 -> n13 [color=steelblue];
  n20 -> n19 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n4 -> n9 [color=steelblue];
  n5 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n7 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n7];
  n8 -> n9 [color=steelblue];
  n9 -> n10 [color=steelblue];
}