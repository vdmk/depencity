digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="relative_imports.worker.transform"];
    n2 [label=".relative_imports.transform"];
    n3 [label=".transform"];

    subgraph cluster_n4 {
      label="relative_imports\n(module)";
      style=rounded;
      n4 [style=invis];
      n5 [label="transform"];
      n6 [label="transform" shape=box style="rounded,filled" fillcolor=lightyellow];
    }


    subgraph cluster_n7 {
      label="relative_imports.nested.entry\n(module)";
      style=rounded;
      n7 [style=invis];
      n8 [label="transform"];
      n9 [label="transform" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="beyond_package" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n12 {
        label="main\n(function)";
        style=rounded;
        n12 [style=invis];
        n13 [label="value"];
        n14 [label="transform()" shape=box style=filled fillcolor=lightcyan];
        n15 [label="return transform(value)"];
        n16 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n17 {
        label="beyond_package\n(function)";
        style=rounded;
        n17 [style=invis];
        n18 [label="value"];
        n19 [label="transform"];
        n20 [label="transform()" shape=box style=filled fillcolor=lightcyan];
        n21 [label="return transform(value)"];
        n22 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n23 [label="transform" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n24 {
      label="relative_imports.worker\n(module)";
      style=rounded;
      n24 [style=invis];
      n25 [label="transform" shape=box style="rounded,filled" fillcolor=lightyellow];
      n26 [label="_beyond_package" shape=box style="rounded,filled" fillcolor=lightyellow];
      n27 [label="_beyond_package_symbol" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n28 {
        label="transform\n(function)";
        style=rounded;
        n28 [style=invis];
        n29 [label="value"];
        n30 [label="value + 1" shape=box];
        n31 [label="return value + 1"];
        n32 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n33 {
        label="_beyond_package\n(function)";
        style=rounded;
        n33 [style=invis];
        n34 [label="value"];
        n35 [label="transform"];
        n36 [label="transform()" shape=box style=filled fillcolor=lightcyan];
        n37 [label="return transform(value)"];
        n38 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n39 [label="transform" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n40 {
        label="_beyond_package_symbol\n(function)";
        style=rounded;
        n40 [style=invis];
        n41 [label="value"];
        n42 [label="transform"];
        n43 [label="transform()" shape=box style=filled fillcolor=lightcyan];
        n44 [label="return transform(value)"];
        n45 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n46 [label="transform" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n1 -> n5 [color=steelblue];
  n1 -> n8 [color=steelblue];
  n12 -> n10 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n12];
  n13 -> n14 [color=steelblue];
  n14 -> n15 [color=steelblue];
  n16 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n17 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n17];
  n18 -> n20 [color=steelblue];
  n19 -> n20 [color=steelblue];
  n2 -> n19 [color=steelblue];
  n2 -> n35 [color=steelblue];
  n20 -> n21 [color=steelblue];
  n22 -> n18 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n23 -> n19 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n28 -> n1 [color=steelblue, ltail=cluster_n28];
  n28 -> n25 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n28];
  n29 -> n30 [color=steelblue];
  n3 -> n42 [color=steelblue];
  n30 -> n31 [color=steelblue];
  n31 -> n14 [color=steelblue];
  n32 -> n29 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n33 -> n26 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n33];
  n34 -> n36 [color=steelblue];
  n35 -> n36 [color=steelblue];
  n36 -> n37 [color=steelblue];
  n38 -> n34 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n39 -> n35 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n40 -> n27 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n40];
  n41 -> n43 [color=steelblue];
  n42 -> n43 [color=steelblue];
  n43 -> n44 [color=steelblue];
  n45 -> n41 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n46 -> n42 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n6 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
