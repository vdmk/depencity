digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="nested_attribute_walk.tree.branch.leaf.submodule"];
    n2 [label="nested_attribute_walk.tree.branch.leaf.submodule.deep.run"];

    subgraph cluster_n3 {
      label="nested_attribute_walk.entry\n(module)";
      style=rounded;
      n3 [style=invis];
      n4 [label="submodule"];
      n5 [label="submodule" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n7 {
        label="main\n(function)";
        style=rounded;
        n7 [style=invis];
        n8 [label="submodule.deep"];
        n9 [label="submodule.deep.run"];
        n10 [label="submodule.deep.run()" shape=box style=filled fillcolor=lightcyan];
        n11 [label="return submodule.deep.run()"];
      }

    }


    subgraph cluster_n12 {
      label="nested_attribute_walk.tree.branch.leaf.submodule.deep\n(module)";
      style=rounded;
      n12 [style=invis];
      n13 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n14 {
        label="run\n(function)";
        style=rounded;
        n14 [style=invis];
        n15 [label="return 1"];
      }

    }

  }

  n1 -> n4 [color=steelblue];
  n10 -> n11 [color=steelblue];
  n14 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n14];
  n14 -> n2 [color=steelblue, ltail=cluster_n14];
  n15 -> n10 [color=steelblue];
  n2 -> n10 [color=steelblue];
  n4 -> n8 [color=steelblue];
  n5 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n7 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n7];
  n8 -> n9 [color=steelblue];
  n9 -> n10 [color=steelblue];
}