digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="qualified_base_initializers"];
    n2 [label="qualified_base_initializers.base.Base"];

    subgraph cluster_n3 {
      label="qualified_base_initializers\n(module)";
      style=rounded;
      n3 [style=invis];
    }


    subgraph cluster_n4 {
      label="qualified_base_initializers.base\n(module)";
      style=rounded;
      n4 [style=invis];
      n5 [label="Base" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="Base\n(class)";
        style=rounded;
        n6 [style=invis];
        n7 [label="T"];
        n8 [label="T" shape=box style="rounded,filled" fillcolor=lightyellow];
        n9 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n10 {
          label="__init__\n(function)";
          style=rounded;
          n10 [style=invis];
          n11 [label="self"];
          n12 [label="value"];
          n13 [label="self.value"];
          n14 [label="return None (implicit)"];
          n15 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n16 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }


    subgraph cluster_n17 {
      label="qualified_base_initializers.entry\n(module)";
      style=rounded;
      n17 [style=invis];
      n18 [label="package"];
      n19 [label="package.base"];
      n20 [label="package.base.Base"];
      n22 [label="package.base"];
      n23 [label="package.base.Base"];
      n24 [label="package.base.Base[int]"];
      n26 [label="package.base"];
      n27 [label="package.base.Base"];
      n29 [label="package" shape=box style="rounded,filled" fillcolor=lightyellow];
      n30 [label="Plain" shape=box style="rounded,filled" fillcolor=lightyellow];
      n31 [label="Parameterized" shape=box style="rounded,filled" fillcolor=lightyellow];
      n32 [label="Multiple" shape=box style="rounded,filled" fillcolor=lightyellow];
      n33 [label="OptionalInitializer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n34 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n35 {
        label="Plain\n(class)";
        style=rounded;
        n35 [style=invis];
      }


      subgraph cluster_n36 {
        label="Parameterized\n(class)";
        style=rounded;
        n36 [style=invis];
      }


      subgraph cluster_n37 {
        label="OptionalInitializer\n(class)";
        style=rounded;
        n37 [style=invis];
        n38 [label="if enabled" shape=diamond];
        n39 [label="__init__"];
        n40 [label="enabled"];
        n41 [label="unknown_initializer"];
        n42 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n43 {
        label="Multiple\n(class)";
        style=rounded;
        n43 [style=invis];
      }


      subgraph cluster_n44 {
        label="main\n(function)";
        style=rounded;
        n44 [style=invis];
        n45 [label="value"];
        n46 [label="Plain()" shape=box style=filled fillcolor=lightcyan];
        n47 [label="Parameterized()" shape=box style=filled fillcolor=lightcyan];
        n48 [label="Multiple()" shape=box style=filled fillcolor=lightcyan];
        n49 [label="(Plain(value), Parameterized(value), Multiple(value))" shape=box];
        n50 [label="return (Plain(value), Parameterized(value), Multiple(value))"];
        n51 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n52 {
      label="builtins\n(builtins)";
      style=rounded;
      n52 [style=invis];
      n53 [label="int"];
      n54 [label="int" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n1 -> n18 [color=steelblue];
  n10 -> n9 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n10];
  n11 -> n13 [color=steelblue];
  n12 -> n13 [color=steelblue];
  n14 -> n46 [color=steelblue];
  n14 -> n47 [color=steelblue];
  n15 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n16 -> n12 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n18 -> n19 [color=steelblue];
  n18 -> n22 [color=steelblue];
  n18 -> n26 [color=steelblue];
  n19 -> n20 [color=steelblue];
  n2 -> n20 [color=steelblue];
  n2 -> n23 [color=steelblue];
  n2 -> n27 [color=steelblue];
  n20 -> n35 [color=steelblue];
  n22 -> n23 [color=steelblue];
  n23 -> n24 [color=steelblue];
  n24 -> n36 [color=steelblue];
  n26 -> n27 [color=steelblue];
  n27 -> n43 [color=steelblue];
  n29 -> n18 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n3 -> n1 [color=steelblue, ltail=cluster_n3];
  n30 -> n35 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n31 -> n36 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n32 -> n43 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n35 -> n30 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n35];
  n35 -> n46 [color=steelblue, ltail=cluster_n35];
  n36 -> n31 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n36];
  n36 -> n47 [color=steelblue, ltail=cluster_n36];
  n37 -> n33 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n37];
  n37 -> n43 [color=steelblue, ltail=cluster_n37];
  n38 -> n39 [color=steelblue];
  n39 -> n48 [color=steelblue];
  n40 -> n38 [color=steelblue];
  n41 -> n39 [color=steelblue];
  n42 -> n39 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n43 -> n32 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n43];
  n43 -> n48 [color=steelblue, ltail=cluster_n43];
  n44 -> n34 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n44];
  n45 -> n46 [color=steelblue];
  n45 -> n47 [color=steelblue];
  n45 -> n48 [color=steelblue];
  n46 -> n49 [color=steelblue];
  n47 -> n49 [color=steelblue];
  n48 -> n49 [color=steelblue];
  n49 -> n50 [color=steelblue];
  n51 -> n45 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n53 -> n24 [color=steelblue];
  n54 -> n53 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n6 -> n2 [color=steelblue, ltail=cluster_n6];
  n6 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n6];
  n8 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
}