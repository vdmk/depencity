digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="coverage_submodule_fallback.parent.child"];

    subgraph cluster_n2 {
      label="coverage_submodule_fallback.entry\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="child_module"];
      n4 [label="child_module" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="main\n(function)";
        style=rounded;
        n6 [style=invis];
        n7 [label="value"];
        n8 [label="child_module.run"];
        n9 [label="child_module.run()" shape=box style=filled fillcolor=lightcyan];
        n10 [label="return child_module.run(value)"];
        n11 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n12 {
      label="coverage_submodule_fallback.parent\n(module)";
      style=rounded;
      n12 [style=invis];
      n13 [label="child v1"];
      n14 [label="del child" shape=box];
      n15 [label="child" shape=box style="rounded,filled" fillcolor=lightyellow];
    }


    subgraph cluster_n16 {
      label="coverage_submodule_fallback.parent.child\n(module)";
      style=rounded;
      n16 [style=invis];
      n17 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n18 {
        label="run\n(function)";
        style=rounded;
        n18 [style=invis];
        n19 [label="value"];
        n20 [label="return value"];
        n21 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n1 -> n13 [color=steelblue];
  n1 -> n3 [color=steelblue];
  n11 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n13 -> n14 [color=steelblue];
  n14 -> n8 [color=steelblue];
  n15 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n15 -> n14 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n16 -> n1 [color=steelblue, ltail=cluster_n16];
  n18 -> n17 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n18];
  n19 -> n20 [color=steelblue];
  n21 -> n19 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n3 -> n8 [color=steelblue];
  n4 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n6 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n6];
  n7 -> n9 [color=steelblue];
  n8 -> n9 [color=steelblue];
  n9 -> n10 [color=steelblue];
}