        n67 [style=invis];
        n68 [label="flag"];
        n69 [label="if flag" shape=diamond];
        n70 [label="return 1"];
        n71 [label="return 2"];
        n72 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n73 {
        label="generated\n(function)";
        style=rounded;
        n73 [style=invis];
        n74 [label="flag"];
        n75 [label="if flag" shape=diamond];
        n76 [label="yield 1"];
        n77 [label="yield (received)"];
        n78 [label="yield 2"];
        n79 [label="yield (received)"];
        n80 [label="return None (implicit)"];
        n81 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

