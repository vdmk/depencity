digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="external_call_target_population.worker.generated"];
    n2 [label="external_call_target_population.worker.helper"];
    n3 [label="external_call_target_population.worker.multiple"];
    n4 [label="unavailable_graph.shared"];

    subgraph cluster_n5 {
      label="external_call_target_population.entry\n(module)";
      style=rounded;
      n5 [style=invis];
      n6 [label="generated"];
      n7 [label="helper"];
      n8 [label="multiple"];
      n9 [label="external_alias"];
      n10 [label="second_external_alias"];
      n11 [label="generated" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="helper" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="multiple" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="external_alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="second_external_alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n16 [label="one_output" shape=box style="rounded,filled" fillcolor=lightyellow];
      n17 [label="multiple_outputs" shape=box style="rounded,filled" fillcolor=lightyellow];
      n18 [label="repeated_call" shape=box style="rounded,filled" fillcolor=lightyellow];
      n19 [label="alias_calls" shape=box style="rounded,filled" fillcolor=lightyellow];
      n20 [label="generator_outputs" shape=box style="rounded,filled" fillcolor=lightyellow];
      n21 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n22 {
        label="one_output\n(function)";
        style=rounded;
        n22 [style=invis];
        n23 [label="flag"];
        n24 [label="helper()" shape=box style=filled fillcolor=lightcyan];
        n25 [label="return helper(flag)"];
        n26 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n27 {
        label="multiple_outputs\n(function)";
        style=rounded;
        n27 [style=invis];
        n28 [label="flag"];
        n29 [label="multiple()" shape=box style=filled fillcolor=lightcyan];
        n30 [label="return multiple(flag)"];
        n31 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n32 {
        label="repeated_call\n(function)";
        style=rounded;
        n32 [style=invis];
        n33 [label="flag"];
        n34 [label="helper()" shape=box style=filled fillcolor=lightcyan];
        n35 [label="helper()" shape=box style=filled fillcolor=lightcyan];
        n36 [label="return helper(flag)"];
        n37 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n38 {
        label="alias_calls\n(function)";
        style=rounded;
        n38 [style=invis];
        n39 [label="flag"];
        n40 [label="external_alias()" shape=box style=filled fillcolor=lightcyan];
        n41 [label="second_external_alias()" shape=box style=filled fillcolor=lightcyan];
        n42 [label="return second_external_alias(flag)"];
        n43 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n44 {
        label="generator_outputs\n(function)";
        style=rounded;
        n44 [style=invis];
        n45 [label="flag"];
        n46 [label="generated()" shape=box style=filled fillcolor=lightcyan];
        n47 [label="return generated(flag)"];
        n48 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n49 {
        label="main\n(function)";
        style=rounded;
        n49 [style=invis];
        n50 [label="flag"];
        n51 [label="one_output()" shape=box style=filled fillcolor=lightcyan];
        n52 [label="multiple_outputs()" shape=box style=filled fillcolor=lightcyan];
        n53 [label="repeated_call()" shape=box style=filled fillcolor=lightcyan];
        n54 [label="alias_calls()" shape=box style=filled fillcolor=lightcyan];
        n55 [label="generator_outputs()" shape=box style=filled fillcolor=lightcyan];
        n56 [label="(one_output(flag), multiple_outputs(flag), repeated_call(flag), alias_calls(flag), generator_outputs(flag))" shape=box];
        n57 [label="return (one_output(flag), multiple_outputs(flag), repeated_call(flag), alias_calls(flag), generator_outputs(flag))"];
        n58 [label="flag" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n59 {
      label="external_call_target_population.worker\n(module)";
      style=rounded;
      n59 [style=invis];
      n60 [label="helper" shape=box style="rounded,filled" fillcolor=lightyellow];
      n61 [label="multiple" shape=box style="rounded,filled" fillcolor=lightyellow];
      n62 [label="generated" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n63 {
