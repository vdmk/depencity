digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="coverage_nested_callable.worker.wrapped"];

    subgraph cluster_n2 {
      label="coverage_nested_callable.entry\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="wrapped"];
      n4 [label="alias"];
      n5 [label="wrapped" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n8 {
        label="main\n(function)";
        style=rounded;
        n8 [style=invis];
        n9 [label="alias()" shape=box style=filled fillcolor=lightcyan];
        n10 [label="return alias()"];
      }

    }


    subgraph cluster_n11 {
      label="coverage_nested_callable.worker\n(module)";
      style=rounded;
      n11 [style=invis];
      n13 [label="wrapped" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="decorate" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n15 {
        label="decorate\n(function)";
        style=rounded;
        n15 [style=invis];
        n16 [label="function"];
        n17 [label="return wrapper"];
        n18 [label="function" shape=box style="rounded,filled" fillcolor=lightyellow];
        n19 [label="wrapper" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n20 {
          label="wrapper\n(function)";
          style=rounded;
          n20 [style=invis];
          n21 [label="function()" shape=box style=filled fillcolor=lightcyan];
          n22 [label="return function()"];
        }

      }


      subgraph cluster_n23 {
        label="wrapped\n(function)";
        style=rounded;
        n23 [style=invis];
        n24 [label="return 1"];
      }

    }

  }

  n1 -> n3 [color=steelblue];
  n13 -> n23 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n15 -> n14 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n15];
  n15 -> n23 [color=steelblue, ltail=cluster_n15];
  n16 -> n21 [color=steelblue];
  n18 -> n16 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n20 -> n17 [color=steelblue, ltail=cluster_n20];
  n20 -> n19 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n20];
  n21 -> n22 [color=steelblue];
  n23 -> n1 [color=steelblue, ltail=cluster_n23];
  n23 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n23];
  n24 -> n9 [color=steelblue];
  n3 -> n4 [color=steelblue];
  n4 -> n9 [color=steelblue];
  n5 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n6 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n8 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n8];
  n9 -> n10 [color=steelblue];
}