digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="super_constructor_boundary.base.Base"];
    n2 [label="super_constructor_boundary.base.Base.Factory"];
    n3 [label="super_constructor_boundary.base.Item.run"];

    subgraph cluster_n4 {
      label="super_constructor_boundary.base\n(module)";
      style=rounded;
      n4 [style=invis];
      n5 [label="Item" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="Base" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n7 {
        label="Item\n(class)";
        style=rounded;
        n7 [style=invis];
        n8 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];
        n9 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n10 {
          label="__init__\n(function)";
          style=rounded;
          n10 [style=invis];
          n11 [label="self"];
          n12 [label="initialize()" shape=box style=filled fillcolor=lightcyan];
          n13 [label="return None (implicit)"];
          n14 [label="initialize"];
          n15 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }


        subgraph cluster_n16 {
          label="run\n(function)";
          style=rounded;
          n16 [style=invis];
          n17 [label="self"];
          n18 [label="return item_source"];
          n19 [label="item_source"];
          n20 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n21 {
