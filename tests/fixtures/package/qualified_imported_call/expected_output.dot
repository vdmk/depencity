digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="qualified_imported_call.worker.Outer"];
    n2 [label="qualified_imported_call.worker.Outer.Inner"];

    subgraph cluster_n3 {
      label="qualified_imported_call.entry\n(module)";
      style=rounded;
      n3 [style=invis];
      n4 [label="Outer"];
      n5 [label="Outer" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n7 {
        label="main\n(function)";
        style=rounded;
        n7 [style=invis];
        n8 [label="Outer.Inner"];
        n9 [label="Outer.Inner()" shape=box style=filled fillcolor=lightcyan];
        n10 [label="return Outer.Inner()"];
      }

    }


    subgraph cluster_n11 {
      label="qualified_imported_call.worker\n(module)";
      style=rounded;
      n11 [style=invis];
      n12 [label="Outer" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n13 {
        label="Outer\n(class)";
        style=rounded;
        n13 [style=invis];
        n14 [label="Inner" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n15 {
          label="Inner\n(class)";
          style=rounded;
          n15 [style=invis];
        }

      }

    }

  }

  n1 -> n4 [color=steelblue];
  n13 -> n1 [color=steelblue, ltail=cluster_n13];
  n13 -> n12 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n13];
  n15 -> n14 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n15];
  n15 -> n2 [color=steelblue, ltail=cluster_n15];
  n2 -> n9 [color=steelblue];
  n4 -> n8 [color=steelblue];
  n5 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n7 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n7];
  n8 -> n9 [color=steelblue];
  n9 -> n10 [color=steelblue];
}