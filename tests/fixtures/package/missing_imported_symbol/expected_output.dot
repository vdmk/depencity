digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="missing_imported_symbol.worker"];
    n2 [label="missing_imported_symbol.worker.missing"];

    subgraph cluster_n3 {
      label="missing_imported_symbol.entry\n(module)";
      style=rounded;
      n3 [style=invis];
      n4 [label="worker"];
      n5 [label="worker" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n7 {
        label="main\n(function)";
        style=rounded;
        n7 [style=invis];
        n8 [label="value"];
        n9 [label="worker.missing"];
        n10 [label="worker.missing()" shape=box style=filled fillcolor=lightcyan];
        n11 [label="return worker.missing(value)"];
        n12 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n13 {
      label="missing_imported_symbol.worker\n(module)";
      style=rounded;
      n13 [style=invis];
      n14 [label="present" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n15 {
        label="present\n(function)";
        style=rounded;
        n15 [style=invis];
        n16 [label="value"];
        n17 [label="return value"];
        n18 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n1 -> n4 [color=steelblue];
  n10 -> n11 [color=steelblue];
  n12 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n13 -> n1 [color=steelblue, ltail=cluster_n13];
  n15 -> n14 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n15];
  n16 -> n17 [color=steelblue];
  n18 -> n16 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n2 -> n10 [color=steelblue];
  n4 -> n9 [color=steelblue];
  n5 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n7 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n7];
  n8 -> n10 [color=steelblue];
  n9 -> n10 [color=steelblue];
}