digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="nested_package_module_read.facade"];
    n2 [label="nested_package_module_read.facade.worker"];
    n3 [label="nested_package_module_read.facade.worker.run"];

    subgraph cluster_n4 {
      label="nested_package_module_read.entry\n(module)";
      style=rounded;
      n4 [style=invis];
      n5 [label="facade"];
      n6 [label="facade" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n8 {
        label="main\n(function)";
        style=rounded;
        n8 [style=invis];
        n9 [label="facade.worker"];
        n10 [label="facade.worker.run"];
        n11 [label="facade.worker.run()" shape=box style=filled fillcolor=lightcyan];
        n12 [label="return facade.worker.run()"];
      }

    }


    subgraph cluster_n13 {
      label="nested_package_module_read.facade\n(module)";
      style=rounded;
      n13 [style=invis];
      n14 [label="worker"];
      n15 [label="worker" shape=box style="rounded,filled" fillcolor=lightyellow];
    }


    subgraph cluster_n16 {
      label="nested_package_module_read.facade.worker\n(module)";
      style=rounded;
      n16 [style=invis];
      n17 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n18 {
        label="run\n(function)";
        style=rounded;
        n18 [style=invis];
        n19 [label="return 1"];
      }

    }

  }

  n1 -> n5 [color=steelblue];
  n10 -> n11 [color=steelblue];
  n11 -> n12 [color=steelblue];
  n13 -> n1 [color=steelblue, ltail=cluster_n13];
  n14 -> n2 [color=steelblue];
  n15 -> n14 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n16 -> n2 [color=steelblue, ltail=cluster_n16];
  n18 -> n17 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n18];
  n18 -> n3 [color=steelblue, ltail=cluster_n18];
  n19 -> n11 [color=steelblue];
  n2 -> n14 [color=steelblue];
  n2 -> n9 [color=steelblue];
  n3 -> n11 [color=steelblue];
  n5 -> n9 [color=steelblue];
  n6 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n8 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n8];
  n9 -> n10 [color=steelblue];
}