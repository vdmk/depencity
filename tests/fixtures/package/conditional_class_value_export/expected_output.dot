digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="conditional_class_value_export.worker.Item"];

    subgraph cluster_n2 {
      label="conditional_class_value_export.entry\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="Item"];
      n4 [label="Item()" shape=box style=filled fillcolor=lightcyan];
      n5 [label="result"];
      n6 [label="Item" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="result" shape=box style="rounded,filled" fillcolor=lightyellow];
    }


    subgraph cluster_n8 {
      label="conditional_class_value_export.worker\n(module)";
      style=rounded;
      n8 [style=invis];
      n9 [label="if enabled" shape=diamond];
      n10 [label="Item"];
      n11 [label="enabled"];
      n12 [label="replacement"];
      n13 [label="Item" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n14 {
        label="Item\n(class)";
        style=rounded;
        n14 [style=invis];
        n15 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n16 {
          label="run\n(function)";
          style=rounded;
          n16 [style=invis];
          n17 [label="self"];
          n18 [label="return None"];
          n19 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }

  }

  n1 -> n3 [color=steelblue];
  n10 -> n1 [color=steelblue];
  n11 -> n9 [color=steelblue];
  n12 -> n10 [color=steelblue];
  n13 -> n10 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n14 -> n1 [color=steelblue, ltail=cluster_n14];
  n14 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n14];
  n16 -> n15 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n16];
  n19 -> n17 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n3 -> n4 [color=steelblue];
  n4 -> n5 [color=steelblue];
  n6 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n7 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n9 -> n10 [color=steelblue];
}