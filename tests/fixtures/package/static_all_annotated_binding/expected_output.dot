digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="static_all_annotated_binding.worker.value"];

    subgraph cluster_n2 {
      label="static_all_annotated_binding.entry\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="value"];
      n4 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="main\n(function)";
        style=rounded;
        n6 [style=invis];
        n7 [label="return value"];
      }

    }


    subgraph cluster_n8 {
      label="static_all_annotated_binding.worker\n(module)";
      style=rounded;
      n8 [style=invis];
      n9 [label="['value']" shape=box];
      n10 [label="__all__"];
      n11 [label="value"];
      n12 [label="__all__" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

  n1 -> n3 [color=steelblue];
  n11 -> n1 [color=steelblue];
  n12 -> n10 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n13 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n3 -> n7 [color=steelblue];
  n4 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n6 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n6];
  n9 -> n10 [color=steelblue];
}