digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="relative_initializer_bases.helper.f"];

    subgraph cluster_n2 {
      label="relative_initializer_bases\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="f"];
      n4 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="root_initializer" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="root_initializer\n(function)";
        style=rounded;
        n6 [style=invis];
        n7 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n8 [label="return f()"];
      }

    }


    subgraph cluster_n9 {
      label="relative_initializer_bases.entry\n(module)";
      style=rounded;
