    subgraph cluster_n41 {
      label="relative_initializer_bases.sub.entry\n(module)";
      style=rounded;
      n41 [style=invis];
      n42 [label="f"];
      n43 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      n44 [label="nested_module" shape=box style="rounded,filled" fillcolor=lightyellow];

