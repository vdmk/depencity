        style=rounded;
        n24 [style=invis];
        n25 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n26 [label="return f()"];
      }

    }


    subgraph cluster_n27 {
      label="relative_initializer_bases.sub.deep\n(module)";
      style=rounded;
      n27 [style=invis];
      n28 [label="f"];
      n29 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      n30 [label="deep_initializer" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n31 {
        label="deep_initializer\n(function)";
        style=rounded;
        n31 [style=invis];
        n32 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n33 [label="return f()"];
      }

    }


    subgraph cluster_n34 {
      label="relative_initializer_bases.sub.deep.entry\n(module)";
      style=rounded;
      n34 [style=invis];
      n35 [label="f"];
      n36 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      n37 [label="deep_module" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n38 {
        label="deep_module\n(function)";
        style=rounded;
        n38 [style=invis];
        n39 [label="f()" shape=box style=filled fillcolor=lightcyan];
        n40 [label="return f()"];
      }

