digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="generator_calls.worker.values"];

    subgraph cluster_n2 {
      label="generator_calls.entry\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="values"];
      n4 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="main\n(function)";
        style=rounded;
        n6 [style=invis];
        n7 [label="source"];
        n8 [label="values()" shape=box style=filled fillcolor=lightcyan];
        n9 [label="return values(source)"];
        n10 [label="source" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n11 {
      label="generator_calls.worker\n(module)";
      style=rounded;
      n11 [style=invis];
      n12 [label="values" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n13 {
        label="values\n(function)";
        style=rounded;
        n13 [style=invis];
        n14 [label="source"];
        n15 [label="for value in source" shape=diamond];
        n16 [label="value in source" shape=box];
        n17 [label="value"];
        n18 [label="yield value"];
        n19 [label="yield (received)"];
        n20 [label="return None (implicit)"];
        n21 [label="source" shape=box style="rounded,filled" fillcolor=lightyellow];
        n22 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n1 -> n3 [color=steelblue];
  n10 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n13 -> n1 [color=steelblue, ltail=cluster_n13];
  n13 -> n12 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n13];
  n14 -> n15 [color=steelblue];
  n14 -> n16 [color=steelblue];
  n15 -> n16 [color=steelblue];
  n15 -> n17 [color=steelblue];
  n15 -> n18 [color=steelblue];
  n15 -> n19 [color=steelblue];
  n16 -> n17 [color=steelblue];
  n17 -> n18 [color=steelblue];
  n18 -> n8 [color=steelblue];
  n20 -> n8 [color=steelblue];
  n21 -> n14 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n22 -> n17 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n3 -> n8 [color=steelblue];
  n4 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n6 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n6];
  n7 -> n8 [color=steelblue];
  n8 -> n9 [color=steelblue];
}