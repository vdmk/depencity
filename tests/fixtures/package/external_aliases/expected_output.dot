        n39 [label="items"];
        n40 [label="saved"];
        n41 [label="size()" shape=box style=filled fillcolor=lightcyan];
        n42 [label="saved()" shape=box style=filled fillcolor=lightcyan];
        n43 [label="(size(items), saved(items))" shape=box];
        n44 [label="return (size(items), saved(items))"];
        n45 [label="items" shape=box style="rounded,filled" fillcolor=lightyellow];
        n46 [label="saved" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n47 {
