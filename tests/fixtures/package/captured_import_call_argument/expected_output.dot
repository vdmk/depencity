digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="captured_import_call_argument.worker.helper"];
    n2 [label="captured_import_call_argument.worker.other"];

    subgraph cluster_n3 {
      label="captured_import_call_argument.entry\n(module)";
      style=rounded;
      n3 [style=invis];
      n4 [label="helper"];
      n5 [label="other"];
      n6 [label="helper" shape=box style="rounded,filled" fillcolor=lightyellow];
      n7 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];
      n8 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n9 {
        label="main\n(function)";
        style=rounded;
        n9 [style=invis];
        n10 [label="other"];
        n11 [label="helper()" shape=box style=filled fillcolor=lightcyan];
        n12 [label="return helper(other, extra=(other := 3))"];
      }

    }


    subgraph cluster_n13 {
      label="captured_import_call_argument.worker\n(module)";
      style=rounded;
      n13 [style=invis];
      n14 [label="helper" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="other" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n16 {
        label="helper\n(function)";
        style=rounded;
        n16 [style=invis];
        n17 [label="value"];
        n18 [label="extra"];
        n19 [label="return value"];
        n20 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n21 [label="extra" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n22 {
        label="other\n(function)";
        style=rounded;
        n22 [style=invis];
        n23 [label="return 2"];
      }

    }

  }

  n1 -> n4 [color=steelblue];
  n10 -> n11 [color=steelblue];
  n11 -> n12 [color=steelblue];
  n16 -> n1 [color=steelblue, ltail=cluster_n16];
  n16 -> n14 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n16];
  n17 -> n19 [color=steelblue];
  n19 -> n11 [color=steelblue];
  n2 -> n5 [color=steelblue];
  n20 -> n17 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n21 -> n18 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n22 -> n15 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n22];
  n22 -> n2 [color=steelblue, ltail=cluster_n22];
  n4 -> n11 [color=steelblue];
  n5 -> n11 [color=steelblue];
  n6 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n7 -> n10 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n7 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n9 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n9];
}