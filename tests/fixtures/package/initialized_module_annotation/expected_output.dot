digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="initialized_module_annotation.worker"];
    n2 [label="initialized_module_annotation.worker.Worker.run"];
    n3 [label="initialized_module_annotation.nested.models.Worker.run"];

    subgraph cluster_n4 {
      label="initialized_module_annotation\n(module)";
      style=rounded;
      n4 [style=invis];
      n5 [label="worker"];
      n6 [label="worker" shape=box style="rounded,filled" fillcolor=lightyellow];
    }


    subgraph cluster_n7 {
      label="initialized_module_annotation.entry\n(module)";
      style=rounded;
      n7 [style=invis];
      n8 [label="invoke" shape=box style="rounded,filled" fillcolor=lightyellow];
      n9 [label="make" shape=box style="rounded,filled" fillcolor=lightyellow];
      n10 [label="factory_results" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="qualified_generic" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n12 {
        label="invoke\n(function)";
        style=rounded;
        n12 [style=invis];
        n13 [label="value"];
        n14 [label="value.run"];
        n15 [label="value.run()" shape=box style=filled fillcolor=lightcyan];
        n16 [label="return value.run()"];
        n17 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n18 {
        label="make\n(function)";
        style=rounded;
        n18 [style=invis];
        n19 [label="return external_result"];
        n20 [label="external_result"];
      }


      subgraph cluster_n21 {
        label="factory_results\n(function)";
        style=rounded;
        n21 [style=invis];
        n22 [label="make()" shape=box style=filled fillcolor=lightcyan];
        n23 [label="saved"];
        n24 [label="saved.run"];
        n25 [label="saved.run()" shape=box style=filled fillcolor=lightcyan];
        n26 [label="make()" shape=box style=filled fillcolor=lightcyan];
        n27 [label="make().run"];
        n28 [label="make().run()" shape=box style=filled fillcolor=lightcyan];
        n29 [label="(saved.run(), make().run())" shape=box];
        n30 [label="return (saved.run(), make().run())"];
        n31 [label="saved" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n32 {
        label="qualified_generic\n(function)";
        style=rounded;
        n32 [style=invis];
        n33 [label="Worker"];
        n34 [label="value"];
        n35 [label="value.run"];
        n36 [label="value.run()" shape=box style=filled fillcolor=lightcyan];
        n37 [label="return value.run()"];
        n38 [label="Worker" shape=box style="rounded,filled" fillcolor=lightyellow];
        n39 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n40 {
      label="initialized_module_annotation.nested.models\n(module)";
      style=rounded;
      n40 [style=invis];
      n41 [label="Worker" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n42 {
        label="Worker\n(class)";
        style=rounded;
        n42 [style=invis];
        n43 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n44 {
          label="run\n(function)";
          style=rounded;
          n44 [style=invis];
          n45 [label="self"];
          n46 [label="return nested_payload"];
          n47 [label="nested_payload"];
          n48 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }


    subgraph cluster_n49 {
      label="initialized_module_annotation.worker\n(module)";
      style=rounded;
      n49 [style=invis];
      n50 [label="Worker" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n51 {
        label="Worker\n(class)";
        style=rounded;
        n51 [style=invis];
        n52 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n53 {
          label="run\n(function)";
          style=rounded;
          n53 [style=invis];
          n54 [label="self"];
          n55 [label="return 1"];
          n56 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }

  }

  n1 -> n5 [color=steelblue];
  n12 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n12];
  n13 -> n14 [color=steelblue];
  n14 -> n15 [color=steelblue];
  n15 -> n16 [color=steelblue];
  n17 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n18 -> n9 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n18];
  n19 -> n22 [color=steelblue];
  n19 -> n26 [color=steelblue];
  n2 -> n15 [color=steelblue];
  n20 -> n19 [color=steelblue];
  n21 -> n10 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n21];
  n22 -> n23 [color=steelblue];
  n23 -> n24 [color=steelblue];
  n24 -> n25 [color=steelblue];
  n25 -> n29 [color=steelblue];
  n26 -> n27 [color=steelblue];
  n27 -> n28 [color=steelblue];
  n28 -> n29 [color=steelblue];
  n29 -> n30 [color=steelblue];
  n3 -> n25 [color=steelblue];
  n3 -> n36 [color=steelblue];
  n31 -> n23 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n32 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n32];
  n34 -> n35 [color=steelblue];
  n35 -> n36 [color=steelblue];
  n36 -> n37 [color=steelblue];
  n38 -> n33 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n39 -> n34 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n42 -> n41 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n42];
  n44 -> n3 [color=steelblue, ltail=cluster_n44];
  n44 -> n43 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n44];
  n46 -> n25 [color=steelblue];
  n46 -> n28 [color=steelblue];
  n46 -> n36 [color=steelblue];
  n47 -> n46 [color=steelblue];
  n48 -> n45 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n49 -> n1 [color=steelblue, ltail=cluster_n49];
  n51 -> n50 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n51];
  n53 -> n2 [color=steelblue, ltail=cluster_n53];
  n53 -> n52 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n53];
  n55 -> n15 [color=steelblue];
  n56 -> n54 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n6 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
}