digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="coverage_routes.models.Base"];
    n2 [label="coverage_routes.models.exported"];
    n3 [label="coverage_routes.worker"];
    n4 [label="coverage_routes.worker.run"];

    subgraph cluster_n5 {
      label="coverage_routes.entry\n(module)";
      style=rounded;
      n5 [style=invis];
      n6 [label="ImportedBase"];
      n7 [label="exported"];
      n8 [label="worker"];
      n10 [label="ImportedBase" shape=box style="rounded,filled" fillcolor=lightyellow];
      n11 [label="exported" shape=box style="rounded,filled" fillcolor=lightyellow];
      n12 [label="worker" shape=box style="rounded,filled" fillcolor=lightyellow];
      n13 [label="Child" shape=box style="rounded,filled" fillcolor=lightyellow];
      n14 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n15 [label="nested_class_name" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n16 {
        label="Child\n(class)";
        style=rounded;
        n16 [style=invis];
        n17 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n18 {
          label="__init__\n(function)";
          style=rounded;
          n18 [style=invis];
          n19 [label="self"];
          n20 [label="value"];
          n21 [label="self.value"];
          n22 [label="return None (implicit)"];
          n23 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n24 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n25 {
        label="main\n(function)";
        style=rounded;
        n25 [style=invis];
        n26 [label="value"];
        n27 [label="worker.run"];
        n28 [label="worker.run()" shape=box style=filled fillcolor=lightcyan];
        n29 [label="__await_3__"];
        n30 [label="Child()" shape=box style=filled fillcolor=lightcyan];
        n31 [label="child"];
        n32 [label="ImportedBase()" shape=box style=filled fillcolor=lightcyan];
        n33 [label="direct"];
        n34 [label="(child, direct)" shape=box];
        n35 [label="exported()" shape=box style=filled fillcolor=lightcyan];
        n36 [label="return exported((child, direct))"];
        n37 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        n38 [label="child" shape=box style="rounded,filled" fillcolor=lightyellow];
        n39 [label="direct" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n40 {
        label="nested_class_name\n(function)";
        style=rounded;
        n40 [style=invis];
        n41 [label="worker.run"];
        n42 [label="worker.run()" shape=box style=filled fillcolor=lightcyan];
        n43 [label="return worker.run()"];
        n44 [label="Local" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n45 {
          label="Local\n(class)";
          style=rounded;
          n45 [style=invis];
          n46 [label="object()" shape=box style=filled fillcolor=lightcyan];
          n47 [label="worker"];
          n48 [label="worker" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }

    }


    subgraph cluster_n49 {
      label="coverage_routes.models\n(module)";
      style=rounded;
      n49 [style=invis];
      n50 [label="shared"];
      n51 [label="shared" shape=box style="rounded,filled" fillcolor=lightyellow];
      n52 [label="Base" shape=box style="rounded,filled" fillcolor=lightyellow];
      n53 [label="exported" shape=box style="rounded,filled" fillcolor=lightyellow];
      n54 [label="ClassWrites" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n55 {
        label="Base\n(class)";
        style=rounded;
        n55 [style=invis];
        n56 [label="__init__" shape=box style="rounded,filled" fillcolor=lightyellow];

        subgraph cluster_n57 {
          label="__init__\n(function)";
          style=rounded;
          n57 [style=invis];
          n58 [label="self"];
          n59 [label="value"];
          n60 [label="self.value"];
          n61 [label="return None (implicit)"];
          n62 [label="self" shape=box style="rounded,filled" fillcolor=lightyellow];
          n63 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
        }

      }


      subgraph cluster_n64 {
        label="exported\n(function)";
        style=rounded;
        n64 [style=invis];
        n65 [label="value"];
        n66 [label="return value"];
        n67 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }


      subgraph cluster_n68 {
        label="ClassWrites\n(class)";
        style=rounded;
        n68 [style=invis];
        n69 [label="shared v1"];
        n70 [label="exception" shape=diamond];
        n71 [label="Exception" shape=diamond];
        n72 [label="error"];
        n73 [label="shared v2"];
        n74 [label="exception" shape=diamond];
        n75 [label="shared v3"];
        n76 [label="{'value': 3}" shape=box];
        n77 [label="__cond_8__" shape=diamond];
        n78 [label="captured"];
        n79 [label="shared v4"];
        n80 [label="error" shape=box style="rounded,filled" fillcolor=lightyellow];
        n81 [label="captured" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n82 {
      label="coverage_routes.worker\n(module)";
      style=rounded;
      n82 [style=invis];
      n83 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n84 {
        label="run\n(function)";
        style=rounded;
        n84 [style=invis];
        n85 [label="value"];
        n86 [label="return value"];
        n87 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n88 {
      label="builtins\n(builtins)";
      style=rounded;
      n88 [style=invis];
      n89 [label="object"];
      n90 [label="Exception"];
      n91 [label="object" shape=box style="rounded,filled" fillcolor=lightyellow];
      n92 [label="Exception" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

