digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="src_layout.worker.transform"];

    subgraph cluster_n2 {
      label="src_layout\n(module)";
      style=rounded;
      n2 [style=invis];
    }


    subgraph cluster_n3 {
      label="src_layout.entry\n(module)";
      style=rounded;
      n3 [style=invis];
      n4 [label="transform"];
      n5 [label="transform" shape=box style="rounded,filled" fillcolor=lightyellow];
      n6 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n7 {
        label="main\n(function)";
        style=rounded;
        n7 [style=invis];
        n8 [label="value"];
        n9 [label="transform()" shape=box style=filled fillcolor=lightcyan];
        n10 [label="return transform(value)"];
        n11 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n12 {
      label="src_layout.worker\n(module)";
      style=rounded;
      n12 [style=invis];
      n13 [label="transform" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n14 {
        label="transform\n(function)";
        style=rounded;
        n14 [style=invis];
        n15 [label="value"];
        n16 [label="value + 1" shape=box];
        n17 [label="return value + 1"];
        n18 [label="value" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }

  }

  n1 -> n4 [color=steelblue];
  n11 -> n8 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n14 -> n1 [color=steelblue, ltail=cluster_n14];
  n14 -> n13 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n14];
  n15 -> n16 [color=steelblue];
  n16 -> n17 [color=steelblue];
  n17 -> n9 [color=steelblue];
  n18 -> n15 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n4 -> n9 [color=steelblue];
  n5 -> n4 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n7 -> n6 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n7];
  n8 -> n9 [color=steelblue];
  n9 -> n10 [color=steelblue];
}