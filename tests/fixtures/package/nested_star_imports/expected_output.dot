digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="nested_star_imports.facade.run"];
    n2 [label="nested_star_imports.fallback.run"];
    n3 [label="nested_star_imports.explicit_facade._work"];
    n4 [label="nested_star_imports.worker._work"];
    n5 [label="nested_star_imports.worker.run"];
    n6 [label="nested_star_imports.long_facade.run"];

    subgraph cluster_n7 {
      label="nested_star_imports.entry\n(module)";
      style=rounded;
      n7 [style=invis];
      n8 [label="run v1"];
      n9 [label="exception" shape=diamond];
      n10 [label="ImportError" shape=diamond];
      n11 [label="run v2"];
      n12 [label="if external_enabled" shape=diamond];
      n13 [label="from external_api import *"];
      n14 [label="external_enabled"];
      n15 [label="external_api.*"];
      n16 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];
      n17 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];
      n18 [label="private_from_facade" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n19 {
        label="main\n(function)";
        style=rounded;
        n19 [style=invis];
        n20 [label="run()" shape=box style=filled fillcolor=lightcyan];
        n21 [label="external_function()" shape=box style=filled fillcolor=lightcyan];
        n22 [label="(run(), external_function())" shape=box];
        n23 [label="return (run(), external_function())"];
        n24 [label="external_function"];
      }


      subgraph cluster_n25 {
        label="private_from_facade\n(function)";
        style=rounded;
        n25 [style=invis];
        n26 [label="_work()" shape=box style=filled fillcolor=lightcyan];
        n27 [label="return _work()"];
        n28 [label="_work"];
      }

    }


    subgraph cluster_n29 {
      label="nested_star_imports.explicit_entry\n(module)";
      style=rounded;
      n29 [style=invis];
      n30 [label="_work"];
      n31 [label="_work" shape=box style="rounded,filled" fillcolor=lightyellow];
      n32 [label="private" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n33 {
        label="private\n(function)";
        style=rounded;
        n33 [style=invis];
        n34 [label="_work()" shape=box style=filled fillcolor=lightcyan];
        n35 [label="return _work()"];
      }

    }


    subgraph cluster_n36 {
      label="nested_star_imports.explicit_facade\n(module)";
      style=rounded;
      n36 [style=invis];
      n37 [label="_work"];
      n38 [label="['_work']" shape=box];
      n39 [label="__all__"];
      n40 [label="_work" shape=box style="rounded,filled" fillcolor=lightyellow];
      n41 [label="__all__" shape=box style="rounded,filled" fillcolor=lightyellow];
    }


    subgraph cluster_n42 {
      label="nested_star_imports.facade\n(module)";
      style=rounded;
      n42 [style=invis];
      n43 [label="if enabled" shape=diamond];
      n44 [label="run"];
      n45 [label="enabled"];
      n46 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];
    }


    subgraph cluster_n47 {
      label="nested_star_imports.fallback\n(module)";
      style=rounded;
      n47 [style=invis];
      n48 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n49 {
        label="run\n(function)";
        style=rounded;
        n49 [style=invis];
        n50 [label="return 'fallback'"];
      }

    }


    subgraph cluster_n51 {
      label="nested_star_imports.long_entry\n(module)";
      style=rounded;
      n51 [style=invis];
      n52 [label="run"];
      n53 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];
      n54 [label="public" shape=box style="rounded,filled" fillcolor=lightyellow];
      n55 [label="private" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n56 {
        label="public\n(function)";
        style=rounded;
        n56 [style=invis];
        n57 [label="run()" shape=box style=filled fillcolor=lightcyan];
        n58 [label="return run()"];
      }


      subgraph cluster_n59 {
        label="private\n(function)";
        style=rounded;
        n59 [style=invis];
        n60 [label="_work()" shape=box style=filled fillcolor=lightcyan];
        n61 [label="return _work()"];
        n62 [label="_work"];
      }

    }


    subgraph cluster_n63 {
      label="nested_star_imports.long_facade\n(module)";
      style=rounded;
      n63 [style=invis];
      n64 [label="run"];
      n65 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];
    }


    subgraph cluster_n66 {
      label="nested_star_imports.worker\n(module)";
      style=rounded;
      n66 [style=invis];
      n67 [label="['_work', 'run']" shape=box];
      n68 [label="__all__"];
      n69 [label="__all__" shape=box style="rounded,filled" fillcolor=lightyellow];
      n70 [label="_work" shape=box style="rounded,filled" fillcolor=lightyellow];
      n71 [label="run" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n72 {
        label="_work\n(function)";
        style=rounded;
        n72 [style=invis];
        n73 [label="return 'worker private'"];
      }


      subgraph cluster_n74 {
        label="run\n(function)";
        style=rounded;
        n74 [style=invis];
        n75 [label="return 'worker'"];
      }

    }


    subgraph cluster_n76 {
      label="builtins\n(builtins)";
      style=rounded;
      n76 [style=invis];
      n77 [label="ImportError"];
      n78 [label="ImportError" shape=box style="rounded,filled" fillcolor=lightyellow];
    }

  }

