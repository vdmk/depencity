digraph {
  rankdir=LR;
  compound=true;
  node [fontname="monospace"];

  subgraph cluster_n0 {
    label="__root__\n(root)";
    style=rounded;
    n0 [style=invis];
    n1 [label="imported_value.worker.f"];

    subgraph cluster_n2 {
      label="imported_value.consumer\n(module)";
      style=rounded;
      n2 [style=invis];
      n3 [label="f"];
      n4 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];
      n5 [label="main" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n6 {
        label="main\n(function)";
        style=rounded;
        n6 [style=invis];
        n7 [label="alias"];
        n8 [label="return alias"];
        n9 [label="alias" shape=box style="rounded,filled" fillcolor=lightyellow];
      }

    }


    subgraph cluster_n10 {
      label="imported_value.worker\n(module)";
      style=rounded;
      n10 [style=invis];
      n11 [label="f" shape=box style="rounded,filled" fillcolor=lightyellow];

      subgraph cluster_n12 {
        label="f\n(function)";
        style=rounded;
        n12 [style=invis];
        n13 [label="return 1"];
      }

    }

  }

  n1 -> n3 [color=steelblue];
  n12 -> n1 [color=steelblue, ltail=cluster_n12];
  n12 -> n11 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n12];
  n3 -> n7 [color=steelblue];
  n4 -> n3 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
  n6 -> n5 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false, ltail=cluster_n6];
  n7 -> n8 [color=steelblue];
  n9 -> n7 [color=gray35 penwidth=2 style=dotted arrowhead=none constraint=false];
}